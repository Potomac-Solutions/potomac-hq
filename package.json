{
  "name": "potomac-hq",
  "version": "0.21.0",
  "private": true,
  "description": "Internal operations platform for Potomac Solutions",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "lint:boundaries:selftest": "node tools/boundaries/selftest.mjs",
    "lint:components": "node tools/boundaries/zb-check.mjs && node tools/boundaries/zb-check.mjs --selftest",
    "lint:zubra-ui": "node tools/zubra-ui/verify.mjs",
    "test:domain": "node --test \"src/*/domain/**/*.test.ts\"",
    "test:unit": "node --test \"src/*/domain/**/*.test.ts\" \"src/*/application/**/*.test.ts\"",
    "test:integration": "node --test \"src/*/infrastructure/**/*.test.ts\" \"src/*/api/**/*.test.ts\" \"test/integration/**/*.test.ts\" \"test/zubra/**/*.test.ts\"",
    "test:zubra": "node --test \"test/zubra/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint:boundaries && npm run lint:boundaries:selftest && npm run lint:components && npm run lint:zubra-ui && npm run test:unit && npm run test:integration",
    "migrate": "node bin/migrate.ts",
    "start": "node bin/serve.ts",
    "reset-link": "node bin/reset-link.ts",
    "site:token": "node bin/site-token.ts",
    "backup": "node bin/backup.ts",
    "backup:keygen": "node bin/backup-keygen.ts",
    "push:keygen": "node bin/push-keygen.ts",
    "restore": "node bin/restore.ts",
    "restore:drill": "node bin/restore-drill.ts",
    "retention": "node bin/retention.ts",
    "export": "node bin/export.ts",
    "release:prepare": "node tools/release/prepare.mjs",
    "release:notes": "node tools/release/notes.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@journey-to-code/symbology": "0.2.0",
    "@potomac-solutions/kit": "github:Potomac-Solutions/potomac-kit#8e88e9e5de02ba903de9ab2cb7225f9a6fb29fdf",
    "@zubra/compiler": "6.0.5",
    "@zubra/router": "6.0.5",
    "@zubra/runtime": "6.0.5",
    "@zubra/server": "6.0.5",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.8.0",
    "playwright": "1.65.1",
    "typescript": "6.0.3"
  }
}
