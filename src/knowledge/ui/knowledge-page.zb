<!--
  The knowledge base: how things are done at Potomac, and the decisions that
  were made. Search it, narrow it, and write a new article.
-->
<script>
  'use route /knowledge'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/empty-state.zb'
  import '../../shared/ui/zubra/text-field.zb'
  export async function load({ context, url }) {
    const stop = context.guard()
    if (stop) return stop
    const q = (name) => url.searchParams.get(name) || ''
    const view = context.knowledge.list({ q: q('q'), category: q('category'), tag: q('tag'), kind: q('kind'), archived: q('archived') })
    if (!view.ok) return context.forbidden()
    return { title: 'Knowledge base', view: view.value, done: context.notice.done, problem: context.notice.problem }
  }
</script>
<style>
  .kb-list { list-style: none; margin: 0; padding: 0; }
  .kb-list li { padding: 0.75rem 0; border-top: 1px solid var(--border); }
  .kb-list li:first-child { border-top: 0; }
  .kb-list p { margin: 0.2rem 0 0; }
  .kb-meta { color: var(--muted-foreground); font-size: 0.85rem; }
</style>
<hq-knowledge view={{ items: [], categories: [], filter: {} }} done="" problem="">
  <div class="hq-page">
    <h1>Knowledge base</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>

    <section class="hq-panel" aria-labelledby="kb-find">
      <h2 id="kb-find">Find</h2>
      <form method="get" action="/knowledge" class="hq-form-row" role="search">
        <div class="hq-field">
          <label for="kb-q">Search for</label>
          <input id="kb-q" name="q" type="search" value={view.filter.q} autocomplete="off">
        </div>
        <div class="hq-field">
          <label for="kb-kind">Show</label>
          <select id="kb-kind" name="kind">
            <option value="">Articles and decisions</option>
            <option value="article" selected={view.filter.kind === "article"}>Articles</option>
            <option value="decision" selected={view.filter.kind === "decision"}>The decision log</option>
          </select>
        </div>
        <div class="hq-field">
          <label for="kb-category">In category</label>
          <select id="kb-category" name="category">
            <option value="">Any</option>
            <zb-each items={view.categories} as="category" key={category}><option value={category} selected={category === view.filter.category}>{category}</option></zb-each>
          </select>
        </div>
        <label class="hq-check"><input type="checkbox" name="archived" value="1" checked={view.filter.archived}> Archived ones</label>
        <button class="hq-button" type="submit">Search</button>
        <a zb-if={view.filtered} class="hq-button secondary" href="/knowledge">Clear</a>
      </form>
      <p zb-if={view.filter.tag} class="hq-muted" data-spaced>Tagged “{view.filter.tag}”.</p>
    </section>

    <section class="hq-panel" aria-labelledby="kb-results">
      <h2 id="kb-results">{view.items.length} {view.items.length === 1 ? "result" : "results"}</h2>
      <empty-state zb-if={view.items.length === 0} heading="Nothing found">{view.filtered ? "Try other words, or clear the search." : "Nothing has been written yet."}</empty-state>
      <ul zb-else class="kb-list">
        <zb-each items={view.items} as="item" key={item.slug}>
          <li>
            <a href="/knowledge/{item.slug}"><strong>{item.title}</strong></a> <span zb-if={item.isDecision} class="hq-tag">Decision</span> <span zb-if={item.archived} class="hq-tag">Archived</span>
            <p zb-if={item.excerpt}>{item.excerpt}</p>
            <p class="kb-meta">{item.category}<span zb-if={item.decidedOn}> · Decided {item.decidedOn}</span> · Updated {item.updated}<zb-each items={item.tags} as="tag" key={tag}> · <a href="/knowledge?tag={tag}">{tag}</a></zb-each></p>
          </li>
        </zb-each>
      </ul>
    </section>

    <section zb-if={view.canEdit} class="hq-panel" aria-labelledby="kb-new">
      <h2 id="kb-new">Write something down</h2>
      <details class="hq-more">
        <summary>New article or decision</summary>
        <form method="post" action="/knowledge" class="hq-form">
          <div class="hq-field">
            <label for="kb-new-kind">What is it?</label>
            <select id="kb-new-kind" name="kind">
              <option value="article">An article: how something is done</option>
              <option value="decision">A decision: what was decided, and why</option>
            </select>
          </div>
          <text-field label="Title" name="title" required={true} autocomplete="off"></text-field>
          <text-field label="Category" name="category" required={true} autocomplete="off" description="Like: Operations, Sales, Decisions"></text-field>
          <text-field label="Tags" name="tags" autocomplete="off" description="Separate them with commas"></text-field>
          <div class="hq-field">
            <label for="kb-new-day">Decided on, for a decision</label>
            <input id="kb-new-day" name="decidedOn" type="date" max={view.today}>
          </div>
          <div class="hq-field">
            <label for="kb-new-body">Text</label>
            <textarea id="kb-new-body" name="body" rows="14" required aria-describedby="kb-new-hint"></textarea>
            <p id="kb-new-hint" class="hq-muted hq-small">Plain text. A line starting with # is a heading, - starts a list item, and | col | col | rows make a table.</p>
          </div>
          <div><button class="hq-button" type="submit">Save</button></div>
        </form>
      </details>
    </section>
  </div>
</hq-knowledge>
