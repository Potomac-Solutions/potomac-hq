<!--
  The command palette and the keyboard shortcuts (decision 0014).

  Ctrl+K (⌘K) opens a box that goes anywhere in HQ: its pages, any client,
  contact, opportunity, project, task, proposal, invoice or article search
  finds, and moves for an opportunity it finds ("Move Feed store site to
  Quoted"), posted as the page's own form would be. ? lists every shortcut;
  G then a letter goes to a page; / goes to search.

  `groups` are the shell's navigation groups; `adding` is whether quick add
  is on this page.
-->
<script>
  import { onMount, onUnmount } from '@zubra/runtime'

  // G then a letter: the page, if it's in this person's navigation.
  const JUMPS = [
    { key: 't', href: '/today', label: 'Today' },
    { key: 'w', href: '/todos', label: 'My work' },
    { key: 'd', href: '/', label: 'Dashboard' },
    { key: 'p', href: '/pipeline', label: 'Pipeline' },
    { key: 'c', href: '/clients', label: 'Clients' },
    { key: 'j', href: '/projects', label: 'Projects' },
    { key: 'b', href: '/board', label: 'Board' },
    { key: 'm', href: '/money', label: 'Money' },
  ]
  const SHORTCUTS = [
    { keys: 'Ctrl K', what: 'Open the command palette (⌘K on a Mac)' },
    { keys: '/', what: 'Search' },
    { keys: 'N', what: 'Quick add a task or to-do' },
    { keys: 'Ctrl Z', what: 'Undo the last change (⌘Z on a Mac)' },
    { keys: '?', what: 'This list' },
    ...JUMPS.map((jump) => ({ keys: 'G then ' + jump.key.toUpperCase(), what: 'Go to ' + jump.label })),
    { keys: 'Space', what: 'On a board card: pick it up, then drop it' },
    { keys: '← →', what: 'While a card is picked up: choose a column' },
    { keys: 'Esc', what: 'Put a picked-up card back, or close this' },
  ]

  let q = ''
  let active = 0
  let found = { hits: [], moves: [] }
  let looking = false
  let asked = 0
  let waiting = 0
  let leader = 0
  let list = []
  const refresh = () => (list = options().map((option, index) => ({ ...option, index })))

  const words = (text) => text.toLowerCase().split(/\s+/).filter(Boolean)
  const matches = (label, typed) => words(typed).every((word) => label.toLowerCase().includes(word))

  // Everything the box offers for what's typed, in one list.
  function options() {
    const pages = groups.flatMap((group) => group.links).filter((link) => !q || matches(link.label + ' ' + link.href, q)).map((link) => ({ id: 'go-' + link.href, kind: 'Page', label: link.label, href: link.href }))
    const actions = [
      ...(adding ? [{ id: 'act-add', kind: 'Action', label: q ? 'Quick add “' + q + '”' : 'Quick add a task or to-do', run: 'add' }] : []),
      { id: 'act-keys', kind: 'Action', label: 'Keyboard shortcuts', run: 'keys' },
    ].filter((one) => !q || one.run === 'add' || matches(one.label, q))
    const records = found.hits.map((hit) => ({ id: 'hit-' + hit.href, kind: hit.kind, label: hit.label, context: hit.context, href: hit.href }))
    const moves = found.moves.map((move, index) => ({ id: 'move-' + index, kind: 'Move', label: move.label, move }))
    const search = q.trim().length > 1 ? [{ id: 'act-search', kind: 'Search', label: 'Search everything for “' + q.trim() + '”', href: '/search?q=' + encodeURIComponent(q.trim()) }] : []
    return [...moves, ...records, ...pages.slice(0, q ? 6 : 30), ...actions, ...search]
  }

  function openPalette() {
    const box = document.getElementById('hq-palette')
    if (!box || box.open) return
    q = ''
    active = 0
    found = { hits: [], moves: [] }
    refresh()
    box.showModal()
    document.getElementById('hq-palette-q')?.focus()
  }
  function closePalette() {
    document.getElementById('hq-palette')?.close()
  }
  function openKeys() {
    closePalette()
    document.getElementById('hq-keys')?.showModal()
  }

  function typed(event) {
    q = event.target.value
    active = 0
    clearTimeout(waiting)
    if (q.trim().length < 2) found = { hits: [], moves: [] }
    refresh()
    if (q.trim().length < 2) return
    waiting = setTimeout(lookUp, 150)
  }
  async function lookUp() {
    const mine = ++asked
    looking = true
    try {
      const answer = await fetch('/palette.json?q=' + encodeURIComponent(q.trim()), { credentials: 'same-origin', headers: { accept: 'application/json' } })
      const data = answer.ok ? await answer.json() : { hits: [], moves: [] }
      if (mine === asked) found = { hits: data.hits || [], moves: data.moves || [] }
    } catch {
      if (mine === asked) found = { hits: [], moves: [] }
    } finally {
      if (mine === asked) {
        looking = false
        refresh()
      }
    }
  }

  function choose(option) {
    if (!option) return
    if (option.href) return void (location.href = option.href)
    if (option.run === 'keys') return openKeys()
    if (option.run === 'add') {
      closePalette()
      const box = document.getElementById('hq-quick-text')
      if (!box) return
      box.value = q
      box.focus()
      return
    }
    if (option.move) {
      const form = document.createElement('form')
      form.method = 'post'
      form.action = option.move.action
      for (const [name, value] of Object.entries(option.move.fields)) {
        const input = document.createElement('input')
        input.type = 'hidden'
        input.name = name
        input.value = value
        form.append(input)
      }
      document.body.append(form)
      closePalette()
      form.requestSubmit()
    }
  }
  function keyInBox(event) {
    if (event.key === 'ArrowDown') {
      event.preventDefault()
      active = (active + 1) % Math.max(list.length, 1)
    } else if (event.key === 'ArrowUp') {
      event.preventDefault()
      active = (active - 1 + list.length) % Math.max(list.length, 1)
    } else if (event.key === 'Enter') {
      event.preventDefault()
      choose(list[active])
    } else return
    requestAnimationFrame(() => document.getElementById('hq-palette-option-' + active)?.scrollIntoView({ block: 'nearest' }))
  }

  const typing = (target) => target && (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName))
  function keys(event) {
    if ((event.key === 'k' || event.key === 'K') && (event.ctrlKey || event.metaKey) && !event.altKey && !event.shiftKey) {
      event.preventDefault()
      const box = document.getElementById('hq-palette')
      return box && box.open ? closePalette() : openPalette()
    }
    if (event.ctrlKey || event.metaKey || event.altKey || event.defaultPrevented || typing(event.target)) return
    if (document.querySelector('dialog[open]')) return
    if (event.key === '?') {
      event.preventDefault()
      return openKeys()
    }
    if (event.key === '/') {
      const search = document.getElementById('hq-find-q') || document.getElementById('search-q')
      if (!search) return
      event.preventDefault()
      return search.focus()
    }
    if (event.key === 'g' || event.key === 'G') {
      leader = Date.now()
      return
    }
    if (leader && Date.now() - leader < 1200) {
      leader = 0
      const jump = JUMPS.find((one) => one.key === event.key.toLowerCase())
      const allowed = jump && groups.some((group) => group.links.some((link) => link.href === jump.href))
      if (allowed) {
        event.preventDefault()
        location.href = jump.href
      }
    }
  }
  // A click on the dimmed space around a dialog closes it.
  function outside(event) {
    if (event.target === event.currentTarget) event.currentTarget.close()
  }

  onMount(() => {
    document.addEventListener('keydown', keys)
    document.addEventListener('hq-palette', openPalette)
  })
  onUnmount(() => {
    document.removeEventListener('keydown', keys)
    document.removeEventListener('hq-palette', openPalette)
  })
</script>
<style>
  .palette, .keys { width: min(36rem, calc(100vw - 2rem)); max-height: min(32rem, calc(100vh - 6rem)); margin: 12vh auto auto; padding: 0; color: var(--foreground); background: var(--card); border: 1px solid var(--border); border-radius: calc(var(--radius) + 4px); box-shadow: 0 24px 60px rgb(0 0 0 / 0.3); }
  .palette::backdrop, .keys::backdrop { background: rgb(9 24 31 / 0.45); }
  .palette-box { display: flex; align-items: center; gap: 0.6rem; padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); }
  .palette-box svg { flex: none; color: var(--muted-foreground); }
  .palette-box input { flex: 1; min-width: 0; height: 2.25rem; font: inherit; font-size: 1.05rem; color: var(--foreground); background: transparent; border: 0; outline: none; }
  .palette-box kbd, .keys kbd { padding: 0.1rem 0.4rem; font: inherit; font-size: 0.75rem; color: var(--muted-foreground); background: var(--muted); border: 1px solid var(--border); border-radius: 0.3rem; }
  .palette-list { max-height: 24rem; margin: 0; padding: 0.4rem; overflow-y: auto; list-style: none; }
  .palette-list li { display: flex; align-items: baseline; gap: 0.6rem; padding: 0.55rem 0.7rem; border-radius: var(--radius); cursor: pointer; }
  .palette-list li[aria-selected=true] { background: color-mix(in srgb, var(--ring) 16%, transparent); }
  .palette-kind { flex: none; width: 5.5rem; color: var(--muted-foreground); font-size: 0.8rem; }
  .palette-label { min-width: 0; overflow-wrap: anywhere; font-weight: 600; }
  .palette-context { color: var(--muted-foreground); font-size: 0.85rem; }
  .palette-empty { margin: 0; padding: 1rem; color: var(--muted-foreground); }
  .palette-foot { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; padding: 0.55rem 1rem; color: var(--muted-foreground); font-size: 0.8rem; border-top: 1px solid var(--border); }
  .keys { width: min(52rem, calc(100vw - 2rem)); max-height: calc(100vh - 4rem); margin-top: 6vh; padding: 1.25rem 1.5rem 1.5rem; overflow-y: auto; }
  .keys-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin: 0 0 1rem; }
  .keys h2 { margin: 0; font-size: 1.1rem; }
  .keys dl { display: grid; grid-template-columns: max-content 1fr max-content 1fr; gap: 0.55rem 1rem; margin: 0; }
  @media (max-width: 44rem) { .keys dl { grid-template-columns: max-content 1fr; } }
  .keys dt { white-space: nowrap; }
  .keys dd { margin: 0; }
  .keys form { margin: 0; }
</style>
<command-palette groups={[]} adding={false}>
  <dialog id="hq-palette" class="palette" aria-label="Command palette" onclick={outside}>
    <div class="palette-box">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M10 4a6 6 0 1 0 3.87 10.59l4.77 4.77 1.41-1.41-4.77-4.77A6 6 0 0 0 10 4Zm0 2a4 4 0 1 1 0 8 4 4 0 0 1 0-8Z"/></svg>
      <input id="hq-palette-q" type="text" role="combobox" aria-expanded="true" aria-controls="hq-palette-list" aria-autocomplete="list" aria-activedescendant={list.length > 0 ? 'hq-palette-option-' + active : null} aria-label="Go to, find or do" placeholder="Go to, find or do…" autocomplete="off" maxlength="100" value={q} oninput={typed} onkeydown={keyInBox}>
      <kbd aria-hidden="true">Esc</kbd>
    </div>
    <ul id="hq-palette-list" class="palette-list" role="listbox" aria-label="Results" aria-busy={looking ? 'true' : 'false'}>
      <zb-each items={list} as="option" key={option.id}>
        <li id={'hq-palette-option-' + option.index} role="option" aria-selected={option.index === active ? 'true' : 'false'} onclick={() => choose(option)} onmousemove={() => (active = option.index)}>
          <span class="palette-kind">{option.kind}</span>
          <span class="palette-label">{option.label}</span>
          <span zb-if={option.context} class="palette-context">{option.context}</span>
        </li>
      </zb-each>
    </ul>
    <p zb-if={list.length === 0 && q.trim() !== ''} class="palette-empty">{looking ? 'Looking…' : 'Nothing matches.'}</p>
    <div class="palette-foot" aria-hidden="true"><span>↑ ↓ to choose</span><span>Enter to go</span><span>? for every shortcut</span></div>
  </dialog>
  <dialog id="hq-keys" class="keys" aria-labelledby="hq-keys-title" onclick={outside}>
    <div class="keys-head">
      <h2 id="hq-keys-title">Keyboard shortcuts</h2>
      <form method="dialog"><button class="hq-button secondary" type="submit">Close</button></form>
    </div>
    <dl>
      <zb-each items={SHORTCUTS} as="shortcut" key={shortcut.keys}>
        <dt><kbd>{shortcut.keys}</kbd></dt>
        <dd>{shortcut.what}</dd>
      </zb-each>
    </dl>
  </dialog>
</command-palette>
