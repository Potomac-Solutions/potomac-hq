<!--
  "Fill in from…": three small forms, each folded away until opened, that
  fill an availability grid from somewhere else. A calendar's private
  address (only when `calendar` is true), a Timeful event's link, or a
  Calendly token. Each posts to `action` with `source` saying which.
  `prefix` keeps the fields' ids apart when two of these are on a page.
-->
<style>
  :host { display: block; }
  details { border-top: 1px solid var(--border); padding: 0.6rem 0; }
  details:last-of-type { border-bottom: 1px solid var(--border); }
  summary { cursor: pointer; font-weight: 600; padding: 0.15rem 0; }
  summary:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }
  summary span { font-weight: 400; color: var(--muted-foreground); }
  form { display: grid; gap: 0.75rem; margin: 0.75rem 0 0.25rem; max-width: 34rem; }
  .field { display: grid; gap: 0.25rem; }
  label { font-size: 0.875rem; font-weight: 600; }
  input { height: 2.25rem; padding: 0 0.6rem; font: inherit; color: var(--foreground); background: var(--background); border: 1px solid var(--input); border-radius: calc(var(--radius) - 2px); min-width: 0; }
  input:focus-visible { outline: 2px solid var(--ring); outline-offset: 1px; }
  .how { margin: 0; font-size: 0.875rem; color: var(--muted-foreground); }
  button { justify-self: start; height: 2.25rem; padding: 0 0.9rem; font: inherit; font-size: 0.875rem; font-weight: 600; color: var(--foreground); background: var(--background); border: 1px solid var(--border); border-radius: calc(var(--radius) - 2px); cursor: pointer; }
  button:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }
</style>
<fill-from action="" prefix="fill" calendar={false} kept="Nothing but the times is kept.">
  <details zb-if={calendar}>
    <summary>Your calendar <span>Google, Outlook or Apple</span></summary>
    <form method="post" action={action}>
      <input type="hidden" name="source" value="calendar">
      <p class="how">Paste your calendar’s private address. In Google Calendar: Settings → your calendar → “Secret address in iCal format”. Every open time you aren’t busy is marked. {kept}</p>
      <div class="field">
        <label for={prefix + '-calendar'}>Calendar address</label>
        <input id={prefix + '-calendar'} name="link" type="url" inputmode="url" autocomplete="off" placeholder="https://calendar.google.com/calendar/ical/…/basic.ics" required>
      </div>
      <button type="submit">Fill in from my calendar</button>
    </form>
  </details>
  <details>
    <summary>Timeful <span>an event you’ve already answered</span></summary>
    <form method="post" action={action}>
      <input type="hidden" name="source" value="timeful">
      <p class="how">Paste the event’s link. The times you marked on it are brought over. {kept}</p>
      <div class="field">
        <label for={prefix + '-timeful'}>Timeful link</label>
        <input id={prefix + '-timeful'} name="link" type="url" inputmode="url" autocomplete="off" placeholder="https://timeful.app/e/abc123" required>
      </div>
      <div class="field">
        <label for={prefix + '-timeful-name'}>Your name on it, if others answered too</label>
        <input id={prefix + '-timeful-name'} name="name" autocomplete="off" maxlength="80">
      </div>
      <button type="submit">Fill in from Timeful</button>
    </form>
  </details>
  <details>
    <summary>Calendly <span>the times you can be booked</span></summary>
    <form method="post" action={action}>
      <input type="hidden" name="source" value="calendly">
      <p class="how">Calendly only shares times with a token. In Calendly: Integrations &amp; apps → API and webhooks → Personal access tokens → make one, and paste it here. It is used once and not kept; you can delete it in Calendly afterwards.</p>
      <div class="field">
        <label for={prefix + '-calendly'}>Calendly personal access token</label>
        <input id={prefix + '-calendly'} name="token" type="password" autocomplete="off" required>
      </div>
      <button type="submit">Fill in from Calendly</button>
    </form>
  </details>
</fill-from>
