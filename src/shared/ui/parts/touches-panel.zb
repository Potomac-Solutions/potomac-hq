<!--
  A client's or an opportunity's touches: each call, email, text or meeting,
  newest first, and the form that logs one. On an opportunity, logging one
  can set the next follow-up. `touches` is what `context.crm.touches…` returns.
-->
<script>
  import '../zubra/select-field.zb'
  import '../zubra/status-badge.zb'
</script>
<style>
  .touches { list-style: none; margin: 0; padding: 0; }
  .touches > li { padding: 0.6rem 0; border-top: 1px solid var(--border); }
  .touches > li:first-child { border-top: 0; }
  .touches p { margin: 0; overflow-wrap: anywhere; }
  .touch-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 0.75rem; align-items: end; }
  .touch-form .touch-note { grid-column: 1 / -1; }
</style>
<touches-panel touches={{ items: [], canLog: false, kinds: [], outcomes: [], contacts: [], last: "", cold: "" }} action="" follow-up={false}>
  <section class="hq-panel" id="touches" aria-labelledby="touches-heading">
    <h2 id="touches-heading">Calls and messages</h2>
    <p class="hq-muted hq-small">{touches.last}</p>
    <p zb-if={touches.cold} class="hq-cold"><status-badge variant="danger">Going cold</status-badge> {touches.cold}</p>
    <details zb-if={touches.canLog} class="hq-more" open={touches.items.length === 0}>
      <summary>Log a call, email, text or meeting</summary>
      <form method="post" action={action} class="hq-form">
        <div class="touch-form">
          <select-field label="What" name="kind" options={touches.kinds} required={true}></select-field>
          <select-field label="If a call, how it went" name="outcome" options={touches.outcomes}></select-field>
          <div zb-if={touches.contacts.length > 0} class="hq-field">
            <label for="touch-contact">With</label>
            <select id="touch-contact" name="contactId">
              <option value="">Not saying</option>
              <zb-each items={touches.contacts} as="contact" key={contact.value}><option value={contact.value}>{contact.label}</option></zb-each>
            </select>
          </div>
          <div zb-if={followUp && touches.canFollowUp} class="hq-field">
            <label for="touch-follow-up">Next follow-up (optional)</label>
            <input id="touch-follow-up" name="followUpOn" type="date">
          </div>
          <div class="hq-field touch-note">
            <label for="touch-note">What was said or sent</label>
            <textarea id="touch-note" name="note" rows="2" maxlength="2000"></textarea>
          </div>
        </div>
        <div><button class="hq-button" type="submit">Log it</button></div>
      </form>
    </details>
    <ol zb-if={touches.items.length > 0} class="touches">
      <zb-each items={touches.items} as="touch" key={touch.id}>
        <li>
          <p><strong>{touch.label}</strong><span zb-if={touch.withWhom}> with {touch.withWhom}</span><span zb-if={touch.opportunityTitle}> · <a href="/opportunities/{touch.opportunityId}">{touch.opportunityTitle}</a></span></p>
          <p zb-if={touch.note} class="hq-prose">{touch.note}</p>
          <p class="hq-muted hq-small">{touch.who}, <time datetime={touch.whenIso}>{touch.when}</time></p>
        </li>
      </zb-each>
    </ol>
  </section>
</touches-panel>
