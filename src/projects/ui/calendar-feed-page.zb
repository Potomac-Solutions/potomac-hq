<!--
  Your calendar address (decision 0007, section 10): a private feed of your
  tasks with due dates and your projects' milestones, or of one saved filter,
  for Google Calendar, Apple Calendar or Outlook. The address is shown once,
  when it's made; making a new one stops the old.
-->
<script>
  'use route /calendar-feed'
  import '../../shared/ui/zubra/alert-banner.zb'
  export async function load({ context }) {
    const stop = context.guard()
    if (stop) return stop
    const view = context.projects.calendar()
    if (!view.ok) return context.forbidden()
    return { title: 'Calendar feed', view: view.value, done: context.notice.done, problem: context.notice.problem }
  }
</script>
<hq-calendar-feed view={{ on: false, filterName: '', made: '', lastUsed: '', filters: [] }} done="" problem="">
  <div class="hq-page">
    <h1>Calendar feed</h1>
    <p class="hq-muted">See your HQ work in Google Calendar, Apple Calendar or Outlook. It's read-only: changes in the calendar don't come back here.</p>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <section class="hq-panel" aria-labelledby="feed-now">
      <h2 id="feed-now">{view.on ? 'Your address is on' : 'No address yet'}</h2>
      <p zb-if={view.on}>Made {view.made}. {view.lastUsed ? 'A calendar last checked it ' + view.lastUsed + '.' : 'No calendar has checked it yet.'} It shows {view.filterName ? 'the tasks in your filter “' + view.filterName + '”' : 'your open tasks with due dates, the milestones of your projects, and the calls booked with you, at their times'}.</p>
      <p zb-if={view.on} class="hq-muted hq-small">The address was shown once, when it was made. If you've lost it, make a new one below; the old one stops working.</p>
      <p zb-if={!view.on}>Make a private address, then subscribe to it in your calendar. HQ shows it once.</p>
      <form method="post" action="/calendar-feed" class="hq-form" data-spaced>
        <div class="hq-field">
          <label for="feed-filter">What it shows</label>
          <select id="feed-filter" name="filterId">
            <option value="">My open tasks with due dates, my projects' milestones, and calls booked with me</option>
            <zb-each items={view.filters} as="one" key={one.value}><option value={one.value} selected={one.on}>The saved filter “{one.label}”</option></zb-each>
          </select>
          <p zb-if={view.filters.length === 0} class="hq-muted hq-small">Save a filter on <a href="/work">All work</a> to follow it here instead.</p>
        </div>
        <div><button class="hq-button" type="submit">{view.on ? 'Make a new address' : 'Make my address'}</button></div>
      </form>
      <form zb-if={view.on} method="post" action="/calendar-feed/stop" data-spaced>
        <button class="hq-button secondary" type="submit">Stop my address</button>
      </form>
    </section>
  </div>
</hq-calendar-feed>
