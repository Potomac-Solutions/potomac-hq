<!--
  One project's tasks as a board by status.
-->
<script>
  'use route /projects/:id/board'
  import '../../shared/ui/zubra/breadcrumb-trail.zb'
  import { notFound } from '@zubra/router'
  import '../../shared/ui/zubra/alert-banner.zb'
  import './task-board.zb'
  export async function load({ context, params, url }) {
    const stop = context.guard()
    if (stop) return stop
    const view = context.projects.board(params.id, url.searchParams.get('mine') === '1')
    if (!view.ok) return view.error === 'not-found' ? notFound() : context.forbidden()
    return { title: 'Board: ' + view.value.project.name, view: view.value, money: context.can.money, done: context.notice.done, problem: context.notice.problem }
  }
</script>
<hq-project-board view={{ project: {}, columns: [], statuses: [] }} money={false} done="" problem="">
  <div class="hq-page">
    <breadcrumb-trail items={[{ label: 'Projects', href: '/projects' }, { label: view.project.name, href: `/projects/${view.project.id}` }, { label: 'Board', href: '' }]}></breadcrumb-trail>
    <h1>Board</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <nav class="hq-tabs" aria-label="Project">
      <a href="/projects/{view.project.id}">Overview</a>
      <a href="/projects/{view.project.id}/tasks">Tasks</a>
      <a href="/projects/{view.project.id}/board" aria-current="page">Board</a>
      <a href="/projects/{view.project.id}/timeline">Timeline</a>
      <a zb-if={money} href="/projects/{view.project.id}/money">Money</a>
    </nav>
    <p><a zb-if={view.mine} href="/projects/{view.project.id}/board">Show everyone’s tasks</a><a zb-else href="/projects/{view.project.id}/board?mine=1">Show only mine</a> · <a href="/projects/{view.project.id}/tasks">Add a task</a></p>
    <task-board board={view}></task-board>
  </div>
</hq-project-board>
