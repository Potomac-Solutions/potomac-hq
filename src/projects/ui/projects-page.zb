<!--
  Every project, with its owner, how it is going and its next milestone. A
  client project starts from a won opportunity; a company project, Potomac's
  own work, starts here (decision 0021).
-->
<script>
  'use route /projects'
  import '../../shared/ui/zubra/status-badge.zb'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/empty-state.zb'
  import '../../shared/ui/zubra/text-field.zb'
  export async function load({ context, url }) {
    const stop = context.guard()
    if (stop) return stop
    const view = context.projects.list(url.searchParams.get('status') ?? '')
    if (!view.ok) return context.forbidden()
    return { title: 'Projects', view: view.value, done: context.notice.done, problem: context.notice.problem }
  }
</script>
<hq-projects view={{ projects: [], statuses: [], status: "", canStart: false, kinds: [], people: [], me: "" }} done="" problem="">
  <div class="hq-page">
    <h1>Projects</h1>
    <p><a href="/board">Open the board</a>: every active project’s tasks and everyone’s to-dos, by status.</p>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <details zb-if={view.canStart} class="hq-more" id="start">
      <summary>Start a company project</summary>
      <p class="hq-muted">Potomac’s own work, with no client: training and certifications, the website, HQ itself. It has phases, milestones, tasks and a board like any project, and shows on the company board. There’s nothing to bill and no portal.</p>
      <form method="post" action="/projects" class="hq-form">
        <text-field label="Name" name="name" required={true} description="Like: Training and certifications"></text-field>
        <div class="hq-field">
          <label for="company-kind">Kind</label>
          <select id="company-kind" name="kind">
            <zb-each items={view.kinds} as="kind" key={kind.value}><option value={kind.value}>{kind.label}</option></zb-each>
          </select>
        </div>
        <div class="hq-field">
          <label for="company-owner">Owner</label>
          <select id="company-owner" name="ownerId">
            <zb-each items={view.people} as="person" key={person.value}><option value={person.value} selected={person.value === view.me}>{person.label}</option></zb-each>
          </select>
        </div>
        <text-field label="About (optional)" name="description" rows={2}></text-field>
        <div><button class="hq-button" type="submit">Start project</button></div>
      </form>
    </details>
    <form method="get" action="/projects" class="hq-form-row">
      <div class="hq-field">
        <label for="project-filter">Show</label>
        <select id="project-filter" name="status">
          <option value="">Every project</option>
          <zb-each items={view.statuses} as="status" key={status.value}><option value={status.value} selected={status.value === view.status}>{status.label}</option></zb-each>
        </select>
      </div>
      <button class="hq-button secondary" type="submit">Filter</button>
    </form>
    <section class="hq-panel" aria-labelledby="projects-list">
      <h2 id="projects-list" class="sr-only">Projects</h2>
      <empty-state zb-if={view.projects.length === 0} heading={view.status ? "No projects with that status" : "No projects yet"}>A client project starts when a won opportunity is turned into one. A company project starts here.</empty-state>
      <table tabindex="0" zb-else class="hq-table">
        <thead><tr><th scope="col">Project</th><th scope="col">Client</th><th scope="col">Owner</th><th scope="col">Status</th><th scope="col">Going</th><th scope="col">Next milestone</th><th scope="col">Open tasks</th></tr></thead>
        <tbody>
          <zb-each items={view.projects} as="project" key={project.id}>
            <tr>
              <td><a href="/projects/{project.id}">{project.name}</a> <status-badge zb-if={project.demo} variant="outline">Demo</status-badge></td>
              <td><span zb-if={project.company} class="hq-muted">{project.clientName}</span><span zb-else>{project.clientName}</span></td>
              <td>{project.ownerName}</td>
              <td>{project.statusLabel}</td>
              <td><status-badge variant={project.health === 'on-track' ? 'success' : project.health === 'at-risk' ? 'warning' : project.health === 'off-track' ? 'danger' : 'neutral'} dot={true}>{project.healthLabel}</status-badge></td>
              <td>{project.next || "None set"} <status-badge zb-if={project.nextOverdue} variant="danger">Overdue</status-badge></td>
              <td>{project.openTasks}</td>
            </tr>
          </zb-each>
        </tbody>
      </table>
    </section>
  </div>
</hq-projects>
