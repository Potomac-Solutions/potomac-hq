<!--
  Every project, with its owner, how it is going and its next milestone. A
  project starts from a won opportunity, so there is no form here.
-->
<script>
  'use route /projects'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/empty-state.zb'
  export async function load({ context, url }) {
    const stop = context.guard()
    if (stop) return stop
    const view = context.projects.list(url.searchParams.get('status') ?? '')
    if (!view.ok) return context.forbidden()
    return { title: 'Projects', view: view.value, done: context.notice.done, problem: context.notice.problem }
  }
</script>
<hq-projects view={{ projects: [], statuses: [], status: "" }} done="" problem="">
  <div class="hq-page">
    <h1>Projects</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <form method="get" action="/projects" class="hq-form-row">
      <div class="hq-field">
        <label for="project-filter">Show</label>
        <select id="project-filter" name="status">
          <option value="">Every project</option>
          <zb-each items={view.statuses} as="status" key={status.value}><option value={status.value} selected={status.value === view.status}>{status.label}</option></zb-each>
        </select>
      </div>
      <button class="hq-button secondary" type="submit">Filter</button>
    </form>
    <section class="hq-panel" aria-labelledby="projects-list">
      <h2 id="projects-list" class="sr-only">Projects</h2>
      <empty-state zb-if={view.projects.length === 0} heading={view.status ? "No projects with that status" : "No projects yet"}>A project starts when a won opportunity is turned into one.</empty-state>
      <table zb-else class="hq-table">
        <thead><tr><th scope="col">Project</th><th scope="col">Client</th><th scope="col">Owner</th><th scope="col">Status</th><th scope="col">Going</th><th scope="col">Next milestone</th><th scope="col">Open tasks</th></tr></thead>
        <tbody>
          <zb-each items={view.projects} as="project" key={project.id}>
            <tr>
              <td><a href="/projects/{project.id}">{project.name}</a></td>
              <td>{project.clientName}</td>
              <td>{project.ownerName}</td>
              <td>{project.statusLabel}</td>
              <td><span class="hq-tag" data-health={project.health}>{project.healthLabel}</span></td>
              <td>{project.next || "None set"} <span zb-if={project.nextOverdue} class="hq-tag due">Overdue</span></td>
              <td>{project.openTasks}</td>
            </tr>
          </zb-each>
        </tbody>
      </table>
    </section>
  </div>
</hq-projects>
