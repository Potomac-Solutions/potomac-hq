<!--
  One task: where it stands, its subtasks, what it waits on and holds up
  (decision 0007, section 5), its files and comments (section 6), how it
  repeats (section 7), your reminders (section 8), its labels, and the form that edits it.
-->
<script>
  'use route /tasks/:id'
  import '../../shared/ui/zubra/breadcrumb-trail.zb'
  import '../../shared/ui/zubra/status-badge.zb'
  import { notFound } from '@zubra/router'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/text-field.zb'
  import './label-chips.zb'
  export async function load({ context, params }) {
    const stop = context.guard()
    if (stop) return stop
    const view = context.projects.task(params.id)
    if (!view.ok) return view.error === 'not-found' ? notFound() : context.forbidden()
    return { title: view.value.task.title, view: view.value, timer: context.time.forTask(params.id), reminders: context.bell.reminders(params.id), done: context.notice.done, problem: context.notice.problem }
  }
  const t = view.task
</script>
<style>
  .comments { display: grid; gap: 0.75rem; margin: 0 0 1rem; padding: 0; list-style: none; }
  .comment { padding: 0.75rem 0.9rem; border: 1px solid var(--border); border-radius: calc(var(--radius) - 2px); background: var(--background); }
  .comment header { display: flex; flex-wrap: wrap; gap: 0.25rem 0.6rem; align-items: baseline; margin-bottom: 0.35rem; }
  .comment header strong { font-size: 0.95rem; }
  .comment .comment-body { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  .comment .mention { font-weight: 650; color: var(--primary); }
  .comment details { margin-top: 0.5rem; }
  .comment summary { cursor: pointer; font-size: 0.875rem; font-weight: 600; }
  .comment-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-top: 0.5rem; }
</style>
<hq-task view={{ task: { labels: [] }, form: { people: [], phases: [], priorities: [], statuses: [] }, canEdit: false, labelChoices: [], colours: [], parent: null, subtasks: [], canAddSubtasks: false, waitingOn: [], holdsUp: [], blockerChoices: [], comments: [], files: [], canAttach: false, repeat: null, canRepeat: false, repeatUnits: [], previous: null, next: null }} timer={{ can: false }} reminders={[]} done="" problem="">
  <div class="hq-page">
    <breadcrumb-trail items={t.projectId ? [{ label: 'Projects', href: '/projects' }, { label: t.projectName, href: `/projects/${t.projectId}` }, { label: 'Tasks', href: `/projects/${t.projectId}/tasks` }, { label: t.title, href: '' }] : [{ label: 'My work', href: '/todos' }, { label: t.title, href: '' }]}></breadcrumb-trail>
    <p zb-if={t.ref} class="hq-ref hq-small">{t.ref}</p>
    <h1>{t.title}</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <section class="hq-panel" aria-labelledby="task-details">
      <h2 id="task-details">Where it stands</h2>
      <dl class="hq-facts">
        <dt>Status</dt><dd><strong>{t.statusLabel}</strong><span zb-if={t.doneWhen}>, {t.doneWhen}</span></dd>
        <dt>Who</dt><dd>{t.assigneeName || "Nobody yet"}</dd>
        <dt>Priority</dt><dd>{t.priorityLabel}</dd>
        <dt>Labels</dt><dd><label-chips zb-if={t.labels.length > 0} labels={t.labels}></label-chips><span zb-if={t.labels.length === 0}>None</span></dd>
        <dt zb-if={t.startOn}>Starts</dt><dd zb-if={t.startOn}><time datetime={t.startOn}>{t.startText}</time></dd>
        <dt>Due</dt><dd><time zb-if={t.dueOn} datetime={t.dueOn}>{t.dueText}</time><span zb-if={!t.dueOn}>Not set</span> <status-badge zb-if={t.overdue} variant="danger">Overdue</status-badge></dd>
        <dt>Estimate</dt><dd>{t.estimate ? t.estimate + " hours" : "Not set"}</dd>
        <dt zb-if={!t.projectId}>Kind</dt><dd zb-if={!t.projectId}>A to-do, not on a project</dd>
        <dt zb-if={view.parent}>Subtask of</dt><dd zb-if={view.parent}><a href={view.parent ? view.parent.href : ''}>{view.parent ? view.parent.title : ''}</a></dd>
        <dt zb-if={t.repeats}>Repeats</dt><dd zb-if={t.repeats}><a href="#repeat">{t.repeats}</a></dd>
        <dt zb-if={view.previous}>Before this</dt><dd zb-if={view.previous}><a href={view.previous ? view.previous.href : ''}>{view.previous ? view.previous.title : ''}</a> <span class="hq-muted hq-small">{view.previous ? view.previous.statusLabel : ''}</span></dd>
        <dt zb-if={view.next}>Next one</dt><dd zb-if={view.next}><a href={view.next ? view.next.href : ''}>{view.next ? view.next.title : ''}</a> <span class="hq-muted hq-small">{view.next ? view.next.statusLabel : ''}</span></dd>
        <dt zb-if={t.subtasks}>Subtasks</dt><dd zb-if={t.subtasks}><a href="#subtasks">{t.subtasks}</a></dd>
        <dt zb-if={t.waiting > 0}>Waiting on</dt><dd zb-if={t.waiting > 0}><a href="#waiting">{t.waiting === 1 ? '1 unfinished task' : t.waiting + ' unfinished tasks'}</a></dd>
        <dt zb-if={timer.can && t.projectId}>Time logged</dt><dd zb-if={timer.can && t.projectId}>{timer.logged}<span zb-if={timer.running}>, and your timer has been running for {timer.since}</span></dd>
        <dt zb-if={t.description}>Details</dt><dd zb-if={t.description} class="hq-prose">{t.description}</dd>
      </dl>
      <div class="hq-actions" data-spaced>
        <form zb-if={view.canEdit} method="post" action="/tasks/{t.id}/status" class="hq-form-row">
          <input type="hidden" name="returnTo" value="/tasks/{t.id}">
          <div class="hq-field">
            <label for="task-status">Move to</label>
            <select id="task-status" name="to">
              <zb-each items={view.form.statuses} as="status" key={status.value}><option value={status.value} selected={status.value === t.status}>{status.label}</option></zb-each>
            </select>
          </div>
          <button class="hq-button" type="submit">Move task</button>
        </form>
        <form zb-if={timer.running} method="post" action="/timer/stop">
          <input type="hidden" name="returnTo" value="/tasks/{t.id}">
          <button class="hq-button secondary" type="submit">Stop the timer</button>
        </form>
      </div>
      <p zb-if={view.canEdit && t.waiting > 0 && t.status !== 'done'} class="hq-small" data-spaced>It still waits on {t.waiting === 1 ? 'a task' : t.waiting + ' tasks'} that aren’t done. You can work on it anyway.</p>
      <p zb-if={timer.can && view.canEdit && !timer.running && t.projectId} class="hq-muted hq-small" data-spaced>Moving this to “Working on” starts your timer. Moving it on stops it and logs the time.</p>
    </section>
    <section zb-if={view.canAddSubtasks || view.subtasks.length > 0} id="subtasks" class="hq-panel" aria-labelledby="task-subtasks">
      <h2 id="task-subtasks">Subtasks <span zb-if={t.subtasks} class="hq-muted hq-small">{t.subtasks}</span></h2>
      <ul zb-if={view.subtasks.length > 0} class="hq-links">
        <zb-each items={view.subtasks} as="sub" key={sub.id}>
          <li><span><a href="/tasks/{sub.id}">{sub.title}</a> <span zb-if={sub.assigneeName} class="hq-muted hq-small">{sub.assigneeName}</span></span> <status-badge variant={sub.status === 'done' ? 'success' : sub.status === 'doing' ? 'primary' : 'neutral'}>{sub.statusLabel}</status-badge></li>
        </zb-each>
      </ul>
      <p zb-if={view.subtasks.length === 0} class="hq-muted">No subtasks yet. Break the work into steps here; each one is a task of its own.</p>
      <p zb-if={view.subtasks.length > 0} class="hq-muted hq-small">Finishing this task doesn’t finish its subtasks.</p>
      <form zb-if={view.canEdit && view.canAddSubtasks} method="post" action="/tasks/{t.id}/subtasks" class="hq-form-row" data-spaced>
        <text-field label="New subtask" name="title" required={true}></text-field>
        <div class="hq-field">
          <label for="subtask-who">Who</label>
          <select id="subtask-who" name="assigneeId">
            <option value="">Nobody yet</option>
            <zb-each items={view.form.people} as="person" key={person.value}><option value={person.value}>{person.label}</option></zb-each>
          </select>
        </div>
        <text-field label="Due" name="dueOn" type="date"></text-field>
        <button class="hq-button" type="submit">Add subtask</button>
      </form>
    </section>
    <section zb-if={view.canEdit || view.waitingOn.length > 0 || view.holdsUp.length > 0} id="waiting" class="hq-panel" aria-labelledby="task-waiting">
      <h2 id="task-waiting">Waiting on and holding up</h2>
      <h3 class="hq-small">Waits on</h3>
      <ul zb-if={view.waitingOn.length > 0} class="hq-links">
        <zb-each items={view.waitingOn} as="one" key={one.id}>
          <li>
            <span><span class="hq-ref">{one.ref}</span> <a href={one.href}>{one.title}</a> <span class="hq-muted hq-small">{one.where}</span> <status-badge variant={one.done ? 'success' : 'warning'}>{one.statusLabel}</status-badge></span>
            <form zb-if={view.canEdit} method="post" action="/tasks/{t.id}/blockers/remove" class="hq-inline">
              <input type="hidden" name="blockerId" value={one.id}>
              <button class="hq-button secondary small" type="submit" aria-label="Stop waiting on {one.title}">Stop waiting</button>
            </form>
          </li>
        </zb-each>
      </ul>
      <p zb-if={view.waitingOn.length === 0} class="hq-muted">Nothing. It can start whenever.</p>
      <form zb-if={view.canEdit && view.blockerChoices.length > 0} method="post" action="/tasks/{t.id}/blockers" class="hq-form-row" data-spaced>
        <div class="hq-field">
          <label for="blocker">It waits on</label>
          <select id="blocker" name="blockerId" required>
            <option value="">Choose a task</option>
            <zb-each items={view.blockerChoices} as="group" key={group.label}>
              <optgroup label={group.label}>
                <zb-each items={group.options} as="choice" key={choice.value}><option value={choice.value}>{choice.label}</option></zb-each>
              </optgroup>
            </zb-each>
          </select>
        </div>
        <button class="hq-button secondary" type="submit">Add</button>
      </form>
      <h3 class="hq-small">Holds up</h3>
      <ul zb-if={view.holdsUp.length > 0} class="hq-links">
        <zb-each items={view.holdsUp} as="one" key={one.id}>
          <li><span><span class="hq-ref">{one.ref}</span> <a href={one.href}>{one.title}</a> <span class="hq-muted hq-small">{one.where}</span></span> <status-badge variant={one.done ? 'success' : 'neutral'}>{one.statusLabel}</status-badge></li>
        </zb-each>
      </ul>
      <p zb-if={view.holdsUp.length === 0} class="hq-muted">Nothing waits on this.</p>
    </section>
    <section zb-if={view.canEdit && view.canRepeat} id="repeat" class="hq-panel" aria-labelledby="task-repeat">
      <h2 id="task-repeat">Repeat</h2>
      <p class="hq-muted">{t.repeats ? t.repeats + '. Finishing it makes the next one, with the same details, labels and subtasks.' : 'It happens once. Make it repeat, and finishing it makes the next one.'}</p>
      <form method="post" action="/tasks/{t.id}/repeat" class="hq-form-row">
        <div class="hq-field">
          <label for="repeat-every">Every</label>
          <input id="repeat-every" name="every" type="number" min="1" max="365" inputmode="numeric" value={view.repeat ? view.repeat.every : 1} required>
        </div>
        <div class="hq-field">
          <label for="repeat-unit">Unit</label>
          <select id="repeat-unit" name="unit">
            <zb-each items={view.repeatUnits} as="unit" key={unit.value}><option value={unit.value} selected={view.repeat ? unit.value === view.repeat.unit : unit.value === 'week'}>{unit.label}</option></zb-each>
          </select>
        </div>
        <div class="hq-field">
          <label for="repeat-from">Counted from</label>
          <select id="repeat-from" name="from">
            <option value="due" selected={!view.repeat || view.repeat.from === 'due'}>The due date</option>
            <option value="done" selected={!!view.repeat && view.repeat.from === 'done'}>The day it’s done</option>
          </select>
        </div>
        <button class="hq-button" type="submit">{view.repeat ? 'Save repeat' : 'Make it repeat'}</button>
      </form>
      <form zb-if={view.repeat} method="post" action="/tasks/{t.id}/repeat/stop" data-spaced>
        <button class="hq-button secondary" type="submit">Stop repeating</button>
      </form>
    </section>
    <section id="reminders" class="hq-panel" aria-labelledby="task-reminders">
      <h2 id="task-reminders">Reminders</h2>
      <ul zb-if={reminders.length > 0} class="hq-links">
        <zb-each items={reminders} as="one" key={one.id}>
          <li>
            <span>{one.text} <span class="hq-muted hq-small">{one.who}{one.who ? '. ' : ''}{one.fires}{one.carry ? '. Kept on each repeat' : ''}</span></span>
            <form zb-if={one.canRemove} method="post" action="/reminders/{one.id}/remove" class="hq-inline">
              <button class="hq-button secondary small" type="submit" aria-label="Remove the reminder: {one.text}">Remove</button>
            </form>
          </li>
        </zb-each>
      </ul>
      <p zb-if={reminders.length === 0} class="hq-muted">None. A reminder shows under the bell of whoever it's for: you, or whoever has the task when it comes due.</p>
      <form method="post" action="/tasks/{t.id}/reminders" class="hq-form-row" data-spaced>
        <input type="hidden" name="kind" value="before">
        <div class="hq-field">
          <label for="remind-days">Days before it's due</label>
          <input id="remind-days" name="daysBefore" type="number" min="0" max="30" inputmode="numeric" value="1" required>
        </div>
        <div class="hq-field">
          <label for="remind-time">At</label>
          <input id="remind-time" name="time" type="time" value="09:00" required>
        </div>
        <div class="hq-field">
          <label for="remind-before-for">For</label>
          <select id="remind-before-for" name="forWhom"><option value="me">Me</option><option value="assignee">Whoever has it</option></select>
        </div>
        <label class="hq-check"><input type="checkbox" name="carry" value="1" checked={!!t.repeats}> Keep it on each repeat</label>
        <button class="hq-button secondary" type="submit">Remind before it's due</button>
      </form>
      <form method="post" action="/tasks/{t.id}/reminders" class="hq-form-row" data-spaced>
        <input type="hidden" name="kind" value="at">
        <div class="hq-field">
          <label for="remind-when">Or on</label>
          <input id="remind-when" name="when" type="datetime-local" required>
        </div>
        <div class="hq-field">
          <label for="remind-at-for">For</label>
          <select id="remind-at-for" name="forWhom"><option value="me">Me</option><option value="assignee">Whoever has it</option></select>
        </div>
        <label class="hq-check"><input type="checkbox" name="carry" value="1"> Keep it on each repeat, moved with the due date</label>
        <button class="hq-button secondary" type="submit">Remind then</button>
      </form>
    </section>
    <section id="files" class="hq-panel" aria-labelledby="task-files">
      <h2 id="task-files">Files</h2>
      <ul zb-if={view.files.length > 0} class="hq-links">
        <zb-each items={view.files} as="file" key={file.id}>
          <li>
            <span><a href={file.href}>{file.name}</a> <span class="hq-muted hq-small">{file.size}</span></span>
            <span class="hq-muted hq-small">{file.who ? file.who + ', ' : ''}{file.when}</span>
            <form zb-if={view.canAttach} method="post" action="/tasks/{t.id}/files/remove" class="hq-inline">
              <input type="hidden" name="fileId" value={file.id}>
              <button class="hq-button secondary small" type="submit" aria-label="Remove {file.name}">Remove</button>
            </form>
          </li>
        </zb-each>
      </ul>
      <p zb-if={view.files.length === 0} class="hq-muted">No files yet.</p>
      <form zb-if={view.canAttach} method="post" action="/tasks/{t.id}/files" enctype="multipart/form-data" class="hq-form-row" data-spaced>
        <div class="hq-field">
          <label for="task-file">Attach a file</label>
          <input id="task-file" name="file" type="file" required>
          <p class="hq-muted hq-small">A PDF, an image, a text, CSV or Office file, or a zip, up to 25 MB.</p>
        </div>
        <button class="hq-button secondary" type="submit">Attach</button>
      </form>
    </section>
    <section id="comments" class="hq-panel" aria-labelledby="task-comments">
      <h2 id="task-comments">Comments</h2>
      <ol zb-if={view.comments.length > 0} class="comments">
        <zb-each items={view.comments} as="comment" key={comment.id}>
          <li id="comment-{comment.id}" class="comment">
            <header><strong>{comment.authorName}</strong> <span zb-if={comment.fromLink} class="hq-tag">Through the share link “{comment.fromLink}”</span> <span class="hq-muted hq-small">{comment.when}</span> <span zb-if={comment.editedWhen} class="hq-muted hq-small">(edited {comment.editedWhen})</span></header>
            <p class="comment-body"><zb-each items={comment.pieces} as="piece" key={piece.text + piece.mention}><strong zb-if={piece.mention} class="mention">{piece.text}</strong><span zb-if={!piece.mention}>{piece.text}</span></zb-each></p>
            <div zb-if={comment.canRemove} class="comment-actions">
              <details zb-if={comment.mine}>
                <summary>Edit your comment</summary>
                <form method="post" action="/comments/{comment.id}" class="hq-form">
                  <input type="hidden" name="taskId" value={t.id}>
                  <text-field label="Your comment" name="body" rows={3} value={comment.body} required={true}></text-field>
                  <div><button class="hq-button" type="submit">Save comment</button></div>
                </form>
              </details>
              <form method="post" action="/comments/{comment.id}/remove" class="hq-inline">
                <input type="hidden" name="taskId" value={t.id}>
                <button class="hq-button secondary small" type="submit" aria-label={comment.mine ? `Delete your comment from ${comment.when}` : `Delete ${comment.authorName}'s comment from ${comment.when}`}>Delete</button>
              </form>
            </div>
          </li>
        </zb-each>
      </ol>
      <p zb-if={view.comments.length === 0} class="hq-muted">No comments yet.</p>
      <form method="post" action="/tasks/{t.id}/comments" class="hq-form" data-spaced>
        <text-field label="Add a comment" name="body" rows={3} required={true} description="Mention someone with @ and their first name, like @jayanti."></text-field>
        <div><button class="hq-button" type="submit">Comment</button></div>
      </form>
    </section>
    <section zb-if={view.canEdit} id="labels" class="hq-panel" aria-labelledby="task-labels">
      <h2 id="task-labels">Labels</h2>
      <form method="post" action="/tasks/{t.id}/labels" class="hq-form">
        <fieldset zb-if={view.labelChoices.length > 0} class="hq-checks">
          <legend>Tick the ones this task has</legend>
          <zb-each items={view.labelChoices} as="choice" key={choice.id}>
            <label><input type="checkbox" name="label-{choice.id}" value="1" checked={choice.on}> <label-chips labels={[choice]}></label-chips></label>
          </zb-each>
        </fieldset>
        <div class="hq-form-row">
          <text-field label="Or a new label" name="newLabel" description="Made and put on when you save. A name that exists puts that one on."></text-field>
          <div class="hq-field">
            <label for="new-label-colour">Its colour</label>
            <select id="new-label-colour" name="newColour">
              <option value="">Pick one for me</option>
              <zb-each items={view.colours} as="colour" key={colour.value}><option value={colour.value}>{colour.label}</option></zb-each>
            </select>
          </div>
        </div>
        <div><button class="hq-button" type="submit">Save labels</button> <a class="hq-small" href="/labels">All labels</a></div>
      </form>
    </section>
    <section zb-if={view.canEdit} class="hq-panel" aria-labelledby="task-edit">
      <h2 id="task-edit">Edit</h2>
      <form method="post" action="/tasks/{t.id}" class="hq-form">
        <text-field label="Title" name="title" value={t.title} required={true}></text-field>
        <div class="hq-field">
          <label for="task-assignee">Who</label>
          <select id="task-assignee" name="assigneeId">
            <option value="">Nobody yet</option>
            <zb-each items={view.form.people} as="person" key={person.value}><option value={person.value} selected={person.value === t.assigneeId}>{person.label}</option></zb-each>
          </select>
        </div>
        <div class="hq-field">
          <label for="task-priority">Priority</label>
          <select id="task-priority" name="priority">
            <zb-each items={view.form.priorities} as="priority" key={priority.value}><option value={priority.value} selected={priority.value === t.priority}>{priority.label}</option></zb-each>
          </select>
        </div>
        <div zb-if={view.form.phases.length > 0} class="hq-field">
          <label for="task-phase">Phase</label>
          <select id="task-phase" name="phaseId">
            <option value="">None</option>
            <zb-each items={view.form.phases} as="phase" key={phase.value}><option value={phase.value} selected={phase.value === t.phaseId}>{phase.label}</option></zb-each>
          </select>
        </div>
        <text-field label="Starts" name="startOn" type="date" value={t.startOn} description="Optional. Draws it as a bar on the timeline."></text-field>
        <text-field label="Due" name="dueOn" type="date" value={t.dueOn}></text-field>
        <text-field label="Estimate in hours" name="estimate" inputmode="decimal" value={t.estimate}></text-field>
        <text-field label="Details" name="description" rows={3} value={t.description}></text-field>
        <div><button class="hq-button" type="submit">Save task</button></div>
      </form>
    </section>
  </div>
</hq-task>
