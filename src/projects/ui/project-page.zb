<!--
  One project: how it is going, its plan (phases and milestones, with the
  next milestone on top), its deliverables, its notes and its history. Tasks
  have their own list and board.
-->
<script>
  'use route /projects/:id'
  import '../../shared/ui/zubra/select-field.zb'
  import '../../shared/ui/zubra/breadcrumb-trail.zb'
  import '../../shared/ui/zubra/status-badge.zb'
  import { notFound } from '@zubra/router'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/empty-state.zb'
  import '../../shared/ui/zubra/text-field.zb'
  import '../../shared/ui/parts/notes-panel.zb'
  export async function load({ context, params }) {
    const stop = context.guard()
    if (stop) return stop
    const view = context.projects.overview(params.id)
    if (!view.ok) return view.error === 'not-found' ? notFound() : context.forbidden()
    return { title: view.value.project.name, view: view.value, notes: context.notes.list('project', params.id), updates: context.portalAdmin.updates(params.id), sent: context.portalAdmin.files(params.id), links: context.projects.links(params.id), shares: context.projects.shares(params.id), money: context.can.money, done: context.notice.done, problem: context.notice.problem }
  }
  const p = view.project
</script>
<hq-project view={{ project: {}, can: {}, phases: [], milestones: [], taskCounts: [], deliverables: [], history: [], healths: [], people: [], next: null, progress: {}, baseline: null }} notes={{ items: [] }} updates={{ items: [] }} sent={{ items: [] }} links={null} shares={{ canShare: false, links: [] }} money={false} done="" problem="">
  <div class="hq-page">
    <breadcrumb-trail items={[{ label: 'Projects', href: '/projects' }, { label: view.clientName, href: `/clients/${view.clientId}` }, { label: 'Opportunity', href: `/opportunities/${view.opportunityId}` }, { label: p.name, href: '' }]}></breadcrumb-trail>
    <div class="hq-head">
      <div><h1>{p.name}</h1><p><a href="/clients/{view.clientId}">{view.clientName}</a></p></div>
      <div class="hq-head-actions"><status-badge zb-if={p.demo} variant="outline">Demo</status-badge><status-badge variant="outline">{p.statusLabel}</status-badge><status-badge variant={p.health === 'on-track' ? 'success' : p.health === 'at-risk' ? 'warning' : p.health === 'off-track' ? 'danger' : 'neutral'} dot={true}>{p.healthLabel}</status-badge></div>
    </div>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <nav class="hq-tabs" aria-label="Project">
      <a href="/projects/{p.id}" aria-current="page">Overview</a>
      <a zb-if={view.can.viewTasks} href="/projects/{p.id}/tasks">Tasks</a>
      <a zb-if={view.can.viewTasks} href="/projects/{p.id}/board">Board</a>
      <a zb-if={view.can.viewTasks} href="/projects/{p.id}/timeline">Timeline</a>
      <a zb-if={money} href="/projects/{p.id}/money">Money</a>
    </nav>
    <div class="hq-split facts-first">
    <div class="hq-rail">
    <section class="hq-panel" aria-labelledby="project-details">
      <h2 id="project-details">Details</h2>
      <dl class="hq-facts">
        <dt>Status</dt><dd>{p.statusLabel}</dd>
        <dt>How it is going</dt><dd><status-badge variant={p.health === 'on-track' ? 'success' : p.health === 'at-risk' ? 'warning' : p.health === 'off-track' ? 'danger' : 'neutral'} dot={true}>{p.healthLabel}</status-badge></dd>
        <dt>Next milestone</dt>
        <dd>
          <span zb-if={view.next}>{view.next.name}<span zb-if={view.next.dueOn}>, due <time datetime={view.next.dueOn}>{view.next.dueText}</time></span> <status-badge zb-if={view.next.overdue} variant="danger">Overdue</status-badge></span>
          <span zb-else class="hq-muted">None set</span>
        </dd>
        <dt>Owner</dt><dd>{p.ownerName}</dd>
        <dt>Kind</dt><dd>{p.kindLabel}</dd>
        <dt>Starts</dt><dd>{p.startOn || "Not set"}</dd>
        <dt>Target</dt><dd>{p.targetOn || "Not set"}</dd>
        <dt zb-if={p.description}>About</dt><dd zb-if={p.description} class="hq-prose">{p.description}</dd>
      </dl>
      <details zb-if={view.can.edit} class="hq-more">
        <summary>Edit details</summary>
        <form method="post" action="/projects/{p.id}" class="hq-form">
          <text-field label="Name" name="name" value={p.name} required={true}></text-field>
          <div class="hq-field">
            <label for="project-health">How it is going</label>
            <select id="project-health" name="health">
              <zb-each items={view.healths} as="health" key={health.value}><option value={health.value} selected={health.value === p.health}>{health.label}</option></zb-each>
            </select>
          </div>
          <text-field label="Starts" name="startOn" type="date" value={p.startOn}></text-field>
          <text-field label="Target date" name="targetOn" type="date" value={p.targetOn}></text-field>
          <text-field label="About" name="description" rows={3} value={p.description}></text-field>
          <div><button class="hq-button" type="submit">Save project</button></div>
        </form>
      </details>
      <div class="hq-actions" data-spaced>
        <form zb-if={view.can.setOwner} method="post" action="/projects/{p.id}/owner" class="hq-form-row">
          <div class="hq-field">
            <label for="project-owner">Owner</label>
            <select id="project-owner" name="ownerId">
              <zb-each items={view.people} as="person" key={person.value}><option value={person.value} selected={person.value === p.ownerId}>{person.label}</option></zb-each>
            </select>
          </div>
          <button class="hq-button secondary" type="submit">Change owner</button>
        </form>
        <form zb-if={view.can.setStatus && !p.ongoing} method="post" action="/projects/{p.id}/status">
          <input type="hidden" name="status" value="completed">
          <button class="hq-button secondary" type="submit">Mark completed</button>
        </form>
        <form zb-if={view.can.setStatus} method="post" action="/projects/{p.id}/status">
          <input type="hidden" name="status" value="cancelled">
          <button class="hq-button secondary" type="submit">Cancel project</button>
        </form>
      </div>
    </section>
    <section zb-if={view.baseline} class="hq-panel" aria-labelledby="project-baseline">
      <h2 id="project-baseline">What was agreed</h2>
      <p>{view.baseline.amount}<span zb-if={view.baseline.hours}>, {view.baseline.hours} hours</span>. From <a href="/proposals/{view.baseline.proposalId}/versions/{view.baseline.version}">the accepted proposal, version {view.baseline.version}</a>.</p>
      <table tabindex="0" class="hq-table">
        <thead><tr><th scope="col">Item</th><th scope="col" class="hq-number">Hours or quantity</th><th scope="col" class="hq-number">Total</th></tr></thead>
        <tbody>
          <zb-each items={view.baseline.lines} as="line" key={line.key}><tr><td>{line.item}</td><td class="hq-number">{line.quantity}</td><td class="hq-number">{line.total}</td></tr></zb-each>
        </tbody>
      </table>
    </section>
    <section zb-if={links} class="hq-panel" id="links" aria-labelledby="project-links">
      <h2 id="project-links">Links</h2>
      <p zb-if={links.items.length === 0} class="hq-muted">Where the work lives: the staging and live sites, the designs, the code. Shared ones show in the client’s portal.</p>
      <ul zb-else class="hq-links">
        <zb-each items={links.items} as="link" key={link.id}>
          <li>
            <span><a href={link.url} rel="noopener noreferrer" target="_blank">{link.name}<span class="sr-only"> (opens in a new tab)</span></a> <span class="hq-muted hq-small">{link.host}<span zb-if={link.name !== link.kindLabel}> · {link.kindLabel}</span> · {link.shared ? 'In the portal' : 'Potomac only'}</span></span>
            <form zb-if={links.canEdit} method="post" action="/project-links/{link.id}/remove"><button class="hq-button secondary small" type="submit">Remove<span class="sr-only">: {link.name}</span></button></form>
          </li>
        </zb-each>
      </ul>
      <details zb-if={links.canEdit} class="hq-more">
        <summary>Add a link</summary>
        <form method="post" action="/projects/{view.project.id}/links" class="hq-form">
          <select-field label="What it is" name="kind" options={links.kinds}></select-field>
          <div class="hq-field">
            <label for="link-url">Web address</label>
            <input id="link-url" name="url" type="text" inputmode="url" maxlength="500" required placeholder="staging.example.com">
          </div>
          <div class="hq-field">
            <label for="link-label">Its own name (optional)</label>
            <input id="link-label" name="label" type="text" maxlength="80" placeholder="Menu mock-ups">
          </div>
          <div class="hq-check"><input id="link-shared" name="shared" type="checkbox" value="1" checked><label for="link-shared">Show it to the client in the portal</label></div>
          <div><button class="hq-button" type="submit">Add link</button></div>
        </form>
      </details>
    </section>
    <section zb-if={shares.canShare} class="hq-panel" id="share" aria-labelledby="project-share">
      <h2 id="project-share">Share by link</h2>
      <p class="hq-muted">A link anyone can open without an account: the plan, tasks with their status and due dates, and shared deliverables. Never notes, time, estimates, money, who has which task, or the team's own comments.</p>
      <table zb-if={shares.links.length > 0} tabindex="0" class="hq-table">
        <thead><tr><th scope="col">For</th><th scope="col">May</th><th scope="col">Works</th><th scope="col">Visits</th><th scope="col">Made by</th><th scope="col"><span class="sr-only">Stop</span></th></tr></thead>
        <tbody>
          <zb-each items={shares.links} as="one" key={one.id}>
            <tr>
              <td>{one.label}</td>
              <td>{one.rights}</td>
              <td>{one.live ? one.expires : one.state}</td>
              <td>{one.visits}</td>
              <td>{one.made}</td>
              <td>
                <form zb-if={one.live} method="post" action="/shares/{one.id}/stop" class="hq-inline">
                  <input type="hidden" name="projectId" value={view.project.id}>
                  <button class="hq-button secondary small" type="submit" aria-label="Stop the link for {one.label}">Stop</button>
                </form>
              </td>
            </tr>
          </zb-each>
        </tbody>
      </table>
      <details class="hq-more" open={shares.links.length === 0}>
        <summary>Make a link</summary>
        <form method="post" action="/projects/{view.project.id}/shares" class="hq-form">
          <div class="hq-field">
            <label for="share-label">Who it's for</label>
            <input id="share-label" name="label" type="text" maxlength="80" required placeholder="Dale at Better Days">
          </div>
          <div class="hq-field">
            <label for="share-rights">They may</label>
            <select id="share-rights" name="rights">
              <option value="see">See the project</option>
              <option value="comment">See it and comment on tasks</option>
            </select>
          </div>
          <div class="hq-field">
            <label for="share-expires">Last day it works (optional)</label>
            <input id="share-expires" name="expiresOn" type="date">
          </div>
          <div><button class="hq-button" type="submit">Make the link</button></div>
          <p class="hq-muted hq-small">HQ shows the link once, when it's made.</p>
        </form>
      </details>
    </section>
    <section class="hq-panel" aria-labelledby="project-history">
      <h2 id="project-history">History</h2>
      <empty-state zb-if={view.history.length === 0} heading="Nothing yet">Changes to this project are listed here.</empty-state>
      <ol zb-else class="hq-log">
        <zb-each items={view.history} as="event" key={event.id}>
          <li><span>{event.text}</span> <time datetime={event.whenIso}>{event.when}</time></li>
        </zb-each>
      </ol>
    </section>
    </div>
    <div>
    <section class="hq-panel" id="plan" aria-labelledby="project-plan">
      <h2 id="project-plan">Plan</h2>
      <p zb-if={view.progress.total > 0} class="hq-muted">{view.progress.done} of {view.progress.total} milestones done.</p>
      <p zb-if={view.phases.length > 0}>Phases: <zb-each items={view.phases} as="phase" key={phase.id}><status-badge>{phase.name}</status-badge> </zb-each></p>
      <empty-state zb-if={view.milestones.length === 0} heading="No milestones yet">Add the points you and the client will check the work against.</empty-state>
      <table tabindex="0" zb-else class="hq-table">
        <thead><tr><th scope="col">Milestone</th><th scope="col">Phase</th><th scope="col">Due</th><th scope="col">Done</th><th scope="col"><span class="sr-only">Change</span></th></tr></thead>
        <tbody>
          <zb-each items={view.milestones} as="milestone" key={milestone.id}>
            <tr>
              <td>{milestone.name} <status-badge zb-if={milestone.forClient}>Client’s to do</status-badge></td>
              <td>{milestone.phaseName}</td>
              <td><time zb-if={milestone.dueOn} datetime={milestone.dueOn}>{milestone.dueText}</time> <status-badge zb-if={milestone.overdue} variant="danger">Overdue</status-badge></td>
              <td><time zb-if={milestone.doneOn} datetime={milestone.doneOn}>{milestone.doneText}</time></td>
              <td>
                <form zb-if={view.can.plan} method="post" action="/milestones/{milestone.id}/done" class="hq-inline">
                  <input type="hidden" name="projectId" value={p.id}>
                  <input type="hidden" name="done" value={milestone.done ? "0" : "1"}>
                  <button class="hq-button secondary small" type="submit" aria-label="{milestone.done ? 'Reopen' : 'Mark done'}: {milestone.name}">{milestone.done ? "Reopen" : "Mark done"}</button>
                </form>
                <form zb-if={view.can.plan && !milestone.done} method="post" action="/milestones/{milestone.id}/for-client" class="hq-inline">
                  <input type="hidden" name="projectId" value={p.id}>
                  <input type="hidden" name="forClient" value={milestone.forClient ? "0" : "1"}>
                  <button class="hq-button secondary small" type="submit" aria-label="{milestone.forClient ? 'Make it ours to do' : 'Make it the client’s to do'}: {milestone.name}">{milestone.forClient ? "Ours to do" : "Client’s to do"}</button>
                </form>
              </td>
            </tr>
          </zb-each>
        </tbody>
      </table>
      <details zb-if={view.can.plan} class="hq-more">
        <summary>Add a milestone</summary>
        <form method="post" action="/projects/{p.id}/milestones" class="hq-form">
          <text-field label="Milestone" name="name" required={true} description="Like: Design signed off"></text-field>
          <text-field label="Due" name="dueOn" type="date"></text-field>
          <div zb-if={view.phases.length > 0} class="hq-field">
            <label for="milestone-phase">Phase</label>
            <select id="milestone-phase" name="phaseId">
              <option value="">None</option>
              <zb-each items={view.phases} as="phase" key={phase.id}><option value={phase.id}>{phase.name}</option></zb-each>
            </select>
          </div>
          <label class="hq-check"><input type="checkbox" name="forClient" value="1"> The client has to do this one <span class="hq-muted">(like sending photos). Their portal lists it under “waiting on you”.</span></label>
          <div><button class="hq-button" type="submit">Add milestone</button></div>
        </form>
      </details>
      <details zb-if={view.can.plan} class="hq-more">
        <summary>Add a phase</summary>
        <form method="post" action="/projects/{p.id}/phases" class="hq-form-row">
          <text-field label="Phase name" name="name" required={true} description="Like: Design, Build, Launch"></text-field>
          <button class="hq-button" type="submit">Add phase</button>
        </form>
      </details>
    </section>
    <section zb-if={view.can.viewTasks} class="hq-panel" aria-labelledby="project-tasks">
      <h2 id="project-tasks">Tasks</h2>
      <ul class="hq-counts">
        <zb-each items={view.taskCounts} as="count" key={count.status}><li><span>{count.label}</span> <strong>{count.count}</strong></li></zb-each>
      </ul>
      <p><a href="/projects/{p.id}/tasks">See the list</a> · <a href="/projects/{p.id}/board">See the board</a></p>
    </section>
    <section class="hq-panel" id="deliverables" aria-labelledby="project-deliverables">
      <h2 id="project-deliverables">Deliverables</h2>
      <empty-state zb-if={view.deliverables.length === 0} heading="No deliverables yet">Upload what you hand over: designs, documents, exports.</empty-state>
      <table tabindex="0" zb-else class="hq-table">
        <thead><tr><th scope="col">Deliverable</th><th scope="col">File</th><th scope="col">Status</th><th scope="col"><span class="sr-only">Change</span></th></tr></thead>
        <tbody>
          <zb-each items={view.deliverables} as="item" key={item.id}>
            <tr>
              <td><strong>{item.title}</strong><span zb-if={item.description}><br><span class="hq-muted">{item.description}</span></span></td>
              <td><a zb-if={view.can.download} href="/files/{item.fileId}">{item.fileName}</a><span zb-else>{item.fileName}</span> <span class="hq-muted">{item.fileSize}</span></td>
              <td>{item.statusLabel}<span zb-if={item.decisionNote}><br><span class="hq-muted">“{item.decisionNote}”</span></span></td>
              <td>
                <form zb-if={item.canShare} method="post" action="/deliverables/{item.id}/share" class="hq-inline">
                  <input type="hidden" name="projectId" value={p.id}>
                  <button class="hq-button secondary small" type="submit" aria-label="Share with the client: {item.title}">Share with the client</button>
                </form>
                <form zb-if={item.canUnshare} method="post" action="/deliverables/{item.id}/share" class="hq-inline">
                  <input type="hidden" name="projectId" value={p.id}>
                  <input type="hidden" name="shared" value="0">
                  <button class="hq-button secondary small" type="submit" aria-label="Stop sharing: {item.title}">Stop sharing</button>
                </form>
              </td>
            </tr>
          </zb-each>
        </tbody>
      </table>
      <details zb-if={view.can.editDeliverables} class="hq-more">
        <summary>Add a deliverable</summary>
        <form method="post" action="/projects/{p.id}/deliverables" enctype="multipart/form-data" class="hq-form">
          <text-field label="Title" name="title" required={true} description="Like: Home page design, first pass"></text-field>
          <text-field label="What it is" name="description" rows={2}></text-field>
          <div class="hq-field">
            <label for="deliverable-file">File</label>
            <input id="deliverable-file" name="file" type="file" required aria-describedby="deliverable-file-help">
            <p id="deliverable-file-help" class="hq-muted hq-small">A PDF, an image, a text, CSV or Office file, or a zip. Up to 25 MB.</p>
          </div>
          <div><button class="hq-button" type="submit">Upload deliverable</button></div>
        </form>
      </details>
    </section>
    <section zb-if={updates.canView} class="hq-panel" id="updates" aria-labelledby="project-updates">
      <h2 id="project-updates">Updates for the client</h2>
      <p class="hq-muted hq-small">What you post here, the client reads in the portal. Their messages come back here. Notes, below, stay inside HQ.</p>
      <p zb-if={updates.items.length === 0} class="hq-muted" data-spaced>No updates or messages yet.</p>
      <ol zb-else class="hq-notes">
        <zb-each items={updates.items} as="update" key={update.id}>
          <li>
            <p class="hq-prose">{update.body}</p>
            <p class="hq-muted hq-small"><status-badge zb-if={update.fromClient}>From the client</status-badge> {update.authorName}, <time datetime={update.whenIso}>{update.when}</time></p>
          </li>
        </zb-each>
      </ol>
      <form zb-if={updates.canPost} method="post" action="/projects/{p.id}/updates" class="hq-form" data-spaced>
        <div class="hq-field">
          <label for="update-body">Post an update for the client</label>
          <textarea id="update-body" name="body" rows="3" required maxlength="5000"></textarea>
        </div>
        <div><button class="hq-button" type="submit">Post update</button></div>
      </form>
    </section>
    <section zb-if={sent.canView && sent.items.length > 0} class="hq-panel" id="client-files" aria-labelledby="project-client-files">
      <h2 id="project-client-files">Files from the client</h2>
      <p class="hq-muted hq-small">Sent in through the portal. Each was checked for its type and size like any upload. Open one only if you were expecting it.</p>
      <ul class="hq-list">
        <zb-each items={sent.items} as="file" key={file.id}>
          <li><a href="/files/{file.id}" aria-label="Download {file.name}, sent by the client">{file.name}</a> <span class="hq-muted">{file.size} · {file.who}, <time datetime={file.whenIso}>{file.when}</time></span></li>
        </zb-each>
      </ul>
    </section>
    <notes-panel notes={notes}></notes-panel>
    </div>
    </div>
  </div>
</hq-project>
