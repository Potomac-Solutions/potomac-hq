<!--
  A client's social media in the portal (decision 0011): the month's posts
  Potomac wrote for them, to approve in one go or ask to change one by one,
  and the ones already up.
-->
<script>
  'use route /portal/social'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/empty-state.zb'
  import '../../shared/ui/zubra/status-badge.zb'
  import '../../shared/ui/zubra/text-field.zb'
  export async function load({ context, url }) {
    const stop = context.portal.guard()
    if (stop) return stop
    const view = context.social.mine(url.searchParams.get('month') ?? '')
    if (!view) return context.portal.missing()
    return { title: 'Your social media', view, done: context.notice.done, problem: context.notice.problem }
  }
</script>
<style>
  .ps-month { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
  .ps-month h2 { margin: 0; }
  .ps-posts { list-style: none; margin: 0; padding: 0; }
  .ps-posts > li { padding: 1rem 0; border-top: 1px solid var(--border); display: grid; gap: 0.4rem; }
  .ps-posts > li:first-child { border-top: 0; }
  .ps-posts p { margin: 0; overflow-wrap: anywhere; }
  .ps-words { white-space: pre-wrap; max-width: 65ch; }
  .ps-picture { display: block; width: 100%; max-width: 22rem; height: auto; border-radius: 0.25rem; }
</style>
<hq-portal-social view={{ posts: [] }} done="" problem="">
  <div class="hq-page">
    <p class="hq-crumbs"><a href="/portal">Back to your portal</a></p>
    <h1>Your social media</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <p class="hq-muted">{view.summary}. We write each month’s posts and send them here for you to look over before they go up.</p>

    <section class="hq-panel" aria-labelledby="ps-month">
      <div class="ps-month">
        <a class="hq-button secondary" href="/portal/social?month={view.previous}">Previous<span class="sr-only"> month</span></a>
        <h2 id="ps-month">{view.monthName}</h2>
        <a class="hq-button secondary" href="/portal/social?month={view.next}">Next<span class="sr-only"> month</span></a>
      </div>

      <div zb-if={view.waiting > 0} class="hq-panel">
        <p><strong>{view.waiting === 1 ? '1 post is' : view.waiting + ' posts are'} waiting on you.</strong> Read them below. If one needs changing, say what under it. Then approve the rest.</p>
        <p class="hq-small hq-muted">If we don’t hear from you by {view.approvesBy}, we’ll go ahead.</p>
        <form method="post" action="/portal/social/approve">
          <input type="hidden" name="month" value={view.month}>
          <button class="hq-button portal-big" type="submit">Approve {view.waiting === 1 ? 'it' : 'all ' + view.waiting}</button>
        </form>
      </div>

      <empty-state zb-if={view.posts.length === 0} heading="Nothing for {view.monthName} yet">When we send this month’s posts, they show here.</empty-state>
      <ol zb-else class="ps-posts">
        <zb-each items={view.posts} as="one" key={one.id}>
          <li id="post-{one.id}">
            <p><status-badge variant={one.status === 'sent' ? 'warning' : one.status === 'changes' ? 'primary' : 'success'}>{one.statusLabel}</status-badge> <strong>{one.dayText}</strong> · {one.kindLabel} · {one.where}</p>
            <p zb-if={one.title}><strong>{one.title}</strong></p>
            <p class="ps-words">{one.words}</p>
            <p zb-if={one.link} class="hq-small">Link: <a href={one.link} rel="noopener noreferrer" target="_blank">{one.link}</a></p>
            <div zb-if={one.pictureFileId}><img class="ps-picture" src="/portal/files/{one.pictureFileId}" alt={one.pictureAlt} loading="lazy"></div>
            <p zb-if={one.picture} class="hq-small">Picture: {one.picture}</p>
            <p zb-if={one.clientNote} class="hq-small">You asked: {one.clientNote}</p>
            <ul zb-if={one.postedLinks.length > 0} class="hq-list hq-small">
              <zb-each items={one.postedLinks} as="place" key={place.url}><li>See it on {place.label}: <a href={place.url} rel="noopener noreferrer" target="_blank">{place.url}</a></li></zb-each>
            </ul>
            <details zb-if={one.status === 'sent'} class="hq-more">
              <summary>Ask for a change<span class="sr-only"> to the post for {one.dayText}</span></summary>
              <form method="post" action="/portal/social/posts/{one.id}/changes" class="hq-form">
                <input type="hidden" name="month" value={view.month}>
                <text-field label="What should change" name="note" rows={3} required={true}></text-field>
                <button class="hq-button" type="submit">Send</button>
              </form>
            </details>
          </li>
        </zb-each>
      </ol>
    </section>
  </div>
</hq-portal-social>
