<!--
  The shell around every page. Signed in: a sidebar with the Potomac mark and
  HQ's pages in hubs (decision 0015), the hub you're in open, a top bar with search and the signed-in person's
  account, then the page. On a narrow screen the sidebar folds behind a Menu
  button. Signed out, a bar with the mark alone.
-->
<script>
  'use layout /'
  // The shell imports only components no page imports. One imported by both
  // was rendered twice on the server, nested inside itself (found in
  // @zubra/router 5.17.0: https://github.com/journey-to-code-org/zubra/issues/300).
  // user-avatar is the shell's alone; the account actions are a plain link
  // and a plain button, not action-button.
  import './shared/ui/zubra/user-avatar.zb'
  import './shared/ui/parts/command-bar.zb'
  import './shared/ui/parts/assistant-drawer.zb'
  import { onMount, onUnmount } from '@zubra/runtime'

  export async function load({ context, url }) {
    const can = context.can
    const path = url.pathname
    // On a call (decision 0009): a way back to its screen from any other page.
    const call = context.user ? context.crm.openCall() : null
    const onCall = call && path !== '/phone/' + call.id ? { href: '/phone/' + call.id, label: call.clientName ? 'On a call with ' + call.clientName : 'On a call' } : null
    // A booked call within 15 minutes: get ready for it, from any page.
    const next = !call && context.user ? context.crm.comingUp() : null
    const ready = next && path !== next.href ? { href: next.href, label: 'Call ' + next.startsText + ' with ' + next.who + ': get ready' } : null
    // AI drafts waiting for this person (decision 0012).
    const aiDrafts = context.user ? context.ai.draftCount() : 0
    // The sidebar (decision 0015): HQ's pages in eight hubs, the one you're in
    // open. The list of pages and who may open each lives in one place.
    const groups = context.user ? context.nav(path, url.search) : []
    const draftHub = aiDrafts > 0 ? 'today' : ''
    // Pins, and the assistant's drawer on any page but Home (decision 0015, follow-up).
    const pins = context.user ? context.pins(path + url.search) : { items: [], here: false, href: path }
    const here = pins.href
    const askOn = context.user ? context.ai.state('assistant').on : false
    const chatOpen = Boolean(context.user) && path !== '/' && url.searchParams.get('chat') === 'open'
    const chat = chatOpen ? context.assistant() : null
    const join = (href, add) => href + (href.includes('?') ? '&' : '?') + add
    const askHref = path === '/' ? '/#chat' : join(here, 'chat=open') + '#assistant'
    // The default title. A page's own title replaces it.
    return { title: 'Potomac HQ', who: context.user ? context.user.name : '', groups, aiDrafts, draftHub, pins, here, askOn, chat, askHref, closeHref: here, atHome: path === '/', searching: path === '/search', adding: can.add && path !== '/add', bell: context.user ? context.bell.unread() : 0, atNotices: path === '/notices', onCall, ready }
  }

  let menu = false
  // Recent records (decision 0015, follow-up): kept on this device only, and
  // cleared when you sign out.
  const RECENT = 'hq-recent'
  let recent = []
  const RECORD = /^\/(clients|opportunities|projects|tasks|proposals|invoices)\/[0-9a-f-]{36}$/
  function remember() {
    let list = []
    try {
      list = JSON.parse(localStorage.getItem(RECENT) || '[]')
    } catch {}
    const href = location.pathname
    if (RECORD.test(href) && document.title && document.title !== 'Potomac HQ') {
      list = [{ href, label: document.title }, ...list.filter((one) => one.href !== href)].slice(0, 6)
      try {
        localStorage.setItem(RECENT, JSON.stringify(list))
      } catch {}
    }
    recent = list.filter((one) => one && typeof one.href === 'string' && RECORD.test(one.href) && typeof one.label === 'string').map((one) => ({ href: one.href, label: one.label.slice(0, 80), current: one.href === href }))
  }
  function forget() {
    try {
      localStorage.removeItem(RECENT)
    } catch {}
  }

  // N goes to quick add, unless you're typing somewhere.
  function quickKey(event) {
    if (event.key !== 'n' && event.key !== 'N') return
    if (event.ctrlKey || event.metaKey || event.altKey || event.defaultPrevented) return
    const target = event.target
    if (target && (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName))) return
    const box = document.getElementById('hq-quick-text')
    if (!box) return
    event.preventDefault()
    box.focus()
  }
  // A refused form keeps what was typed. When a form is sent, this tab keeps
  // its fields for a moment; if the page that comes back says what was wrong
  // (?problem=), the form with the same address is filled in again. Passwords,
  // codes, tokens and files are never kept, and anything kept is gone as soon
  // as a page loads.
  const KEPT = 'hq-kept-form'
  const SECRET = /pass|secret|token|^code$|recovery|otp/i
  const keepable = (field) => field.name && !field.disabled && !['password', 'file', 'hidden', 'submit', 'button', 'reset', 'image'].includes(field.type) && !SECRET.test(field.name)
  function keepForm(event) {
    const form = event.target
    if (!(form instanceof HTMLFormElement) || (form.getAttribute('method') || '').toLowerCase() !== 'post') return
    const fields = [...form.elements].filter(keepable).map((field) => ({
      name: field.name,
      value: field.type === 'checkbox' || field.type === 'radio' ? field.checked : field.type === 'select-multiple' ? [...field.selectedOptions].map((o) => o.value) : field.value,
    }))
    try {
      sessionStorage.setItem(KEPT, JSON.stringify({ action: form.getAttribute('action') || '', fields }))
    } catch {}
  }
  function refill() {
    let kept = null
    try {
      kept = JSON.parse(sessionStorage.getItem(KEPT) || 'null')
      sessionStorage.removeItem(KEPT)
    } catch {}
    if (!kept || !new URL(location.href).searchParams.has('problem')) return
    const form = [...document.forms].find((one) => (one.getAttribute('action') || '') === kept.action && (one.getAttribute('method') || '').toLowerCase() === 'post')
    if (!form) return
    const seen = new Map()
    for (const { name, value } of kept.fields) {
      const all = [...form.elements].filter((field) => field.name === name && keepable(field))
      const index = seen.get(name) ?? 0
      seen.set(name, index + 1)
      const field = all.length > 1 ? all[index] : all[0]
      if (!field) continue
      if (typeof value === 'boolean') field.checked = value
      else if (Array.isArray(value)) for (const option of field.options) option.selected = value.includes(option.value)
      else field.value = value
    }
    form.closest('details')?.setAttribute('open', '')
  }
  onMount(() => {
    document.addEventListener('keydown', quickKey)
    document.addEventListener('submit', keepForm)
    refill()
    remember()
  })
  onUnmount(() => {
    document.removeEventListener('keydown', quickKey)
    document.removeEventListener('submit', keepForm)
  })
</script>
<style>
  :host { display: block; min-height: 100vh; }
  .hq-brand { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 700; font-size: 1.05rem; letter-spacing: -0.01em; color: inherit; text-decoration: none; white-space: nowrap; }
  .hq-brand img { width: 1.75rem; height: 1.75rem; }
  .hq-signed-out { padding: 0.8rem 1.25rem; border-bottom: 1px solid var(--border); background: var(--card); color: var(--foreground); }

  .hq-shell { display: grid; grid-template-columns: 15rem minmax(0, 1fr); min-height: 100vh; }
  .hq-side { position: sticky; top: 0; align-self: start; height: 100vh; overflow-y: auto; display: flex; flex-direction: column; gap: 1.25rem; padding: 1rem 0.75rem 1.25rem; background: var(--sidebar); color: var(--sidebar-foreground); border-right: 1px solid var(--sidebar-border); }
  .hq-side-top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.15rem 0.5rem; }
  .hq-menu { display: none; height: 2.25rem; padding: 0 0.8rem; font: inherit; font-size: 0.875rem; font-weight: 600; color: var(--sidebar-foreground); background: transparent; border: 1px solid var(--sidebar-border); border-radius: calc(var(--radius) - 2px); cursor: pointer; }
  .hq-nav { display: grid; gap: 0.15rem; }
  .hq-nav summary, .hq-hub-one { display: flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0.6rem; border-radius: calc(var(--radius) - 2px); color: var(--sidebar-foreground); font-size: 0.95rem; font-weight: 650; text-decoration: none; cursor: pointer; list-style: none; }
  .hq-nav summary::-webkit-details-marker { display: none; }
  .hq-nav summary::after { content: ""; margin-left: auto; width: 0.45rem; height: 0.45rem; border-right: 2px solid var(--sidebar-muted); border-bottom: 2px solid var(--sidebar-muted); transform: rotate(-45deg); transition: transform 120ms ease; }
  .hq-nav details[open] > summary::after { transform: rotate(45deg); }
  .hq-nav summary:hover, .hq-hub-one:hover { background: color-mix(in srgb, var(--sidebar-accent) 60%, transparent); }
  .hq-hub.current > details > summary, .hq-hub.current > .hq-hub-one { color: #9fd6fb; }
  .hq-hub-count { display: inline-grid; place-items: center; min-width: 1.25rem; height: 1.25rem; padding: 0 0.3rem; font-size: 0.75rem; font-weight: 700; color: var(--primary-foreground); background: var(--primary); border-radius: 999px; }
  .hq-nav summary:focus-visible { outline: 2px solid #9fd6fb; outline-offset: 1px; }
  .hq-nav ul { display: grid; gap: 1px; margin: 0.1rem 0 0.5rem 0.6rem; padding: 0 0 0 0.35rem; list-style: none; border-left: 1px solid var(--sidebar-border); }
  .hq-nav ul a { display: block; padding: 0.4rem 0.6rem; border-radius: calc(var(--radius) - 2px); color: var(--sidebar-foreground); font-size: 0.9rem; font-weight: 500; text-decoration: none; border-left: 3px solid transparent; }
  .hq-nav ul a:hover { background: color-mix(in srgb, var(--sidebar-accent) 60%, transparent); }
  .hq-nav a[aria-current=page] { background: var(--sidebar-accent); font-weight: 650; border-left-color: #6cc0f5; }
  .hq-side a:focus-visible, .hq-menu:focus-visible { outline: 2px solid #9fd6fb; outline-offset: 1px; }

  .hq-body { display: flex; flex-direction: column; min-width: 0; }
  .hq-top { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 1rem; padding: 0.6rem 1.75rem; background: var(--card); border-bottom: 1px solid var(--border); }
  .hq-find { flex: 1 1 auto; max-width: 28rem; margin: 0; }
  .hq-find input { width: 100%; height: 2.25rem; padding: 0 0.75rem; font: inherit; font-size: 0.9rem; color: var(--foreground); background: var(--canvas); border: 1px solid var(--border); border-radius: calc(var(--radius) - 2px); }
  .hq-find input:focus-visible { outline: 2px solid var(--ring); outline-offset: 1px; background: var(--background); }
  .hq-quick { flex: 1 1 auto; max-width: 22rem; margin: 0; }
  .hq-quick input { width: 100%; height: 2.25rem; padding: 0 0.75rem; font: inherit; font-size: 0.9rem; color: var(--foreground); background: var(--canvas); border: 1px dashed var(--border); border-radius: calc(var(--radius) - 2px); }
  .hq-quick input:focus-visible { outline: 2px solid var(--ring); outline-offset: 1px; background: var(--background); border-style: solid; }
  .hq-account { display: flex; align-items: center; gap: 0.5rem; margin-left: auto; white-space: nowrap; }
  .hq-who { font-size: 0.875rem; font-weight: 600; margin-right: 0.35rem; }
  .hq-account form { display: inline; margin: 0; }
  .hq-account-action { display: inline-flex; align-items: center; height: 2rem; padding: 0 0.7rem; font: inherit; font-size: 0.8125rem; font-weight: 600; color: var(--foreground); background: var(--background); border: 1px solid var(--border); border-radius: calc(var(--radius) - 2px); text-decoration: none; cursor: pointer; }
  .hq-account-action:hover { background: var(--accent); color: var(--accent-foreground); }
  .hq-bell { gap: 0.35rem; }
  .hq-on-call { gap: 0.4rem; color: var(--label-green-fg); background: var(--label-green-bg); border-color: transparent; font-weight: 600; }
  .hq-ready { color: var(--label-amber-fg); background: var(--label-amber-bg); border-color: transparent; font-weight: 600; }
  .hq-on-call-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: currentColor; }
  .hq-bell[aria-current=page] { border-color: var(--ring); }
  .hq-bell-count { display: inline-grid; place-items: center; min-width: 1.25rem; height: 1.25rem; padding: 0 0.3rem; font-size: 0.75rem; font-weight: 700; line-height: 1; color: var(--primary-foreground); background: var(--primary); border-radius: 999px; }
  .hq-main { width: 100%; max-width: 82rem; margin: 0 auto; padding: 1.5rem 1.75rem 3rem; }
  .hq-main:focus { outline: none; }
  .hq-main.narrow { max-width: 64rem; padding: 1.5rem 1rem 3rem; }

  .hq-pin-form { display: inline; margin: 0; }
  .hq-pin-form button { gap: 0.3rem; }
  .hq-ask { color: var(--primary-foreground); background: var(--primary); border-color: transparent; }
  .hq-pins summary::before { content: "★"; font-size: 0.8rem; }
  .hq-tabbar { display: none; }

  @media (max-width: 60rem) {
    .hq-shell { padding-bottom: 4rem; }
    .hq-tabbar { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-around; padding: 0.35rem 0.5rem calc(0.35rem + env(safe-area-inset-bottom)); background: var(--card); border-top: 1px solid var(--border); }
    .hq-tabbar a { flex: 1 1 0; display: grid; place-items: center; min-height: 2.75rem; font-size: 0.8125rem; font-weight: 600; color: var(--foreground); text-decoration: none; border-radius: calc(var(--radius) - 2px); }
    .hq-tabbar a[aria-current=page] { color: var(--primary); }
    .hq-pin-label, .hq-ask, .hq-find { display: none; }
    .hq-shell { display: block; }
    .hq-side { position: static; height: auto; gap: 0.75rem; padding: 0.6rem 0.75rem; }
    .hq-menu { display: inline-flex; align-items: center; }
    .hq-nav { display: none; padding-bottom: 0.5rem; }
    .hq-side.open .hq-nav { display: grid; }
    .hq-top { position: static; padding: 0.6rem 1rem; flex-wrap: wrap; }
    .hq-who, .hq-account user-avatar { display: none; }
    .hq-main { padding: 1.25rem 1rem 3rem; }
  }
</style>
<hq-app who="" groups={[]} ai-drafts={0} draft-hub="" pins={{ items: [], here: false, href: '/' }} here="/" ask-on={false} chat={null} ask-href="/" close-href="/" at-home={false} searching={false} adding={false} bell={0} at-notices={false} on-call={null} ready={null}>
  <a class="skip-link" href="#main">Skip to content</a>
  <div zb-if={who} class="hq-shell">
    <aside class="hq-side" class:open={menu}>
      <div class="hq-side-top">
        <a class="hq-brand" href="/"><img src="/assets/potomac-mark.webp" alt="" width="28" height="28"> Potomac HQ</a>
        <button type="button" class="hq-menu" aria-expanded={menu ? 'true' : 'false'} aria-controls="hq-nav" onclick={() => (menu = !menu)}>Menu</button>
      </div>
      <nav class="hq-nav" id="hq-nav" aria-label="Main">
        <div zb-if={pins.items.length > 0} class="hq-hub hq-pins">
          <details open={true}>
            <summary>Pinned</summary>
            <ul>
              <zb-each items={pins.items} as="pin" key={pin.href}>
                <li><a href={pin.href} aria-current={pin.current ? 'page' : null}>{pin.label}</a></li>
              </zb-each>
            </ul>
          </details>
        </div>
        <zb-each items={groups} as="hub" key={hub.key}>
          <div class="hq-hub" class:current={hub.current}>
            <a zb-if={hub.single} class="hq-hub-one" href={hub.links[0].href} aria-current={hub.links[0].current ? 'page' : null}>{hub.label}</a>
            <details zb-else open={hub.open}>
              <summary>{hub.label}<span zb-if={hub.key === draftHub} class="hq-hub-count">{aiDrafts}<span class="sr-only"> AI drafts waiting</span></span></summary>
              <ul>
                <zb-each items={hub.links} as="link" key={link.href}>
                  <li><a href={link.href} aria-current={link.current ? 'page' : null}>{link.label}</a></li>
                </zb-each>
              </ul>
            </details>
          </div>
        </zb-each>
        <div zb-if={recent.length > 0} class="hq-hub">
          <details>
            <summary>Recent</summary>
            <ul>
              <zb-each items={recent} as="item" key={item.href}>
                <li><a href={item.href} aria-current={item.current ? 'page' : null}>{item.label}</a></li>
              </zb-each>
            </ul>
          </details>
        </div>
      </nav>
    </aside>
    <div class="hq-body">
      <header class="hq-top">
        <form zb-if={!searching} method="get" action="/search" role="search" class="hq-find">
          <label class="sr-only" for="hq-find-q">Search HQ</label>
          <input id="hq-find-q" name="q" type="search" placeholder="Search pages, clients, projects, invoices…" autocomplete="off" maxlength="100">
        </form>
        <command-bar here={here} ask={askOn}></command-bar>
        <form zb-if={adding} method="get" action="/add" class="hq-quick">
          <label class="sr-only" for="hq-quick-text">Quick add a task or to-do (shortcut N)</label>
          <input id="hq-quick-text" name="text" placeholder="Quick add… (N)" autocomplete="off" maxlength="300" aria-keyshortcuts="n">
        </form>
        <div class="hq-account">
          <a zb-if={askOn && !atHome} class="hq-account-action hq-ask" href={askHref}>Ask</a>
          <form method="post" action="/nav/pin" class="hq-pin-form"><input type="hidden" name="href" value={here}><button class="hq-account-action" type="submit" aria-pressed={pins.here ? 'true' : 'false'} title={pins.here ? 'Unpin this page from your sidebar' : 'Pin this page to your sidebar'}><span aria-hidden="true">{pins.here ? '★' : '☆'}</span><span class="hq-pin-label">{pins.here ? 'Pinned' : 'Pin'}</span></button></form>
          <a zb-if={onCall} class="hq-account-action hq-on-call" href={onCall.href}><span class="hq-on-call-dot" aria-hidden="true"></span>{onCall.label}</a>
          <a zb-if={ready} class="hq-account-action hq-ready" href={ready.href}>{ready.label}</a>
          <a class="hq-account-action hq-bell" href="/notices" aria-current={atNotices ? 'page' : null}><svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2Z"/></svg><span class="hq-bell-label">Notices</span><span zb-if={bell > 0} class="hq-bell-count">{bell > 99 ? '99+' : bell}<span class="sr-only"> new</span></span></a>
          <user-avatar name={who} size="sm"></user-avatar>
          <span class="hq-who">{who}</span>
          <a class="hq-account-action" href="/settings">Settings</a>
          <form method="post" action="/staff/sign-out" onsubmit={forget}>
            <button class="hq-account-action" type="submit">Sign out</button>
          </form>
        </div>
      </header>
      <main id="main" class="hq-main" tabindex="-1">
        <zb-slot></zb-slot>
      </main>
    </div>
    <assistant-drawer zb-if={chat} view={chat} from={here} close={closeHref}></assistant-drawer>
    <nav class="hq-tabbar" aria-label="Quick">
      <a href="/" aria-current={atHome ? 'page' : null}>Home</a>
      <a href="/today">Today</a>
      <a href="/search">Search</a>
      <a zb-if={adding} href="/add">Add</a>
      <a zb-if={askOn} href={askHref}>Ask</a>
    </nav>
  </div>
  <div zb-else>
    <header class="hq-signed-out">
      <a class="hq-brand" href="/"><img src="/assets/potomac-mark.webp" alt="" width="28" height="28"> Potomac HQ</a>
    </header>
    <main id="main" class="hq-main narrow" tabindex="-1">
      <zb-slot></zb-slot>
    </main>
  </div>
</hq-app>
