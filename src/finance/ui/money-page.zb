<!--
  Every project's budget against actual, with a revenue and margin summary,
  and the CSV exports. A management view, not the books.
-->
<script>
  'use route /money'
  import '../../shared/ui/zubra/status-badge.zb'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/empty-state.zb'
  import '../../shared/ui/zubra/text-field.zb'
  export async function load({ context }) {
    const stop = context.guard()
    if (stop) return stop
    const view = context.money.overview()
    if (!view.ok) return context.forbidden()
    const recurring = context.money.recurring()
    return { title: 'Money', view: view.value, recurring: recurring.ok ? recurring.value : null, reminders: context.money.reminders(), lateFee: context.money.lateFee(), taxYears: context.money.taxYears(), lateWords: context.money.lateFee().words.toLowerCase(), pay: context.money.payInstructions(), done: context.notice.done, problem: context.notice.problem }
  }
</script>
<hq-money view={{ rows: [], totals: {}, canExport: false }} recurring={null} reminders={{ on: false, canEdit: false, email: false }} late-fee={{ words: 'Off', kind: 'off', amount: '', afterDays: 30, canEdit: false }} late-words="off" tax-years={[]} pay={null} done="" problem="">
  <div class="hq-page">
    <h1>Money</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <section class="hq-panel" aria-labelledby="money-summary">
      <h2 id="money-summary">Revenue and margin, an operational estimate</h2>
      <p><a href="/money/forecast">Cash forecast</a>: money coming in and going out, the next 13 weeks. <a href="/money/invoices">Invoices</a>: who owes what, overdue and drafts. <a href="/money/profit">Profit and loss by month</a>: money received against money spent. <a href="/money/clients">Profit by client</a>: who’s worth the time.</p>
      <dl class="hq-facts">
        <dt>Budgets, every project</dt><dd>{view.totals.budget}</dd>
        <dt>Cost so far</dt><dd>{view.totals.cost}</dd>
        <dt>Margin</dt><dd><strong>{view.totals.margin}</strong></dd>
      </dl>
      <p class="hq-muted hq-small" data-spaced>Budgets come from accepted proposals unless set by hand. Cost is time at each project’s hourly rate plus expenses. A recurring plan is measured over its current month or year. This is not the books.</p>
    </section>
    <section zb-if={recurring} class="hq-panel" id="recurring" aria-labelledby="money-recurring">
      <h2 id="money-recurring">Recurring: {recurring.monthly} a month, {recurring.yearly} a year</h2>
      <p zb-if={recurring.items.length === 0} class="hq-muted">Nothing recurs yet. Set up hosting, maintenance or a retainer on a project’s Money page.</p>
      <table tabindex="0" zb-else class="hq-table">
        <thead><tr><th scope="col">For</th><th scope="col">Project</th><th scope="col">How often</th><th scope="col">Next</th><th scope="col" class="hq-number">Each time</th><th scope="col" class="hq-number">A month</th></tr></thead>
        <tbody>
          <zb-each items={recurring.items} as="plan" key={plan.id}>
            <tr>
              <td>{plan.description}</td>
              <td><a zb-if={plan.projectId} href="/projects/{plan.projectId}/money#recurring">{plan.projectName}</a><a zb-else href="/clients/{plan.organizationId}#billing">No project</a><span zb-if={plan.clientName} class="hq-muted"> · {plan.clientName}</span></td>
              <td>{plan.everyLabel}</td>
              <td><time datetime={plan.nextOn}>{plan.next}</time></td>
              <td class="hq-number">{plan.amount}</td>
              <td class="hq-number">{plan.monthly}</td>
            </tr>
          </zb-each>
        </tbody>
      </table>
    </section>
    <section class="hq-panel" id="reminders" aria-labelledby="money-reminders">
      <h2 id="money-reminders">Invoice reminders: {reminders.on ? 'on' : 'off'}</h2>
      <p>{reminders.on ? 'Clients are emailed about a sent invoice three days before it is due, the day after, a week late and two weeks late. Then it is a phone call.' : 'When on, clients are emailed about a sent invoice three days before it is due, the day after, a week late and two weeks late.'} Each goes to the client’s primary contact, or their portal users, once. Any invoice can be left out on its own page.</p>
      <p zb-if={!reminders.email} class="hq-muted">Email isn’t set up, so nothing is sent yet.</p>
      <form zb-if={reminders.canEdit} method="post" action="/money/reminders">
        <input type="hidden" name="on" value={reminders.on ? '0' : '1'}>
        <button class="hq-button secondary" type="submit">{reminders.on ? 'Turn reminders off' : 'Turn reminders on'}</button>
      </form>
    </section>
    <section zb-if={taxYears.length > 0} class="hq-panel" id="tax-pack" aria-labelledby="money-tax-pack">
      <h2 id="money-tax-pack">Year-end tax pack</h2>
      <p>One zip for whoever does your taxes: money in and refunds, by client; expenses by category with their receipts; what was owed at the year’s end; what was written off. Cash basis.</p>
      <ul class="hq-list">
        <zb-each items={taxYears} as="year" key={year}><li><a href="/exports/tax-pack-{year}.zip" download>Taxes for {year}</a></li></zb-each>
      </ul>
      <p class="hq-small hq-muted">Card processing fees aren’t in HQ: download those from PayPal’s yearly statement. It’s a summary to hand over, not tax advice.</p>
    </section>
    <section class="hq-panel" id="late-fees" aria-labelledby="money-late-fees">
      <h2 id="money-late-fees">Late fees: {lateWords}</h2>
      <p>When set, an invoice that reaches the day gets one late fee, as its own invoice in the client’s portal, due two weeks later. Never on a late fee, never twice. An invoice already past that day when you save this isn’t charged: only ones that reach it afterwards. At two weeks late, whoever made the invoice also gets a to-do to call the client, fee or not.</p>
      <p class="hq-muted">Only charge a late fee your agreement with the client mentions, and check what your state allows.</p>
      <form zb-if={lateFee.canEdit} method="post" action="/money/late-fee" class="hq-form" data-spaced>
        <fieldset class="hq-radios">
          <legend>Late fee</legend>
          <label><input type="radio" name="kind" value="off" checked={lateFee.kind === 'off'}> None</label>
          <label><input type="radio" name="kind" value="percent" checked={lateFee.kind === 'percent'}> A percent of what’s still owed</label>
          <label><input type="radio" name="kind" value="flat" checked={lateFee.kind === 'flat'}> A flat amount</label>
        </fieldset>
        <text-field label="How much" name="amount" value={lateFee.amount} inputmode="decimal" description="A percent like 1.5, or dollars like 25."></text-field>
        <text-field label="After this many days late" name="afterDays" value={String(lateFee.afterDays)} inputmode="numeric"></text-field>
        <div><button class="hq-button secondary" type="submit">Save</button></div>
      </form>
    </section>
    <section class="hq-panel" aria-labelledby="money-projects">
      <h2 id="money-projects">By project</h2>
      <empty-state zb-if={view.rows.length === 0} heading="No projects yet">A project starts when a won opportunity is turned into one.</empty-state>
      <table tabindex="0" zb-else class="hq-table">
        <thead><tr><th scope="col">Project</th><th scope="col">Client</th><th scope="col" class="hq-number">Hours</th><th scope="col" class="hq-number">Cost</th><th scope="col" class="hq-number">Margin</th><th scope="col">Payment</th></tr></thead>
        <tbody>
          <zb-each items={view.rows} as="row" key={row.id}>
            <tr>
              <td><a href="/projects/{row.id}/money">{row.name}</a> <status-badge zb-if={row.over} variant="danger">Over budget</status-badge><status-badge zb-if={row.watch}>Watch</status-badge><span zb-if={!row.active} class="hq-muted"> (closed)</span></td>
              <td>{row.clientName}</td>
              <td class="hq-number">{row.hours.actual}<span zb-if={row.hours.budget}> of {row.hours.budget}</span></td>
              <td class="hq-number">{row.cost.actual}<span zb-if={row.cost.budget}> of {row.cost.budget}</span></td>
              <td class="hq-number">{row.margin}<span zb-if={row.marginPercent}> ({row.marginPercent})</span></td>
              <td>{row.paymentLabel}</td>
            </tr>
          </zb-each>
        </tbody>
      </table>
    </section>
    <section zb-if={view.canExport} class="hq-panel" aria-labelledby="money-exports">
      <h2 id="money-exports">Exports</h2>
      <p>Each opens in a spreadsheet. Every export is recorded.</p>
      <ul>
        <li><a href="/exports/time.csv">Time, every entry (CSV)</a></li>
        <li><a href="/exports/expenses.csv">Expenses (CSV)</a></li>
        <li><a href="/exports/projects.csv">Budget against actual, by project (CSV)</a></li>
        <li><a href="/exports/profit.csv">Profit and loss, by month (CSV)</a></li>
        <li><a href="/exports/invoices.csv">Invoices (CSV)</a></li>
        <li><a href="/exports/payments.csv">Payments received (CSV)</a></li>
      </ul>
    </section>
    <section zb-if={pay} class="hq-panel" id="how-to-pay" aria-labelledby="money-how-to-pay">
      <h2 id="money-how-to-pay">How clients pay</h2>
      <p class="hq-muted">What clients read in their portal, receipts and statements, and on invoice reminders. Who checks are made out to, where to mail them, and any other way you take money, such as a bank transfer. Never put an account or card number here. Empty: checks or cash to Potomac Solutions.</p>
      <form zb-if={pay.canEdit} method="post" action="/money/pay-instructions" class="hq-form">
        <div class="hq-field">
          <label for="pay-instructions">How to pay</label>
          <textarea id="pay-instructions" name="instructions" rows="5" maxlength="2000">{pay.text}</textarea>
        </div>
        <div><button class="hq-button secondary" type="submit">Save</button></div>
      </form>
      <p zb-else class="hq-prose">{pay.text || 'Checks or cash to Potomac Solutions.'}</p>
    </section>
  </div>
</hq-money>
