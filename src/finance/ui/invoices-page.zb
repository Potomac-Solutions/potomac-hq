<!--
  Money → Invoices: every invoice, on a project or not, by where it stands.
  Who owes what, what's overdue, and drafts not sent yet, at a glance.
  `invoice.view`.
-->
<script>
  'use route /money/invoices'
  import '../../shared/ui/zubra/status-badge.zb'
  import '../../shared/ui/zubra/breadcrumb-trail.zb'
  import '../../shared/ui/zubra/empty-state.zb'
  export async function load({ context, url }) {
    const stop = context.guard()
    if (stop) return stop
    const view = context.money.invoices(url.searchParams.get('show'))
    if (!view.ok) return context.forbidden()
    return { title: 'Invoices', view: view.value }
  }
</script>
<style>
  .invoice-filters { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin: 0 0 1rem; padding: 0; list-style: none; }
  .invoice-filters a[aria-current] { font-weight: 700; text-decoration: none; }
</style>
<hq-invoices view={{ filter: 'unpaid', filters: [], items: [], totals: {}, byClient: [] }}>
  <div class="hq-page">
    <breadcrumb-trail items={[{ label: 'Money', href: '/money' }, { label: 'Invoices', href: '' }]}></breadcrumb-trail>
    <h1>Invoices</h1>
    <section class="hq-panel" aria-labelledby="invoices-totals">
      <h2 id="invoices-totals">Where it stands</h2>
      <dl class="hq-facts">
        <dt>Owed to us</dt><dd>{view.totals.owed}</dd>
        <dt>Of that, overdue</dt><dd>{view.totals.overdue}</dd>
        <dt>Drafts not sent</dt><dd>{view.totals.drafts}</dd>
      </dl>
    </section>
    <section zb-if={view.byClient.length > 0} class="hq-panel" aria-labelledby="invoices-clients">
      <h2 id="invoices-clients">Who owes what</h2>
      <ul class="hq-list">
        <zb-each items={view.byClient} as="one" key={one.organizationId}>
          <li><a href="/clients/{one.organizationId}#invoices">{one.clientName}</a> · {one.owed} <status-badge zb-if={one.overdue} variant="danger">Overdue</status-badge></li>
        </zb-each>
      </ul>
    </section>
    <section class="hq-panel" aria-labelledby="invoices-list">
      <h2 id="invoices-list">Invoices</h2>
      <nav aria-label="Show invoices">
        <ul class="invoice-filters">
          <zb-each items={view.filters} as="f" key={f.value}>
            <li><a href="/money/invoices?show={f.value}" aria-current={f.current ? 'page' : null}>{f.label} ({f.count})</a></li>
          </zb-each>
        </ul>
      </nav>
      <empty-state zb-if={view.items.length === 0} heading="Nothing here">No invoices are in this list right now.</empty-state>
      <table tabindex="0" zb-else class="hq-table">
        <thead><tr><th scope="col">Invoice</th><th scope="col">Client</th><th scope="col">For</th><th scope="col">Where it stands</th><th scope="col">Due</th><th scope="col" class="hq-number">Total</th><th scope="col" class="hq-number">Owed</th></tr></thead>
        <tbody>
          <zb-each items={view.items} as="inv" key={inv.id}>
            <tr>
              <td><a href="/invoices/{inv.id}">{inv.label}</a></td>
              <td><a href="/clients/{inv.organizationId}#invoices">{inv.clientName}</a></td>
              <td>{inv.forWhat}<span zb-if={!inv.projectName} class="hq-muted"> (no project)</span></td>
              <td>{inv.statusLabel} <status-badge zb-if={inv.overdue} variant="danger">Overdue</status-badge></td>
              <td>{inv.dueOn}</td>
              <td class="hq-number">{inv.total}</td>
              <td class="hq-number">{inv.status === 'sent' ? inv.owed : ''}</td>
            </tr>
          </zb-each>
        </tbody>
      </table>
    </section>
  </div>
</hq-invoices>
