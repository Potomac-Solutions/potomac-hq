<!--
  One invoice: its lines, what has been received against it, and the forms
  that send it, void it and record a payment.
-->
<script>
  'use route /invoices/:id'
  import '../../shared/ui/zubra/select-field.zb'
  import '../../shared/ui/zubra/breadcrumb-trail.zb'
  import '../../shared/ui/zubra/status-badge.zb'
  import { notFound } from '@zubra/router'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/text-field.zb'
  export async function load({ context, params }) {
    const stop = context.guard()
    if (stop) return stop
    const view = context.money.invoice(params.id)
    if (!view.ok) return view.error === 'not-found' ? notFound() : context.forbidden()
    const reminders = context.money.invoiceReminders(params.id)
    return { title: 'Invoice ' + view.value.invoice.label, view: view.value, reminders: reminders.ok ? reminders.value : null, credit: context.referralCredit.forInvoice(params.id), done: context.notice.done, problem: context.notice.problem }
  }
  const i = view.invoice
</script>
<hq-invoice view={{ invoice: {}, project: null, client: {}, lines: [], payments: [], can: {}, methods: [] }} reminders={null} credit={null} done="" problem="">
  <div class="hq-page">
    <breadcrumb-trail items={view.project ? [{ label: 'Projects', href: '/projects' }, { label: view.project.name, href: `/projects/${view.project.id}` }, { label: 'Money', href: `/projects/${view.project.id}/money` }, { label: 'Invoice ' + i.label, href: '' }] : [{ label: 'Clients', href: '/clients' }, { label: view.client.name, href: `/clients/${view.client.id}#invoices` }, { label: 'Invoice ' + i.label, href: '' }]}></breadcrumb-trail>
    <h1>Invoice {i.label}</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>

    <section class="hq-panel" aria-labelledby="invoice-details">
      <h2 id="invoice-details">Where it stands</h2>
      <dl class="hq-facts">
        <dt>Status</dt><dd><strong>{i.statusLabel}</strong> <status-badge zb-if={i.overdue} variant="danger">Overdue</status-badge></dd>
        <dt>Billed to</dt><dd>{view.clientName}</dd>
        <dt>For</dt><dd>{i.kindLabel}</dd>
        <dt>Issued</dt><dd>{i.issuedOn || "Not sent yet"}</dd>
        <dt>Due</dt><dd>{i.dueOn || "Not set"}</dd>
        <dt>Total</dt><dd>{i.total}</dd>
        <dt>Received</dt><dd>{i.paid}</dd>
        <dt>Owed</dt><dd><strong>{i.status === "void" ? "Nothing: void" : i.owed}</strong></dd>
        <dt zb-if={i.note}>Note</dt><dd zb-if={i.note} class="hq-prose">{i.note}</dd>
      </dl>
      <div class="hq-actions" data-spaced>
        <form zb-if={view.can.send} method="post" action="/invoices/{i.id}/send">
          <button class="hq-button" type="submit">Send this invoice</button>
        </form>
        <a zb-if={!i.draft && i.status !== "void"} class="hq-button secondary" href="/invoices/{i.id}/pdf">Download the PDF</a>
        <form zb-if={view.can.void} method="post" action="/invoices/{i.id}/void">
          <button class="hq-button secondary" type="submit">Void this invoice</button>
        </form>
      </div>
      <p zb-if={i.draft} class="hq-muted hq-small" data-spaced>A draft can still change. Sending gives it today’s date and locks it.</p>
    </section>

    <section class="hq-panel" aria-labelledby="invoice-lines">
      <h2 id="invoice-lines">Lines</h2>
      <table tabindex="0" class="hq-table">
        <thead><tr><th scope="col">Description</th><th scope="col" class="hq-number">Amount</th></tr></thead>
        <tbody>
          <zb-each items={view.lines} as="line" key={line.key}><tr><td>{line.description}</td><td class="hq-number">{line.amount}</td></tr></zb-each>
        </tbody>
        <tfoot><tr><th scope="row">Total</th><td class="hq-number"><strong>{i.total}</strong></td></tr></tfoot>
      </table>
      <form zb-if={view.can.addLine} method="post" action="/invoices/{i.id}/lines" class="hq-form-row" data-spaced>
        <text-field label="Another line" name="description" required={true}></text-field>
        <text-field label="Line amount in dollars" name="amount" inputmode="decimal" required={true}></text-field>
        <button class="hq-button secondary" type="submit">Add line</button>
      </form>
      <form zb-if={credit} method="post" action="/invoices/{i.id}/referral-credit" data-spaced>
        <p class="hq-small">This client has {credit.available} of referral credit.</p>
        <button class="hq-button secondary" type="submit">Take {credit.applies} of referral credit off</button>
      </form>
    </section>

    <section zb-if={!i.draft} class="hq-panel" aria-labelledby="invoice-payments">
      <h2 id="invoice-payments">Payments received</h2>
      <p zb-if={view.payments.length === 0} class="hq-muted">None yet.</p>
      <table tabindex="0" zb-else class="hq-table">
        <thead><tr><th scope="col">Day</th><th scope="col">How</th><th scope="col">Reference</th><th scope="col" class="hq-number">Amount</th></tr></thead>
        <tbody>
          <zb-each items={view.payments} as="payment" key={payment.id}><tr><td>{payment.on}</td><td>{payment.methodLabel}</td><td>{payment.reference}</td><td class="hq-number">{payment.amount}</td></tr></zb-each>
        </tbody>
      </table>
      <form zb-if={view.can.pay} method="post" action="/invoices/{i.id}/payments" class="hq-form" data-spaced>
        <h3>Record a payment</h3>
        <text-field label="Amount received, in dollars" name="amount" inputmode="decimal" value={view.owedPlain} required={true}></text-field>
        <select-field label="How it was paid" name="method" options={view.methods} required={true}></select-field>
        <text-field label="Received on" name="on" type="date" value={view.today} required={true}></text-field>
        <text-field label="Reference" name="reference" description="A check number, or the gateway’s reference. Never a card number."></text-field>
        <div><button class="hq-button" type="submit">Record payment</button></div>
      </form>
    </section>

    <section zb-if={reminders && !i.draft && i.status !== 'void'} class="hq-panel" id="reminders" aria-labelledby="invoice-reminders">
      <h2 id="invoice-reminders">Reminders</h2>
      <p zb-if={!reminders.on} class="hq-muted">Reminders are off for every invoice. <a href="/money#reminders">Turn them on</a> on Money.</p>
      <p zb-else-if={reminders.off}>No reminders for this invoice.</p>
      <p zb-else-if={reminders.recipients}>Sent to {reminders.recipients}, when one is due.</p>
      <p zb-else class="hq-muted">This client has no primary contact with an email, and nobody in the portal, so no reminder can go.</p>
      <ul zb-if={reminders.sent.length > 0} class="hq-list">
        <zb-each items={reminders.sent} as="one" key={one.label}><li>{one.label}: {one.when}, to {one.to}</li></zb-each>
      </ul>
      <form zb-if={reminders.on && reminders.canEdit && i.status === 'sent'} method="post" action="/invoices/{i.id}/reminders">
        <input type="hidden" name="off" value={reminders.off ? '0' : '1'}>
        <button class="hq-button secondary" type="submit">{reminders.off ? 'Send reminders for this invoice' : 'No reminders for this invoice'}</button>
      </form>
    </section>
  </div>
</hq-invoice>
