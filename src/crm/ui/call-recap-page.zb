<!--
  The recap email after a call (decision 0009, section 7): drafted from the
  call's notes, to the contact on the call, edited here and sent only when
  "Send recap" is pressed. Logged in the call log as an email. With email
  off, it's there to copy into your own.
-->
<script>
  'use route /phone/:id/recap'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/breadcrumb-trail.zb'
  import '../../shared/ui/zubra/text-field.zb'
  import { notFound } from '@zubra/router'
  export async function load({ context, params }) {
    const stop = context.guard()
    if (stop) return stop
    const recap = context.crm.recap(params.id)
    if (recap === null) return notFound()
    return { title: 'Recap email', recap: recap === 'no-email' ? null : recap, noEmail: recap === 'no-email', emailOn: context.crm.emailOn, done: context.notice.done, problem: context.notice.problem }
  }
</script>
<style>
  .recap { display: grid; gap: 1rem; max-width: 40rem; }
  .recap h1 { margin: 0; }
  .recap-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .recap-actions .hq-button { min-height: 3rem; }
</style>
<hq-call-recap recap={null} no-email={false} email-on={false} done="" problem="">
  <div class="recap">
    <breadcrumb-trail zb-if={recap} items={[{ label: 'Clients', href: '/clients' }, { label: recap.clientName, href: `/clients/${recap.clientId}` }, { label: 'Recap email', href: '' }]}></breadcrumb-trail>
    <h1>Recap email</h1>
    <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
    <p zb-if={noEmail} class="hq-panel">Their contact has no email in HQ, so there’s nobody to send a recap to. Add one on the client’s page for next time.</p>
    <div zb-if={recap && recap.sentText} class="hq-panel">
      <p>Sent to {recap.toName} on {recap.sentText}. It’s in the call log.</p>
      <p><a href={recap.skipTo}>Carry on</a></p>
    </div>
    <form zb-if={recap && !recap.sentText} method="post" action="/phone/{recap.callId}/recap" class="hq-panel hq-form">
      <p>To <strong>{recap.toName}</strong> &lt;{recap.to}&gt;. Read it through and change anything before it goes.</p>
      <p zb-if={!emailOn} class="hq-muted">Email isn’t set up here, so HQ can’t send it. Copy it into your own email instead.</p>
      <text-field label="Subject" name="subject" value={recap.subject} required={true} maxlength={150}></text-field>
      <text-field label="Message" name="body" value={recap.body} rows={14} required={true} maxlength={4000}></text-field>
      <div class="recap-actions">
        <button zb-if={emailOn} class="hq-button" type="submit">Send recap</button>
        <a class="hq-button secondary" href={recap.skipTo}>Skip</a>
      </div>
    </form>
  </div>
</hq-call-recap>
