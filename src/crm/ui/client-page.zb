<!--
  One client: its details and status, its contacts, and its opportunities,
  with the forms that add to each.
-->
<script>
  'use route /clients/:id'
  import '../../shared/ui/parts/history-panel.zb'
  import '../../shared/ui/zubra/select-field.zb'
  import '../../shared/ui/zubra/breadcrumb-trail.zb'
  import '../../shared/ui/zubra/status-badge.zb'
  import { notFound } from '@zubra/router'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/empty-state.zb'
  import '../../shared/ui/zubra/text-field.zb'
  import '../../shared/ui/parts/notes-panel.zb'
  import '../../shared/ui/parts/touches-panel.zb'
  import '../../shared/ui/parts/todos-panel.zb'

  export async function load({ context, params }) {
    const stop = context.guard()
    if (stop) return stop
    const view = context.crm.clientDetail(params.id)
    if (!view.ok) return view.error === 'not-found' ? notFound() : context.forbidden()
    return { title: view.value.client.name, view: view.value, notes: context.notes.list('client-organization', params.id), portal: context.portalAdmin.access(params.id), invites: context.booking.clientInvites(params.id), minDay: context.today, renewals: context.renewals.forClient(params.id), social: context.social.summary(params.id), touches: context.crm.clientTouches(params.id), todos: context.todos.atClient(params.id), sites: context.monitor.forClient(params.id), website: context.websites.forClient(params.id), freePage: context.freePages.forClient(params.id), automations: context.automations.forClient(params.id), showcase: context.showcase.forClient(params.id).ok, referrals: context.referralCredit.forClient(params.id), invoices: context.money.forClient(params.id), history: context.history('client-organization', params.id), mergeChoices: context.crm.mergeChoices(params.id), mergedInto: context.crm.mergedInto(params.id), done: context.notice.done, problem: context.notice.problem }
  }
</script>
<hq-client view={{ client: {}, contacts: [], opportunities: [], can: {}, statuses: [], services: [], leadSources: [] }} notes={{ items: [] }} portal={{ users: [], calls: [] }} renewals={null} social={null} sites={null} website={null} free-page={null} automations={null} showcase={false} referrals={null} invoices={null} touches={null} todos={null} invites={[]} min-day="" history={[]} merge-choices={[]} merged-into={null} done="" problem="">
  <div class="hq-page">
    <breadcrumb-trail items={[{ label: 'Clients', href: '/clients' }, { label: view.client.name, href: '' }]}></breadcrumb-trail>
    <div class="hq-head">
      <div><h1>{view.client.name}</h1></div>
      <div class="hq-head-actions"><status-badge zb-if={view.client.demo} variant="outline">Demo</status-badge><status-badge variant={view.client.status === 'active' ? 'success' : view.client.status === 'prospective' ? 'primary' : 'neutral'}>{view.client.statusLabel}</status-badge></div>
    </div>
    <alert-banner zb-if={mergedInto} variant="info">This client was merged into <a href="/clients/{mergedInto.id}">{mergedInto.name}</a>. Everything it had is there now; this page is kept so old links still work.</alert-banner>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <div class="hq-split facts-first">
    <div class="hq-rail">
    <section class="hq-panel" aria-labelledby="client-details">
      <h2 id="client-details">Details</h2>
      <dl class="hq-facts">
        <dt>Status</dt><dd>{view.client.statusLabel}</dd>
        <dt>Size</dt><dd>{view.client.sizeTierLabel || "Not set"}</dd>
        <dt>Website</dt><dd><a zb-if={view.client.website} href={view.client.website} rel="noopener noreferrer">{view.client.website}</a><span zb-else class="hq-muted">None</span></dd>
        <dt>Phone</dt><dd><a zb-if={view.client.phone} href="tel:{view.client.phone}">{view.client.phone}</a><span zb-else>None</span></dd>
        <dt>Address</dt><dd>{view.client.address || "None"}</dd>
      </dl>
      <form zb-if={view.can.setStatus} method="post" action="/clients/{view.client.id}/status" class="hq-form-row" data-spaced>
        <div class="hq-field">
          <label for="client-status">Change status</label>
          <select id="client-status" name="status">
            <zb-each items={view.statuses} as="status" key={status.value}><option value={status.value} selected={status.value === view.client.status}>{status.label}</option></zb-each>
          </select>
        </div>
        <button class="hq-button secondary" type="submit">Save status</button>
      </form>
      <form zb-if={view.can.setStatus} method="post" action="/clients/{view.client.id}/demo" class="hq-form-row" data-spaced>
        <input type="hidden" name="demo" value={view.client.demo ? '0' : '1'}>
        <p class="hq-muted hq-small">{view.client.demo ? 'A demo: a made-up business, left out of figures and reports.' : 'A made-up business you show prospects? Mark it a demo to keep it out of figures and reports.'}</p>
        <button class="hq-button secondary small" type="submit">{view.client.demo ? 'It’s a real client' : 'Mark as a demo'}</button>
      </form>
    </section>
    <section class="hq-panel" id="contacts" aria-labelledby="client-contacts">
      <h2 id="client-contacts">Contacts</h2>
      <empty-state zb-if={view.contacts.length === 0} heading="No contacts yet">Add the person you talk to.</empty-state>
      <table zb-else class="hq-table hq-stack">
        <thead><tr><th scope="col">Name</th><th scope="col">Title</th><th scope="col">Email</th><th scope="col">Phone</th></tr></thead>
        <tbody>
          <zb-each items={view.contacts} as="contact" key={contact.id}>
            <tr>
              <td>{contact.name} <status-badge zb-if={contact.isPrimary}>Primary</status-badge></td>
              <td>{contact.title}</td>
              <td><a zb-if={contact.email} href="mailto:{contact.email}">{contact.email}</a></td>
              <td><a zb-if={contact.phone} href="tel:{contact.phone}" class="hq-nowrap">{contact.phone}</a> <form zb-if={contact.phone && touches && touches.canLog} method="post" action="/phone" class="hq-inline"><input type="hidden" name="contactId" value={contact.id}><button class="hq-button secondary hq-small" type="submit" aria-label="Start a call with {contact.name}">Start a call</button></form></td>
            </tr>
          </zb-each>
        </tbody>
      </table>
      <form zb-if={view.can.addContact} method="post" action="/clients/{view.client.id}/contacts" class="hq-form" data-spaced>
        <h3>Add a contact</h3>
        <text-field label="Name" name="name" required={true} autocomplete="name"></text-field>
        <text-field label="Email" name="email" type="email" autocomplete="email" description="An email address or a phone number is needed."></text-field>
        <text-field label="Phone" name="phone" type="tel" autocomplete="tel"></text-field>
        <text-field label="Title" name="title" description="Optional, like Owner"></text-field>
        <label class="hq-check"><input type="checkbox" name="isPrimary"> Primary contact</label>
        <div><button class="hq-button" type="submit">Add contact</button></div>
      </form>
    </section>
    <section zb-if={sites} class="hq-panel" id="sites" aria-labelledby="client-sites">
      <h2 id="client-sites">Sites</h2>
      <p zb-if={sites.sites.length === 0} class="hq-muted">Add this client’s website and HQ checks it every five minutes, and emails when it’s down or its certificate runs low.</p>
      <ul zb-else class="hq-list">
        <zb-each items={sites.sites} as="site" key={site.id}>
          <li>
            <p><strong><a href={site.url} rel="noreferrer">{site.host}</a></strong> <status-badge variant={site.state === 'down' ? 'danger' : 'neutral'}>{site.stateLabel}</status-badge> <span zb-if={site.since}>{site.since}</span></p>
            <p class="hq-small">{site.lastResult} · {site.uptime} up in 30 days<span zb-if={site.cert}> · {site.cert}</span></p>
            <form zb-if={sites.canEdit} method="post" action="/sites/{site.id}/stop"><button class="hq-button secondary" type="submit">Stop watching<span class="sr-only">: {site.host}</span></button></form>
          </li>
        </zb-each>
      </ul>
      <form zb-if={sites.canEdit} method="post" action="/clients/{view.client.id}/sites" class="hq-form-row" data-spaced>
        <div class="hq-field"><label for="site-url">Website address</label><input id="site-url" name="url" placeholder="feedstore.com" required></div>
        <button class="hq-button secondary" type="submit">Watch this site</button>
      </form>
    </section>
    <section zb-if={automations && (automations.items.length > 0 || automations.canManage)} class="hq-panel" id="automations" aria-labelledby="client-automations">
      <h2 id="client-automations">Automations</h2>
      <p zb-if={automations.items.length === 0} class="hq-muted">n8n workflows run for this client. Each one checks in at the end of a run, so you hear when one stops.</p>
      <ul zb-else class="hq-activity">
        <zb-each items={automations.items} as="one" key={one.id}>
          <li>
            <span>
              <strong>{one.name}</strong> <status-badge variant={one.attention ? 'danger' : one.state === 'ok' ? 'success' : 'neutral'}>{one.stateLabel}</status-badge><br>
              <span class="hq-scope">{one.every}<span zb-if={one.lastRun}> · last ran {one.lastRun}</span><span zb-if={one.lastMessage}> · {one.lastMessage}</span></span>
              <span zb-if={one.description} class="hq-small hq-muted"><br>{one.description}</span>
              <span zb-if={one.n8nUrl}><br><a class="hq-small" href={one.n8nUrl} rel="noopener noreferrer">Open in n8n<span class="sr-only">: {one.name}</span></a></span>
            </span>
            <details zb-if={automations.canManage} class="hq-more">
              <summary>Change<span class="sr-only">: {one.name}</span></summary>
              <form method="post" action="/automations/{one.id}" class="hq-form">
                <text-field label="Name" name="name" value={one.name} required={true} maxlength={80}></text-field>
                <text-field label="What it does" name="description" value={one.description} maxlength={500}></text-field>
                <text-field label="Link to it in n8n" name="n8nUrl" value={one.n8nUrl} type="url"></text-field>
                <div class="hq-field">
                  <label for="every-{one.id}">How often it runs</label>
                  <select id="every-{one.id}" name="every"><zb-each items={automations.schedules} as="s" key={s.value}><option value={s.value} selected={Number(s.value) === one.everyMinutes}>{s.label}</option></zb-each></select>
                </div>
                <label class="hq-check"><input type="checkbox" name="active" value="1" checked={one.active}> On (off pauses alerts)</label>
                <div><button class="hq-button" type="submit">Save<span class="sr-only">: {one.name}</span></button></div>
              </form>
              <div class="hq-actions" data-spaced>
                <form method="post" action="/automations/{one.id}/secret"><button class="hq-button secondary small" type="submit">New check-in address<span class="sr-only">: {one.name}</span></button></form>
                <form method="post" action="/automations/{one.id}/remove"><button class="hq-button secondary small" type="submit">Remove<span class="sr-only">: {one.name}</span></button></form>
              </div>
            </details>
          </li>
        </zb-each>
      </ul>
      <details zb-if={automations.canManage} class="hq-more" data-spaced>
        <summary>Add an automation</summary>
        <form method="post" action="/clients/{view.client.id}/automations" class="hq-form">
          <text-field label="Name" name="name" required={true} maxlength={80} description="Like: Orders to the sheet"></text-field>
          <text-field label="What it does" name="description" maxlength={500} description="The client sees this in their portal."></text-field>
          <text-field label="Link to it in n8n" name="n8nUrl" type="url" description="For you only. Optional."></text-field>
          <div class="hq-field">
            <label for="every-new">How often it runs</label>
            <select id="every-new" name="every"><zb-each items={automations.schedules} as="s" key={s.value}><option value={s.value} selected={s.value === '1440'}>{s.label}</option></zb-each></select>
          </div>
          <div><button class="hq-button" type="submit">Add and get its address</button></div>
        </form>
      </details>
    </section>
    <section zb-if={referrals} class="hq-panel" id="referrals" aria-labelledby="client-referrals">
      <h2 id="client-referrals">Referrals</h2>
      <p zb-if={referrals.link}>Their own link: <span class="hq-nowrap">{referrals.link.address}</span></p>
      <form zb-if={referrals.canMakeLink} method="post" action="/clients/{view.client.id}/referral-link"><button class="hq-button secondary" type="submit">Make them their own referral link</button></form>
      <p zb-if={referrals.referred.length === 0} class="hq-muted">Nobody they referred yet. Each new client they send who pays an invoice earns them {referrals.creditEach} of credit.</p>
      <ul zb-else>
        <zb-each items={referrals.referred} as="one" key={one.opportunityId}><li><a href="/opportunities/{one.opportunityId}">{one.clientName}: {one.title}</a>, {one.when}<span zb-if={one.credited}> · credit earned</span></li></zb-each>
      </ul>
      <p zb-if={referrals.earned !== '$0.00'}>Credit earned {referrals.earned}, used {referrals.used}, <strong>{referrals.available} left</strong>. Take it off one of their draft invoices.</p>
    </section>
    <section zb-if={showcase} class="hq-panel" id="showcase" aria-labelledby="client-showcase">
      <h2 id="client-showcase">Reviews and case study</h2>
      <p class="hq-muted">Ask them for a review, and write the story of what we built for the Work page.</p>
      <p><a href="/clients/{view.client.id}/showcase">Open reviews and case study</a></p>
    </section>
    <section zb-if={freePage} class="hq-panel" id="landing-page" aria-labelledby="client-landing-page">
      <h2 id="client-landing-page">Free landing page</h2>
      <p zb-if={freePage.exists}><strong>{freePage.statusLabel}</strong><span zb-if={freePage.address}> · {freePage.address}</span><br><span class="hq-small hq-muted">{freePage.used}</span></p>
      <p zb-else class="hq-muted">None yet. Every client may have one, free.</p>
      <p><a href="/clients/{view.client.id}/landing-page">{freePage.exists ? 'Open the landing page' : (freePage.canManage ? 'Record one' : 'Open')}</a></p>
    </section>
    <section zb-if={website} class="hq-panel" id="website" aria-labelledby="client-website">
      <h2 id="client-website">Website editing</h2>
      <div zb-if={website.site}>
        <p><strong><a zb-if={website.canOpen} href="/websites/{website.site.id}">{website.site.name}</a><span zb-else>{website.site.name}</span></strong> <status-badge variant={website.site.state === 'submitted' ? 'warning' : 'neutral'}>{website.site.stateLabel}</status-badge></p>
        <p class="hq-small hq-muted">{website.site.detail} · {website.site.repo}</p>
        <p class="hq-small hq-muted">Anyone with portal access here can change the site’s photos, notice and reviews. Nothing goes on the site until it is published in HQ.</p>
      </div>
      <p zb-else class="hq-muted">Let this client change their own site’s photos, notice and reviews in their portal. You check each change before it goes on the site.</p>
      <details zb-if={website.canSetUp} class="hq-more">
        <summary>Set up website editing</summary>
        <p zb-if={!website.githubSetUp} class="hq-muted">HQ has no GitHub token yet. Set HQ_GITHUB_TOKEN on the server first.</p>
        <form method="post" action="/clients/{view.client.id}/website" class="hq-form">
          <text-field label="What to call it" name="name" required={true} maxlength={80} description="The client sees this. Like: Nu Finish website"></text-field>
          <text-field label="Repository" name="repo" required={true} description="On GitHub, as owner/name. Like: Potomac-Solutions/example-site"></text-field>
          <text-field label="Branch" name="branch" value={website.defaults.branch} required={true} description="The branch the live site builds from."></text-field>
          <text-field label="Content file" name="contentPath" value={website.defaults.contentPath} required={true}></text-field>
          <text-field label="Photo folder" name="photoDir" value={website.defaults.photoDir} required={true}></text-field>
          <text-field label="The site’s own address" name="siteUrl" description="Like nufinishcollision.com. For the preview link. Leave empty if it has none yet."></text-field>
          <div><button class="hq-button" type="submit">Set up and read the site</button></div>
        </form>
      </details>
    </section>
    <notes-panel notes={notes}></notes-panel>
    </div>
    <div>
    <touches-panel zb-if={touches} touches={touches} action="/clients/{view.client.id}/touches" follow-up={false} call-field="clientId" call-id={view.client.id}></touches-panel>
    <todos-panel zb-if={todos} todos={todos} where="client" id={view.client.id}></todos-panel>
    <section zb-if={view.can.viewOpportunities} class="hq-panel" aria-labelledby="client-opportunities">
      <h2 id="client-opportunities">Opportunities</h2>
      <empty-state zb-if={view.opportunities.length === 0} heading="No opportunities yet">Open one when they ask about work.</empty-state>
      <table tabindex="0" zb-else class="hq-table">
        <thead><tr><th scope="col">Title</th><th scope="col">Service</th><th scope="col">Stage</th><th scope="col">Follow-up</th><th scope="col">Price</th></tr></thead>
        <tbody>
          <zb-each items={view.opportunities} as="opportunity" key={opportunity.id}>
            <tr>
              <td><a href="/opportunities/{opportunity.id}">{opportunity.title}</a></td>
              <td>{opportunity.serviceLabel}</td>
              <td>{opportunity.stageLabel}</td>
              <td>{opportunity.followUpOn}</td>
              <td>{opportunity.price}</td>
            </tr>
          </zb-each>
        </tbody>
      </table>
      <form zb-if={view.can.createOpportunity} method="post" action="/clients/{view.client.id}/opportunities" class="hq-form" data-spaced>
        <h3>Open an opportunity</h3>
        <text-field label="Title" name="title" required={true} description="Like: Bakery website"></text-field>
        <div class="hq-field">
          <label for="opportunity-service">Service</label>
          <select id="opportunity-service" name="service">
            <option value="">Not chosen yet</option>
            <zb-each items={view.services} as="service" key={service.value}><option value={service.value}>{service.label}</option></zb-each>
          </select>
        </div>
        <select-field label="How they found you" name="leadSource" options={view.leadSources} required={true}></select-field>
        <div zb-if={view.contacts.length > 0} class="hq-field">
          <label for="opportunity-contact">Contact</label>
          <select id="opportunity-contact" name="contactId">
            <option value="">None</option>
            <zb-each items={view.contacts} as="contact" key={contact.id}><option value={contact.id}>{contact.name}</option></zb-each>
          </select>
        </div>
        <text-field label="Notes" name="summary" rows={3} description="Optional. What they need, from the first call."></text-field>
        <div><button class="hq-button" type="submit">Open opportunity</button></div>
      </form>
    </section>
    <section zb-if={portal.canView} class="hq-panel" id="portal" aria-labelledby="client-portal">
      <h2 id="client-portal">Client portal</h2>
      <p zb-if={portal.users.length === 0} class="hq-muted">Nobody at this client has been invited yet.</p>
      <table tabindex="0" zb-else class="hq-table">
        <thead><tr><th scope="col">Person</th><th scope="col">Email</th><th scope="col">Access</th><th scope="col"><span class="sr-only">Change</span></th></tr></thead>
        <tbody>
          <zb-each items={portal.users} as="person" key={person.id}>
            <tr>
              <td>{person.name}</td>
              <td>{person.email}</td>
              <td>{person.statusLabel}</td>
              <td>
                <form zb-if={portal.canManage && person.status !== "disabled"} method="post" action="/portal-users/{person.id}/link" class="hq-inline">
                  <input type="hidden" name="organizationId" value={view.client.id}>
                  <button class="hq-button secondary small" type="submit" aria-label="Send a new link to {person.name}">New link</button>
                </form>
                <form zb-if={portal.canManage} method="post" action="/portal-users/{person.id}/access" class="hq-inline">
                  <input type="hidden" name="organizationId" value={view.client.id}>
                  <input type="hidden" name="on" value={person.status === "disabled" ? "1" : "0"}>
                  <button class="hq-button secondary small" type="submit" aria-label="{person.status === 'disabled' ? 'Turn access on' : 'Turn access off'} for {person.name}">{person.status === "disabled" ? "Turn access on" : "Turn access off"}</button>
                </form>
              </td>
            </tr>
          </zb-each>
        </tbody>
      </table>
      <div zb-if={invites.length > 0} data-spaced>
        <h3>Picking times for a call</h3>
        <ul class="hq-links">
          <zb-each items={invites} as="invite" key={invite.id}>
            <li><span><a href="/calls/invites/{invite.id}">{invite.title}</a> · {invite.who} · {invite.days}</span> <status-badge variant={invite.status === 'open' ? 'danger' : 'neutral'}>{invite.statusLabel}</status-badge></li>
          </zb-each>
        </ul>
      </div>
      <details zb-if={portal.canManage && portal.users.some((person) => person.status !== 'disabled')} class="hq-more">
        <summary>Ask someone to pick times for a call</summary>
        <form method="post" action="/invites" class="hq-form">
          <input type="hidden" name="organizationId" value={view.client.id}>
          <p class="hq-muted">They mark every time they could do on a grid of your free time, in their portal. You confirm one and it’s booked.</p>
          <div class="hq-field">
            <label for="invite-who">Who</label>
            <select id="invite-who" name="clientUserId">
              <zb-each items={portal.users.filter((person) => person.status !== 'disabled')} as="person" key={person.id}><option value={person.id}>{person.name}{person.status === 'invited' ? ' (hasn’t signed in yet)' : ''}</option></zb-each>
            </select>
          </div>
          <div class="hq-field"><label for="invite-title">What the call is for</label><input id="invite-title" name="title" maxlength="80" required placeholder="Kickoff call"></div>
          <div class="hq-form-row">
            <div class="hq-field"><label for="invite-minutes">How long</label><select id="invite-minutes" name="minutes"><option value="30">30 minutes</option><option value="45">45 minutes</option><option value="60">1 hour</option><option value="90">1½ hours</option><option value="15">15 minutes</option></select></div>
            <div class="hq-field"><label for="invite-first">From</label><input id="invite-first" name="firstDay" type="date" min={minDay} required></div>
            <div class="hq-field"><label for="invite-last">To</label><input id="invite-last" name="lastDay" type="date" min={minDay} required></div>
          </div>
          <div class="hq-field"><label for="invite-note">A note for them (optional)</label><textarea id="invite-note" name="note" rows="2" maxlength="500"></textarea></div>
          <div><button class="hq-button" type="submit">Send the invite</button></div>
        </form>
      </details>
      <details zb-if={portal.canManage} class="hq-more">
        <summary>Invite someone to the portal</summary>
        <form method="post" action="/clients/{view.client.id}/portal-users" class="hq-form">
          <text-field label="Their name" name="name" required={true} autocomplete="off"></text-field>
          <text-field label="Their email" name="email" type="email" required={true} autocomplete="off" description="They get a one-time link to choose a password. They will see only this client’s projects."></text-field>
          <div><button class="hq-button" type="submit">Invite to the portal</button></div>
        </form>
      </details>
      <div zb-if={portal.calls.length > 0} data-spaced>
        <h3>Calls they asked for</h3>
        <ul class="hq-notes">
          <zb-each items={portal.calls} as="call" key={call.id}>
            <li>
              <p><strong>{call.who}</strong> asked for a call: {call.wanted}<span zb-if={call.note}>. “{call.note}”</span><span zb-if={call.phone}> Call <a href="tel:{call.phone}">{call.phone}</a>.</span> <span class="hq-muted hq-small">{call.when}</span></p>
              <p zb-if={call.status === "confirmed"}>Confirmed for {call.confirmedFor}<span zb-if={call.reply}>. “{call.reply}”</span></p>
              <p zb-if={call.status === "declined"}>Declined<span zb-if={call.reply}>. “{call.reply}”</span></p>
              <form zb-if={call.status === "requested" && portal.canRespond} method="post" action="/call-requests/{call.id}/answer" class="hq-form">
                <input type="hidden" name="organizationId" value={view.client.id}>
                <div class="hq-field">
                  <label for="call-answer-{call.id}">Answer {call.who}</label>
                  <select id="call-answer-{call.id}" name="answer"><option value="confirmed">Confirm a time</option><option value="declined">Decline</option></select>
                </div>
                <div class="hq-field">
                  <label for="call-when-{call.id}">Day and time, if confirming</label>
                  <input id="call-when-{call.id}" name="confirmedFor" maxlength="100">
                </div>
                <div class="hq-field">
                  <label for="call-reply-{call.id}">Reply to {call.who}</label>
                  <input id="call-reply-{call.id}" name="reply" maxlength="1000">
                </div>
                <div><button class="hq-button secondary" type="submit" aria-label="Send answer to {call.who}">Send answer</button></div>
              </form>
            </li>
          </zb-each>
        </ul>
      </div>
    </section>
    <section zb-if={social} class="hq-panel" id="social" aria-labelledby="client-social">
      <h2 id="client-social">Social media</h2>
      <p zb-if={social.plan}>{social.plan}<span zb-if={social.paused}> · paused</span>. This month: {social.count}.</p>
      <p zb-else class="hq-muted">No plan. For a client on social media marketing: their networks, and how many posts each month.</p>
      <p><a class="hq-button secondary" href="/clients/{view.client.id}/social">{social.plan ? 'Open the calendar' : social.canEdit ? 'Set up a plan' : 'Open'}</a></p>
    </section>
    <section zb-if={invoices && invoices.ok} class="hq-panel" id="invoices" aria-labelledby="client-invoices">
      <h2 id="client-invoices">Invoices</h2>
      <p zb-if={invoices.value.items.length === 0} class="hq-muted">None yet. Project invoices show here too.</p>
      <ul zb-else class="hq-list">
        <zb-each items={invoices.value.items} as="inv" key={inv.id}>
          <li><a href="/invoices/{inv.id}">{inv.label}</a> · {inv.projectName || 'No project'} · {inv.total} · {inv.statusLabel} <status-badge zb-if={inv.overdue} variant="danger">Overdue</status-badge></li>
        </zb-each>
      </ul>
      <details zb-if={invoices.value.canCreate}>
        <summary>Bill a one-off charge, with no project</summary>
        <p class="hq-small hq-muted">For a domain, a small fix or anything that isn’t a project. It starts as a draft: check it, then send it. A domain that renews belongs under Renewals, which bills it a week ahead.</p>
        <form method="post" action="/clients/{view.client.id}/invoices" class="hq-form">
          <div class="hq-field">
            <label for="client-invoice-kind">What it is</label>
            <select id="client-invoice-kind" name="kind">
              <zb-each items={invoices.value.kinds} as="kind" key={kind.value}><option value={kind.value} selected={kind.value === 'other'}>{kind.label}</option></zb-each>
            </select>
          </div>
          <text-field label="Description" name="description" required={true} maxlength={300} placeholder="Domain name betterdaystowing.com, one year"></text-field>
          <text-field label="Amount, in dollars" name="amount" required={true} inputmode="decimal" placeholder="25.00"></text-field>
          <text-field label="Due on (optional)" name="dueOn" type="date"></text-field>
          <div><button class="hq-button" type="submit">Draft the invoice</button></div>
        </form>
      </details>
    </section>
    <section zb-if={renewals} class="hq-panel" id="renewals" aria-labelledby="client-renewals">
      <h2 id="client-renewals">Renewals</h2>
      <p zb-if={renewals.items.length === 0} class="hq-muted">Domains, hosting, certificates and licenses this client depends on. Each shows on the dashboard 30 days before it renews.</p>
      <ul zb-else class="hq-list">
        <zb-each items={renewals.items} as="one" key={one.id}>
          <li id="renewal-{one.id}">
            <p><strong>{one.name}</strong> · {one.kindLabel}<span zb-if={one.provider}> at {one.provider}</span> <status-badge zb-if={one.state === 'overdue'} variant="danger">Overdue</status-badge></p>
            <p class="hq-small"><time datetime={one.renewsOn}>{one.when}</time> · {one.termLabel}<span zb-if={one.autoRenews}> · renews by itself</span><span zb-if={one.cost || one.price}> · costs {one.cost || 'not set'}, billed {one.price || 'not billed'}</span></p>
            <p zb-if={one.note} class="hq-small">{one.note}</p>
            <p zb-if={one.answerText} class="hq-small"><status-badge variant={one.answer === 'lapse' ? 'warning' : 'success'}>{one.answer === 'lapse' ? 'Let it lapse' : 'Renew it'}</status-badge> {one.answerText}</p>
            <p zb-if={one.billing} class="hq-small"><status-badge zb-if={one.billState === 'late'} variant="danger">Not paid</status-badge><status-badge zb-if={one.billState === 'paid'} variant="success">Paid</status-badge> {one.billing} <a zb-if={one.invoiceId} href="/invoices/{one.invoiceId}">See the invoice</a></p>
            <form zb-if={one.canBill} method="post" action="/renewals/{one.id}/bill" class="hq-form-row">
              <input type="hidden" name="back" value="client"><input type="hidden" name="clientId" value={view.client.id}>
              <div class="hq-field">
                <label for="bill-project-{one.id}">Invoice it on</label>
                <select id="bill-project-{one.id}" name="projectId">
                  <option value="" selected>The client, no project</option>
                  <zb-each items={renewals.projects} as="project" key={project.value}><option value={project.value}>{project.label}</option></zb-each>
                </select>
              </div>
              <button class="hq-button" type="submit">Bill the client {one.price}<span class="sr-only"> for {one.name}</span></button>
            </form>
            <div zb-if={renewals.canEdit} class="hq-form-row">
              <form method="post" action="/renewals/{one.id}/renewed"><input type="hidden" name="back" value="client"><input type="hidden" name="clientId" value={view.client.id}><button class="hq-button secondary" type="submit">Renewed<span class="sr-only">: {one.name}</span></button></form>
              <form method="post" action="/renewals/{one.id}/retire"><input type="hidden" name="back" value="client"><input type="hidden" name="clientId" value={view.client.id}><button class="hq-button secondary" type="submit">No longer ours to renew<span class="sr-only">: {one.name}</span></button></form>
            </div>
          </li>
        </zb-each>
      </ul>
      <details zb-if={renewals.canEdit} class="hq-more">
        <summary>Add a renewal</summary>
        <form method="post" action="/clients/{view.client.id}/renewals" class="hq-form">
          <select-field label="What it is" name="kind" options={renewals.kinds} required={true}></select-field>
          <text-field label="What it’s called" name="name" required={true} description="Like feedstore.com, or Shared hosting"></text-field>
          <text-field label="Bought from" name="provider" description="Like Cloudflare or Namecheap"></text-field>
          <text-field label="Renews on" name="renewsOn" type="date" required={true}></text-field>
          <div class="hq-field">
            <label for="renewal-term">How often</label>
            <select id="renewal-term" name="termMonths" required>
              <zb-each items={renewals.terms} as="term" key={term.value}><option value={term.value} selected={term.value === '12'}>{term.label}</option></zb-each>
            </select>
          </div>
          <text-field label="What it costs us, in dollars" name="cost" inputmode="decimal"></text-field>
          <text-field label="What we bill, in dollars" name="price" inputmode="decimal"></text-field>
          <label class="hq-check"><input type="checkbox" name="autoRenews" value="1"> The provider renews it by itself</label>
          <text-field label="Note" name="note" rows={2}></text-field>
          <div><button class="hq-button" type="submit">Add renewal</button></div>
        </form>
      </details>
    </section>
    </div>
    </div>
    <details zb-if={mergeChoices.length > 0 && !mergedInto} class="hq-panel" id="merge">
      <summary>Is this a duplicate? <span class="hq-muted hq-small">{mergeChoices.some((one) => one.same) ? 'Another client looks the same' : 'Merge it into another client'}</span></summary>
      <form method="post" action="/clients/{view.client.id}/merge" class="hq-form" data-spaced>
        <p class="hq-small">Everything of <strong>{view.client.name}</strong> (contacts, deals, projects, invoices, notes and the rest) moves to the client you choose. This one stays as a former client named “(merged)”, with a link to the other, so old links still work.</p>
        <div class="hq-field">
          <label for="merge-into">Merge it into</label>
          <select id="merge-into" name="into" required>
            <option value="">Choose a client…</option>
            <zb-each items={mergeChoices} as="one" key={one.id}><option value={one.id}>{one.name}{one.same ? ' (looks the same)' : ''}</option></zb-each>
          </select>
        </div>
        <p class="hq-muted hq-small">A merge can’t be undone, so HQ asks once more before it does it.</p>
        <div><button class="hq-button secondary" type="submit">Merge them</button></div>
      </form>
    </details>
    <history-panel items={history}></history-panel>
  </div>
</hq-client>
