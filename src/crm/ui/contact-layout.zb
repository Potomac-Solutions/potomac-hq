<!--
  The frame around the public inquiry form: Potomac's name and how to reach
  a person, and nothing of HQ.
-->
<script>
  'use layout /contact root'
  export async function load({ context }) {
    return { title: 'Contact Potomac Solutions', contact: context.portal.contact }
  }
</script>
<style>
  :host { display: block; min-height: 100vh; overflow-wrap: anywhere; }
  .contact-bar { display: flex; align-items: center; padding: 0.7rem 1rem; border-bottom: 1px solid var(--border); background: var(--background); }
  .contact-brand { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 800; color: var(--foreground); text-decoration: none; }
  .contact-brand img { width: 1.75rem; height: 1.75rem; }
  .contact-main { max-width: 46rem; margin: 0 auto; padding: 1.25rem 1rem 2rem; }
  .contact-main:focus { outline: none; }
  .contact-foot { max-width: 46rem; margin: 0 auto; padding: 0 1rem 3rem; color: var(--muted-foreground); font-size: 0.95rem; }
  .contact-foot p { margin: 0.25rem 0; }
  .contact-foot a { font-weight: 600; }
</style>
<hq-contact-frame contact={{}}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="contact-bar">
    <a class="contact-brand" href="/contact"><img src="/assets/potomac-mark.webp" alt="" width="28" height="28"> Potomac Solutions</a>
  </header>
  <main id="main" class="contact-main" tabindex="-1">
    <zb-slot></zb-slot>
  </main>
  <footer zb-if={contact.phone || contact.email} class="contact-foot">
    <p><strong>Rather talk now?</strong></p>
    <p zb-if={contact.phone}>Call Potomac Solutions at <a href="tel:{contact.phone}">{contact.phone}</a>.</p>
    <p zb-if={contact.email}>Or write to <a href="mailto:{contact.email}">{contact.email}</a>.</p>
  </footer>
</hq-contact-frame>
