<!--
  The call guides (decision 0009, section 2): the questions the call screen
  works through, one guide for each kind of call. Anyone with
  knowledge.view reads them; knowledge.edit changes them. A change applies
  to calls from then on; calls already made keep what they were asked.
-->
<script>
  'use route /call-guides'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/text-field.zb'
  export async function load({ context }) {
    const stop = context.guard()
    if (stop) return stop
    const view = context.crm.callGuides()
    if (!view) return context.forbidden()
    return { title: 'Call guides', view, done: context.notice.done, problem: context.notice.problem }
  }
</script>
<style>
  .guides { display: grid; gap: 1rem; max-width: 46rem; }
  .guide-list { margin: 0.5rem 0 0; padding-left: 1.4rem; display: grid; gap: 0.3rem; }
</style>
<hq-call-guides view={null} done="" problem="">
  <div class="guides">
    <h1>Call guides</h1>
    <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
    <p>Each call starts with the guide that fits the client, and can switch to another during the call. Tick off each question as it’s asked; the answers go in the call log.</p>
    <zb-each items={view.guides} as="guide" key={guide.situation}>
      <section class="hq-panel" id="guide-{guide.situation}" aria-labelledby="guide-{guide.situation}-heading">
        <h2 id="guide-{guide.situation}-heading">{guide.title}</h2>
        <p class="hq-muted hq-small">Used for: {guide.hint}. {guide.updated}.</p>
        <ol zb-if={!view.canEdit} class="guide-list">
          <zb-each items={guide.questions.split('\n')} as="question" key={question}><li>{question}</li></zb-each>
        </ol>
        <form zb-if={view.canEdit} method="post" action="/call-guides" class="hq-form">
          <input type="hidden" name="situation" value={guide.situation}>
          <text-field label="Name" name="title" value={guide.title} required={true} maxlength={80}></text-field>
          <text-field label="Questions" name="questions" value={guide.questions} rows={Math.max(4, guide.count + 1)} required={true} description="One a line, in the order to ask them. Up to 20."></text-field>
          <div><button class="hq-button" type="submit">Save {guide.title}</button></div>
        </form>
      </section>
    </zb-each>
  </div>
</hq-call-guides>
