<!--
  One opportunity: where it stands, and the actions that move it on. The
  price is shown only to people who may see it; for anyone else it is not in
  the page at all.
-->
<script>
  'use route /opportunities/:id'
  import '../../shared/ui/parts/history-panel.zb'
  import '../../shared/ui/zubra/breadcrumb-trail.zb'
  import '../../shared/ui/zubra/status-badge.zb'
  import { notFound } from '@zubra/router'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/text-field.zb'
  import '../../shared/ui/parts/notes-panel.zb'
  import '../../shared/ui/parts/touches-panel.zb'
  import '../../shared/ui/parts/todos-panel.zb'
  import '../../shared/ui/parts/ai-deal-panel.zb'

  export async function load({ context, params }) {
    const stop = context.guard()
    if (stop) return stop
    const view = context.crm.opportunityDetail(params.id)
    if (!view.ok) return view.error === 'not-found' ? notFound() : context.forbidden()
    return { title: view.value.opportunity.title, view: view.value, notes: context.notes.list('opportunity', params.id), touches: context.crm.opportunityTouches(params.id), todos: context.todos.onOpportunity(params.id), proposals: context.proposals.forOpportunity(params.id), ai: context.ai.deal(params.id), aiModels: context.ai.models(), aiStates: { triage: context.ai.state('lead-triage'), checkIn: context.ai.state('check-in'), proposal: context.ai.state('proposal-draft') }, emailOn: context.crm.emailOn, origin: context.leads.origin(params.id), referred: context.referralCredit.referredBy(params.id), demos: context.demos.forOpportunity(params.id), history: context.history('opportunity', params.id), done: context.notice.done, problem: context.notice.problem }
  }

  const o = view.opportunity
  const canMove = view.can.setStage && o.open
  // Moving back, or reopening won or lost (decision 0014).
  const canMoveBack = view.can.setStage && view.backStages.length > 0
</script>
<hq-opportunity ai-models={[]} view={{ opportunity: {}, client: {}, can: {}, pricings: [], project: null }} notes={{ items: [] }} proposals={{ items: [], templates: [] }} touches={null} todos={null} ai={{ triage: null, checkIn: null, proposal: null }} ai-states={{ triage: { on: false, why: '' }, checkIn: { on: false, why: '' }, proposal: { on: false, why: '' } }} email-on={false} origin={null} referred={null} demos={null} history={[]} done="" problem="">
  <div class="hq-page">
    <breadcrumb-trail items={[{ label: 'Clients', href: '/clients' }, { label: view.client.name, href: `/clients/${view.client.id}` }, { label: o.title, href: '' }]}></breadcrumb-trail>
    <div class="hq-head">
      <div><h1>{o.title}</h1><p><a href="/clients/{view.client.id}">{view.client.name}</a></p></div>
      <div class="hq-head-actions"><status-badge variant={o.won ? 'success' : o.open ? 'primary' : 'neutral'}>{o.stageLabel}</status-badge><status-badge zb-if={o.followUpDue} variant="danger">Follow-up due</status-badge></div>
    </div>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <div class="hq-split facts-first">
    <div class="hq-rail">
    <section class="hq-panel" aria-labelledby="opportunity-details">
      <h2 id="opportunity-details">Where it stands</h2>
      <dl class="hq-facts">
        <dt>Stage</dt><dd><strong>{o.stageLabel}</strong></dd>
        <dt>Service</dt><dd>{o.serviceLabel}</dd>
        <dt zb-if={view.can.viewValue}>Price</dt><dd zb-if={view.can.viewValue}>{o.price || "Not set"}</dd>
        <dt>Follow-up</dt><dd><time zb-if={o.followUpOn} datetime={o.followUpOn}>{o.followUpText}</time><span zb-else>None</span> <status-badge zb-if={o.followUpDue} variant="danger">Due</status-badge></dd>
        <dt>Found you by</dt><dd>{o.leadSourceLabel}</dd>
        <dt zb-if={referred && referred.text}>Referred by</dt><dd zb-if={referred && referred.text}><a zb-if={referred.organizationId} href="/clients/{referred.organizationId}">{referred.text}</a><span zb-else>{referred.text}</span></dd>
        <dt zb-if={origin}>On the website</dt><dd zb-if={origin}>{origin.label}<span zb-if={origin.page} class="hq-muted"> · {origin.page}</span><span zb-if={origin.campaign} class="hq-muted"><br>Campaign: {origin.campaign}</span></dd>
        <dt>Contact</dt><dd>{view.contactName || "None"}<span zb-if={view.contactIsPrimary} class="hq-muted"> (primary at the client)</span><span zb-if={view.contactPhone}> · <a href="tel:{view.contactPhone}" class="hq-nowrap">{view.contactPhone}</a></span><span zb-if={view.contactEmail}> · <a href="mailto:{view.contactEmail}">{view.contactEmail}</a></span></dd>
        <dt>Owner</dt><dd>{view.ownerName}</dd>
        <dt zb-if={o.lostReason}>Why it was lost</dt><dd zb-if={o.lostReason}>{o.lostReason}</dd>
        <dt zb-if={o.summary}>Notes</dt><dd zb-if={o.summary}>{o.summary}</dd>
      </dl>
    </section>
    <section zb-if={demos && (demos.sent.length > 0 || (demos.canSend && demos.choices.length > 0))} class="hq-panel" id="demos" aria-labelledby="opportunity-demos">
      <h2 id="opportunity-demos">Demos</h2>
      <ul zb-if={demos.sent.length > 0}>
        <zb-each items={demos.sent} as="one" key={one.id}><li><strong>{one.name}</strong>, sent {one.sent}: {one.opens === 0 ? 'not opened yet' : (one.opens === 1 ? 'opened once' : 'opened ' + one.opens + ' times') + ', last ' + one.lastOpened}</li></zb-each>
      </ul>
      <details zb-if={demos.canSend && demos.choices.length > 0} class="hq-more">
        <summary>Send demos</summary>
        <p zb-if={!demos.emailTo} class="hq-muted">Nobody on this opportunity has an email yet.</p>
        <form zb-else method="post" action="/opportunities/{o.id}/demos" class="hq-form">
          <fieldset class="hq-checks">
            <legend>Send {demos.emailTo} a link to</legend>
            <zb-each items={demos.choices} as="demo" key={demo.id}><label><input type="checkbox" name="demo-{demo.id}" value="1"> {demo.name}</label></zb-each>
          </fieldset>
          <text-field label="A note of your own" name="note" rows={2} maxlength={1000} description="Goes after the greeting."></text-field>
          <div><button class="hq-button" type="submit">Send</button></div>
        </form>
      </details>
    </section>
    <details zb-if={referred && referred.canEdit} class="hq-more hq-panel" id="referred-by">
      <summary>Who referred them</summary>
      <form method="post" action="/opportunities/{o.id}/referred-by" class="hq-form">
        <div class="hq-field">
          <label for="referred-client">A client</label>
          <select id="referred-client" name="organizationId">
            <option value="">Not a client</option>
            <zb-each items={referred.clients} as="c" key={c.value}><option value={c.value} selected={c.value === referred.organizationId}>{c.label}</option></zb-each>
          </select>
        </div>
        <text-field label="Or a person" name="name" value={referred.name} maxlength={100} description="Like: Dale at the feed store. Only when it isn’t a client."></text-field>
        <div><button class="hq-button secondary" type="submit">Save</button></div>
      </form>
    </details>
    <section zb-if={canMove} class="hq-panel" aria-labelledby="opportunity-stage">
      <h2 id="opportunity-stage">Move it on</h2>
      <div class="hq-actions">
        <form zb-if={view.nextStage} method="post" action="/opportunities/{o.id}/stage">
          <input type="hidden" name="to" value={view.nextStage}>
          <button class="hq-button" type="submit">Move to {view.nextStageLabel}</button>
        </form>
        <form zb-if={view.canSkipToWon} method="post" action="/opportunities/{o.id}/stage">
          <input type="hidden" name="to" value="won">
          <button class="hq-button secondary" type="submit">Mark won (free landing page)</button>
        </form>
      </div>
      <form method="post" action="/opportunities/{o.id}/stage" class="hq-form" data-spaced>
        <input type="hidden" name="to" value="lost">
        <text-field label="Why was it lost?" name="lostReason" required={true}></text-field>
        <div><button class="hq-button secondary" type="submit">Mark lost</button></div>
      </form>
    </section>
    <section zb-if={canMoveBack} class="hq-panel" aria-labelledby="opportunity-back">
      <h2 id="opportunity-back">{o.open ? 'Move it back' : 'Reopen it'}</h2>
      <form method="post" action="/opportunities/{o.id}/stage" class="hq-form">
        <input type="hidden" name="back" value="1">
        <div class="hq-field">
          <label for="opportunity-back-to">{o.open ? 'Back to' : 'Reopen at'}</label>
          <select id="opportunity-back-to" name="to">
            <zb-each items={view.backStages} as="stage" key={stage.value}><option value={stage.value}>{stage.label}</option></zb-each>
          </select>
        </div>
        <div><button class="hq-button secondary" type="submit">{o.open ? 'Move back' : 'Reopen'}</button></div>
      </form>
    </section>
    <section zb-if={view.can.setValue && o.open} class="hq-panel" aria-labelledby="opportunity-price">
      <h2 id="opportunity-price">Price</h2>
      <form method="post" action="/opportunities/{o.id}/value" class="hq-form">
        <div class="hq-field">
          <label for="opportunity-pricing">How it is priced</label>
          <select id="opportunity-pricing" name="pricing" required>
            <zb-each items={view.pricings} as="pricing" key={pricing.value}><option value={pricing.value} selected={pricing.value === o.pricing}>{pricing.label}</option></zb-each>
          </select>
        </div>
        <text-field label="Amount in dollars" name="amount" value={o.amount} inputmode="decimal" description="Per hour, month or year, or in total. Leave empty for free."></text-field>
        <div><button class="hq-button" type="submit">Save price</button></div>
      </form>
    </section>
    <section zb-if={view.can.setFollowUp && o.open} class="hq-panel" aria-labelledby="opportunity-follow-up">
      <h2 id="opportunity-follow-up">Follow-up</h2>
      <div class="hq-actions">
        <form method="post" action="/opportunities/{o.id}/follow-up" class="hq-form-row">
          <text-field label="Follow up on" name="on" type="date" value={o.followUpOn} required={true}></text-field>
          <button class="hq-button" type="submit">Save follow-up</button>
        </form>
        <form zb-if={o.followUpOn} method="post" action="/opportunities/{o.id}/follow-up">
          <input type="hidden" name="clear" value="1">
          <button class="hq-button secondary" type="submit">Clear follow-up</button>
        </form>
      </div>
    </section>
    </div>
    <div>
    <ai-deal-panel models={aiModels} ai={ai} states={aiStates} opportunity-id={o.id} open={o.open} email-on={emailOn}></ai-deal-panel>
    <touches-panel zb-if={touches} touches={touches} action="/opportunities/{o.id}/touches" follow-up={o.open} call-field="opportunityId" call-id={o.id}></touches-panel>
    <todos-panel zb-if={todos} todos={todos} where="opportunity" id={o.id}></todos-panel>
    <section zb-if={proposals.canView} class="hq-panel" aria-labelledby="opportunity-proposals">
      <h2 id="opportunity-proposals">Proposals</h2>
      <p zb-if={proposals.items.length === 0} class="hq-muted">None yet.</p>
      <table tabindex="0" zb-else class="hq-table">
        <thead><tr><th scope="col">Proposal</th><th scope="col">Status</th><th scope="col">Version</th><th scope="col" class="hq-number">Price</th></tr></thead>
        <tbody>
          <zb-each items={proposals.items} as="proposal" key={proposal.id}>
            <tr><td><a href="/proposals/{proposal.id}">{proposal.title}</a></td><td>{proposal.statusLabel}</td><td>{proposal.version || "Not sent"}</td><td class="hq-number">{proposal.price}</td></tr>
          </zb-each>
        </tbody>
      </table>
      <form zb-if={proposals.canStart} method="post" action="/opportunities/{o.id}/proposals" class="hq-form-row" data-spaced>
        <div class="hq-field">
          <label for="proposal-template">Start from</label>
          <select id="proposal-template" name="template">
            <zb-each items={proposals.templates} as="template" key={template.value}><option value={template.value} selected={template.value === proposals.suggested}>{template.label}</option></zb-each>
          </select>
        </div>
        <button class="hq-button secondary" type="submit">Start a proposal</button>
      </form>
    </section>
    <section zb-if={o.won} class="hq-panel" aria-labelledby="opportunity-project">
      <h2 id="opportunity-project">Project</h2>
      <p zb-if={view.project}><a href="/projects/{view.project.id}">{view.project.name}</a></p>
      <form zb-else-if={view.can.convert} method="post" action="/opportunities/{o.id}/convert">
        <button class="hq-button" type="submit">Start the project</button>
      </form>
      <p zb-else class="hq-muted">Not started yet.</p>
    </section>
    <notes-panel notes={notes}></notes-panel>
    </div>
    </div>
    <history-panel items={history}></history-panel>
  </div>
</hq-opportunity>
