<!--
  My work: your open to-dos and project tasks by when (overdue, today, coming
  up, whenever), or everyone's, and what you finished this week. Add a to-do
  for yourself or anyone (decision 0007, section 1).
-->
<script>
  'use route /todos'
  import '../../shared/ui/zubra/select-field.zb'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/empty-state.zb'
  import '../../shared/ui/parts/todo-list.zb'
  export async function load({ context, url }) {
    const stop = context.guard()
    if (stop) return stop
    const everyone = url.searchParams.get('everyone') === '1'
    const view = context.todos.list(everyone)
    if (!view.ok) return context.forbidden()
    return { title: view.value.everyone ? 'Everyone’s work' : 'My work', view: view.value, done: context.notice.done, problem: context.notice.problem }
  }
</script>
<style>
  .todo-add { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 0.75rem; align-items: end; }
  .todo-add .todo-title { grid-column: 1 / -1; }
  .todo-switch { display: flex; gap: 1rem; margin: 0 0 1rem; }
</style>
<hq-todos view={{ overdue: [], today: [], upcoming: [], someday: [], done: [], everyone: false, canEdit: false, people: [], clients: [] }} done="" problem="">
  <div class="hq-page">
    <h1>{view.everyone ? 'Everyone’s work' : 'My work'}</h1>
    <p class="hq-muted">To-dos and project tasks together, by when they’re due. <a href="/calendar-feed">See them in your calendar</a></p>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <p class="todo-switch">
      <a href="/todos" aria-current={view.everyone ? null : 'page'}>Mine</a>
      <a href="/todos?everyone=1" aria-current={view.everyone ? 'page' : null}>Everyone’s</a>
    </p>
    <section zb-if={view.canEdit} class="hq-panel" aria-labelledby="todo-add-heading">
      <h2 id="todo-add-heading">Add a to-do</h2>
      <form method="post" action="/todos" class="hq-form">
        <input zb-if={view.everyone} type="hidden" name="everyone" value="1">
        <div class="todo-add">
          <div class="hq-field todo-title">
            <label for="todo-title">What needs doing</label>
            <input id="todo-title" name="title" type="text" maxlength="200" required>
          </div>
          <div class="hq-field">
            <label for="todo-due">Due (optional)</label>
            <input id="todo-due" name="dueOn" type="date">
          </div>
          <select-field label="Whose" name="assigneeId" options={view.people}></select-field>
          <div class="hq-field">
            <label for="todo-client">About a client (optional)</label>
            <select id="todo-client" name="clientId">
              <option value="">None</option>
              <zb-each items={view.clients} as="client" key={client.value}><option value={client.value}>{client.label}</option></zb-each>
            </select>
          </div>
        </div>
        <div><button class="hq-button" type="submit">Add it</button></div>
      </form>
    </section>
    <empty-state zb-if={view.overdue.length + view.today.length + view.upcoming.length + view.someday.length === 0} heading="Nothing to do">{view.everyone ? 'No one has an open to-do.' : 'Nothing is on your list. Add one above, or from a client or an opportunity.'}</empty-state>
    <zb-each items={[{ key: 'overdue', title: 'Overdue', items: view.overdue }, { key: 'today', title: 'Today', items: view.today }, { key: 'upcoming', title: 'Coming up', items: view.upcoming }, { key: 'someday', title: 'Whenever', items: view.someday }, { key: 'done', title: 'Done this week', items: view.done }]} as="group" key={group.key}>
      <section zb-if={group.items.length > 0} class="hq-panel" aria-labelledby="todos-{group.key}">
        <h2 id="todos-{group.key}">{group.title}</h2>
        <todo-list items={group.items} can-edit={view.canEdit} back={view.everyone ? 'everyone' : ''} back-id="" show-who={view.everyone} show-client={true}></todo-list>
      </section>
    </zb-each>
  </div>
</hq-todos>
