<!--
  Ask HQ (decision 0012): a question answered from the knowledge base and
  decision log, with links to the articles it came from.
-->
<script>
  'use route /ask'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/text-field.zb'
  export async function load({ context }) {
    const stop = context.guard()
    if (stop) return stop
    const state = context.ai.state('ask')
    const answer = context.ai.ask()
    if (!state.on && !state.why && !answer) return context.forbidden()
    return { title: 'Ask HQ', state, answer, done: context.notice.done, problem: context.notice.problem }
  }
</script>
<style>
  .ask-answer { white-space: pre-wrap; }
</style>
<hq-ask state={{ on: false, why: '' }} answer={null} done="" problem="">
  <div class="hq-page">
    <h1>Ask HQ</h1>
    <p class="hq-muted">Answers come from the knowledge base and the decision log, with links to the articles they used. Check anything that matters there.</p>
    <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
    <alert-banner zb-if={state.why} variant="warning">{state.why}</alert-banner>
    <form zb-if={state.on} method="post" action="/ask" class="hq-panel hq-form">
      <text-field label="Your question" name="question" required={true} maxlength={500} placeholder="What did we decide about deposits?"></text-field>
      <div><button class="hq-button" type="submit">Ask</button></div>
    </form>
    <section zb-if={answer} class="hq-panel" id="answer" aria-labelledby="ask-answer">
      <h2 id="ask-answer">{answer.question}</h2>
      <p class="ask-answer">{answer.answer}</p>
      <p zb-if={answer.links.length} class="hq-small">From:
        <zb-each items={answer.links} as="link" key={link.slug}> <a href="/knowledge/{link.slug}">{link.slug}</a></zb-each>
      </p>
      <p class="hq-muted hq-small">Asked {answer.when}.</p>
    </section>
  </div>
</hq-ask>
