<!--
  A person's own settings: the theme, their password and two-factor sign-in.
-->
<script>
  'use route /settings'
  import '../../shared/ui/zubra/alert-banner.zb'
  export async function load({ context }) {
    const stop = context.guard()
    if (stop) return stop
    return { title: 'Settings', twoFactor: context.settings.twoFactor, theme: context.settings.theme, themes: context.settings.themes, audit: context.can.audit, done: context.notice.done, problem: context.notice.problem }
  }
</script>
<hq-settings two-factor={{}} theme="system" themes={[]} audit={false} done="" problem="">
  <div class="hq-page">
    <h1>Settings</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <section class="hq-panel" aria-labelledby="settings-theme">
      <h2 id="settings-theme">Theme</h2>
      <form method="post" action="/settings/theme" class="hq-form-row">
        <div class="hq-field">
          <label for="theme">Colours</label>
          <select id="theme" name="theme">
            <zb-each items={themes} as="option" key={option.value}><option value={option.value} selected={option.value === theme}>{option.label}</option></zb-each>
          </select>
        </div>
        <button class="hq-button" type="submit">Save theme</button>
      </form>
    </section>
    <section class="hq-panel" aria-labelledby="settings-password">
      <h2 id="settings-password">Password</h2>
      <p><a href="/staff/password">Change your password</a></p>
    </section>
    <section class="hq-panel" id="two-factor" aria-labelledby="settings-two-factor">
      <h2 id="settings-two-factor">Two-factor sign-in</h2>
      <alert-banner zb-if={twoFactor.required} variant="warning" heading="Required for admins">HQ requires two-factor sign-in for admins. Turn it on to use the rest of HQ.</alert-banner>
      <div zb-if={twoFactor.on}>
        <p><span class="hq-tag">On</span> After your password, HQ asks for a code from your authenticator app. {twoFactor.recoveryText}</p>
        <form method="post" action="/settings/two-factor/off" class="hq-form-row">
          <div class="hq-field">
            <label for="two-factor-off-code">Code from your app, or a recovery code</label>
            <input id="two-factor-off-code" name="code" autocomplete="one-time-code" required>
          </div>
          <button class="hq-button secondary" type="submit">Turn off two-factor sign-in</button>
        </form>
      </div>
      <div zb-else-if={twoFactor.setup}>
        <ol class="hq-steps">
          <li>Open an authenticator app on your phone, such as 1Password, Google Authenticator or Microsoft Authenticator, and add an account.</li>
          <li zb-if={twoFactor.setup.scannable}>
            Scan this code with the app.
            <img class="hq-qr" src="/settings/two-factor/qr.svg" width="200" height="200" alt="QR code to add Potomac HQ to your authenticator app">
            On this phone instead? <a href={twoFactor.setup.link}>Open HQ in your app</a>. Or choose to enter a key, and type this one: <code class="hq-key">{twoFactor.setup.key}</code>
          </li>
          <li zb-else>On this phone, <a href={twoFactor.setup.link}>open HQ in your app</a>. Otherwise choose to enter a key, and type this one: <code class="hq-key">{twoFactor.setup.key}</code></li>
          <li>Enter the 6-digit code the app shows for Potomac HQ.</li>
        </ol>
        <form method="post" action="/settings/two-factor/confirm" class="hq-form-row">
          <div class="hq-field">
            <label for="two-factor-code">Code from your app</label>
            <input id="two-factor-code" name="code" autocomplete="one-time-code" inputmode="numeric" required>
          </div>
          <button class="hq-button" type="submit">Turn it on</button>
        </form>
        <form method="post" action="/settings/two-factor/off" class="hq-form-row" data-spaced><input type="hidden" name="code" value=""><button class="hq-button secondary" type="submit">Cancel</button></form>
      </div>
      <div zb-else>
        <p>Off. Turn it on and HQ asks for a code from an app on your phone after your password, so a stolen password is not enough to get in.</p>
        <form method="post" action="/settings/two-factor" class="hq-form-row"><button class="hq-button" type="submit">Turn on two-factor sign-in</button></form>
      </div>
    </section>
    <section class="hq-panel" aria-labelledby="settings-hq">
      <h2 id="settings-hq">Potomac HQ</h2>
      <ul class="hq-list">
        <li><a href="/people">People</a> <span class="hq-muted">Who can sign in, and their roles</span></li>
        <li zb-if={audit}><a href="/activity">Audit history</a> <span class="hq-muted">Everything that has been done in HQ</span></li>
      </ul>
    </section>
  </div>
</hq-settings>
