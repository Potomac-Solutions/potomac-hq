<!--
  A person's own settings: the theme, their password and two-factor sign-in.
-->
<script>
  'use route /settings'
  import '../../shared/ui/zubra/status-badge.zb'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/parts/passkey-button.zb'
  import '../../shared/ui/parts/push-setup.zb'
  export async function load({ context }) {
    const stop = context.guard()
    if (stop) return stop
    return { title: 'Settings', twoFactor: context.settings.twoFactor, theme: context.settings.theme, morning: context.settings.morningEmail, themes: context.settings.themes, audit: context.can.audit, ai: context.ai.canManage, push: context.push(), done: context.notice.done, problem: context.notice.problem }
  }
</script>
<hq-settings two-factor={{}} morning={{ on: false, emailSetUp: false, address: "" }} theme="system" themes={[]} audit={false} ai={false} push={{ ready: false, publicKey: "", devices: [] }} done="" problem="">
  <div class="hq-page">
    <h1>Settings</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <section class="hq-panel" aria-labelledby="settings-theme">
      <h2 id="settings-theme">Theme</h2>
      <form method="post" action="/settings/theme" class="hq-form-row">
        <div class="hq-field">
          <label for="theme">Colours</label>
          <select id="theme" name="theme">
            <zb-each items={themes} as="option" key={option.value}><option value={option.value} selected={option.value === theme}>{option.label}</option></zb-each>
          </select>
        </div>
        <button class="hq-button" type="submit">Save theme</button>
      </form>
    </section>
    <section class="hq-panel" id="morning-email" aria-labelledby="settings-morning">
      <h2 id="settings-morning">Morning email</h2>
      <p>At 7 each morning, HQ emails you <a href="/today">Today</a>’s list: calls, follow-ups, to-dos and anything a client is waiting on. Nothing is sent on a day with nothing due.</p>
      <p zb-if={!morning.emailSetUp} class="hq-muted hq-small">HQ can’t send email yet, so this waits until email is set up.</p>
      <form method="post" action="/settings/morning-email" class="hq-form-row">
        <div class="hq-check">
          <input id="morning-email-on" name="morningEmail" type="checkbox" value="1" checked={morning.on}>
          <label for="morning-email-on">Email me Today’s list<span zb-if={morning.address}> at {morning.address}</span></label>
        </div>
        <button class="hq-button" type="submit">Save</button>
      </form>
    </section>
    <push-setup view={push}></push-setup>
    <section zb-if={ai} class="hq-panel" aria-labelledby="settings-ai">
      <h2 id="settings-ai">AI</h2>
      <p>Which AI features are on, the model, the monthly budget and what it’s cost: <a href="/settings/ai">the model and budget</a>.</p>
    </section>
    <section class="hq-panel" aria-labelledby="settings-calendar">
      <h2 id="settings-calendar">Calendar</h2>
      <p>Your tasks and milestones in Google Calendar, Apple Calendar or Outlook. <a href="/calendar-feed">Set up your calendar feed</a></p>
    </section>
    <section class="hq-panel" aria-labelledby="settings-password">
      <h2 id="settings-password">Password</h2>
      <p><a href="/staff/password">Change your password</a></p>
    </section>
    <section class="hq-panel" id="two-factor" aria-labelledby="settings-two-factor">
      <h2 id="settings-two-factor">Two-factor sign-in</h2>
      <alert-banner zb-if={twoFactor.required} variant="warning" heading="Required for admins">HQ requires two-factor sign-in for admins. Turn it on to use the rest of HQ.</alert-banner>
      <div zb-if={twoFactor.on}>
        <p><status-badge variant="success">On</status-badge> After your password, HQ asks for {twoFactor.how}. {twoFactor.recoveryText}</p>
        <h3 id="settings-passkeys">Passkeys</h3>
        <p class="hq-muted hq-small">A passkey is kept by your phone, your computer or a security key, and unlocked with your fingerprint, face or PIN. It can’t be typed into a fake sign-in page.</p>
        <ul zb-if={twoFactor.hasPasskey} class="hq-list hq-passkeys" aria-labelledby="settings-passkeys">
          <zb-each items={twoFactor.passkeys} as="passkey" key={passkey.id}>
            <li>
              <span><strong>{passkey.label}</strong> <span class="hq-muted hq-small">Added {passkey.added}. {passkey.used}.</span></span>
              <form zb-if={passkey.removable} method="post" action={`/settings/passkeys/${passkey.id}/remove`}><button class="hq-button secondary small" type="submit" aria-label={`Remove passkey ${passkey.label}`}>Remove</button></form>
            </li>
          </zb-each>
        </ul>
        <form method="post" action="/settings/passkeys" class="hq-form-row">
          <div class="hq-field">
            <label for="passkey-label">Name for a new passkey</label>
            <input id="passkey-label" name="label" maxlength="60" placeholder="My laptop" autocomplete="off">
          </div>
          <passkey-button purpose="register" field="credential" label="Add a passkey" secondary={true}></passkey-button>
        </form>
        <h3>Recovery codes</h3>
        <form method="post" action="/settings/two-factor/recovery-codes" class="hq-form-row">
          <div zb-if={twoFactor.app} class="hq-field">
            <label for="two-factor-new-codes">Code from your app</label>
            <input id="two-factor-new-codes" name="code" autocomplete="one-time-code" inputmode="numeric" required>
          </div>
          <button zb-if={twoFactor.app} class="hq-button secondary" type="submit">Make new recovery codes</button>
          <passkey-button zb-if={twoFactor.hasPasskey} purpose="verify" field="passkey" label={twoFactor.app ? 'Or make them with a passkey' : 'Make new recovery codes with your passkey'} secondary={true}></passkey-button>
        </form>
        <p class="hq-muted hq-small">New codes replace the old ones. Do it when you have used most of them, or think someone has seen them.</p>
        <h3>Turn it off</h3>
        <form method="post" action="/settings/two-factor/off" class="hq-form-row">
          <div class="hq-field">
            <label for="two-factor-off-code">{twoFactor.app ? 'Code from your app, or a recovery code' : 'A recovery code'}</label>
            <input id="two-factor-off-code" name="code" autocomplete="one-time-code" required>
          </div>
          <button class="hq-button secondary" type="submit">Turn off two-factor sign-in</button>
          <passkey-button zb-if={twoFactor.hasPasskey} purpose="verify" field="passkey" label="Or turn it off with a passkey" secondary={true}></passkey-button>
        </form>
        <p zb-if={!twoFactor.app} class="hq-muted hq-small">To use an authenticator app as well, turn two-factor sign-in off, then turn it on with the app and add your passkey again.</p>
      </div>
      <div zb-else-if={twoFactor.setup}>
        <ol class="hq-steps">
          <li>Open an authenticator app on your phone, such as 1Password, Google Authenticator or Microsoft Authenticator, and add an account.</li>
          <li zb-if={twoFactor.setup.scannable}>
            Scan this code with the app.
            <img class="hq-qr" src="/settings/two-factor/qr.svg" width="200" height="200" alt="QR code to add Potomac HQ to your authenticator app">
            On this phone instead? <a href="/settings/two-factor/app">Open HQ in your app</a>. Or choose to enter a key, and type this one: <code class="hq-key">{twoFactor.setup.key}</code>
          </li>
          <li zb-else>On this phone, <a href="/settings/two-factor/app">open HQ in your app</a>. Otherwise choose to enter a key, and type this one: <code class="hq-key">{twoFactor.setup.key}</code></li>
          <li>Enter the 6-digit code the app shows for Potomac HQ.</li>
        </ol>
        <form method="post" action="/settings/two-factor/confirm" class="hq-form-row">
          <div class="hq-field">
            <label for="two-factor-code">Code from your app</label>
            <input id="two-factor-code" name="code" autocomplete="one-time-code" inputmode="numeric" required>
          </div>
          <button class="hq-button" type="submit">Turn it on</button>
        </form>
        <form method="post" action="/settings/two-factor/off" class="hq-form-row" data-spaced><input type="hidden" name="code" value=""><button class="hq-button secondary" type="submit">Cancel</button></form>
      </div>
      <div zb-else>
        <p><status-badge variant="neutral">Off</status-badge> Turn it on and HQ asks for a second proof after your password, so a stolen password is not enough to get in. Choose either; you get recovery codes both ways.</p>
        <div class="hq-choices">
          <div class="hq-choice">
            <h3>With a passkey</h3>
            <p class="hq-muted hq-small">Your fingerprint, face or PIN on this device, or a security key. Nothing to type, and it can’t be given to a fake sign-in page.</p>
            <form method="post" action="/settings/passkeys" class="hq-form-row">
              <div class="hq-field">
                <label for="passkey-label">Name for the passkey</label>
                <input id="passkey-label" name="label" maxlength="60" placeholder="My laptop" autocomplete="off">
              </div>
              <passkey-button purpose="register" field="credential" label="Turn on with a passkey"></passkey-button>
            </form>
          </div>
          <div class="hq-choice">
            <h3>With an authenticator app</h3>
            <p class="hq-muted hq-small">A 6-digit code from an app on your phone, such as 1Password or Google Authenticator. You can add passkeys afterwards.</p>
            <form method="post" action="/settings/two-factor" class="hq-form-row"><button class="hq-button secondary" type="submit">Turn on with an app</button></form>
          </div>
        </div>
      </div>
    </section>
    <section class="hq-panel" aria-labelledby="settings-hq">
      <h2 id="settings-hq">Potomac HQ</h2>
      <ul class="hq-list">
        <li><a href="/people">People</a> <span class="hq-muted">Who can sign in, and their roles</span></li>
        <li zb-if={audit}><a href="/activity">Audit history</a> <span class="hq-muted">Everything that has been done in HQ</span></li>
      </ul>
    </section>
  </div>
</hq-settings>
