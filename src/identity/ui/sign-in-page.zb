<!--
  The sign-in form. It posts to the Potomac kit's sign-in route as a plain
  form, so it works with or without JavaScript.
-->
<script>
  import '../../shared/ui/zubra/action-button.zb'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/text-field.zb'
</script>
<style>
  :host { display: block; max-width: 25rem; margin: 9vh auto 2rem; }
  .hq-sign-in { display: grid; gap: 1.1rem; padding: 2rem; background: var(--card); color: var(--card-foreground); border: 1px solid var(--border); border-top: 0.25rem solid var(--primary); border-radius: var(--radius); box-shadow: var(--shadow); }
  .hq-sign-in h1 { margin: 0; }
  .hq-sign-in .lead { margin: -0.6rem 0 0; color: var(--muted-foreground); }
  .hq-sign-in form { display: grid; gap: 1rem; margin: 0; }
  .hq-sign-in action-button, .hq-sign-in .action-button { width: 100%; }
  .hq-sign-in-foot { margin: 1rem 0 0; text-align: center; color: var(--muted-foreground); font-size: 0.8125rem; }
</style>
<hq-sign-in problem="" done="" needs-owner={false} email-enabled={false}>
  <div class="hq-sign-in">
    <h1>Sign in</h1>
    <p class="lead">Potomac Solutions’ own workspace: clients, projects and money.</p>
    <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
    <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    <alert-banner zb-if={needsOwner} variant="info" heading="Nobody has an account here yet">The setup link is in the server log. It works once.</alert-banner>
    <form method="post" action="/staff/sign-in">
      <text-field label="Email" name="email" type="email" autocomplete="username" required={true}></text-field>
      <text-field label="Password" name="password" type="password" autocomplete="current-password" required={true}></text-field>
      <div><action-button type="submit">Sign in</action-button></div>
    </form>
    <p zb-if={emailEnabled}><a href="/forgot-password">Forgot your password?</a></p>
  </div>
  <p class="hq-sign-in-foot">For Potomac Solutions staff. Clients sign in at the <a href="/portal/sign-in">client portal</a>.</p>
</hq-sign-in>
