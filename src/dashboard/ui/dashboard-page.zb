<!--
  The dashboard: the company at a glance. A row of figures, each a link to
  its page; then what needs someone (clients waiting, down sites, follow-ups,
  deadlines, budgets, projects) beside what is coming and what happened
  (calls, renewals, the pipeline, hours, clients' doings, recent activity).
  Signed out, the sign-in form is shown at the same address.
-->
<script>
  'use route /'
  import '../../shared/ui/zubra/status-badge.zb'
  import { show } from '@zubra/router'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/empty-state.zb'
  import '../../shared/ui/zubra/stat-card.zb'

  export async function load({ context }) {
    const stop = context.guard()
    if (stop) return stop
    const feed = context.dashboard.recentActivity()
    if (!feed.ok) return show('identity/ui/no-access', { title: 'No access' }, { status: 403 })
    const due = context.crm.followUpsDue()
    const pipeline = context.crm.pipeline()
    const active = context.projects.active()
    const deadlines = context.projects.deadlines()
    const hours = context.time.thisWeek()
    const over = context.money.overBudget()
    const fromClients = context.portalAdmin.fromClients()
    const waiting = context.portalAdmin.waiting()
    const followUps = due.ok ? due.value.items : []
    const stats = [
      { key: 'waiting', label: 'Clients waiting', value: String(waiting.items.length), period: waiting.items.length === 0 ? 'Nobody is waiting on you' : 'Answer these first', href: '#waiting-on-you' },
      ...(due.ok ? [{ key: 'follow-ups', label: 'Due follow-ups', value: String(followUps.length), period: followUps.filter((one) => one.overdue).length + ' overdue', href: '/today' }] : []),
      ...(pipeline.ok ? [{ key: 'open', label: 'Opportunities open', value: String(pipeline.value.openCount), period: 'In the pipeline', href: '/pipeline' }] : []),
      ...(active.ok ? [{ key: 'projects', label: 'Projects active', value: String(active.value.items.length), period: (deadlines.ok ? deadlines.value.items.length : 0) + ' deadlines in two weeks', href: '/projects' }] : []),
      ...(over.ok ? [{ key: 'budgets', label: 'Budgets at risk', value: String(over.value.items.length), period: over.value.items.filter((one) => one.level === 'over').length + ' over', href: '#over-budget' }] : []),
      ...(hours.ok ? [{ key: 'hours', label: 'Your hours this week', value: hours.value.mine, period: hours.value.timer.running ? 'Timer running' : 'No timer running', href: '/time' }] : []),
    ]
    return {
      stats,
      today: context.todayLabel,
      projects: active.ok ? active.value.items : [],
      showProjects: active.ok,
      deadlines: deadlines.ok ? deadlines.value.items : [],
      hours: hours.ok ? hours.value : null,
      over: over.ok ? over.value.items : [],
      showOver: over.ok,
      stages: pipeline.ok ? pipeline.value.columns.map((column) => ({ stage: column.stage, label: column.label, count: column.items.length })) : [],
      openCount: pipeline.ok ? pipeline.value.openCount : 0,
      title: 'Dashboard',
      followUps,
      fromClients: fromClients.items,
      waiting: waiting.items,
      calls: context.booking.next(),
      renewals: context.renewals.comingUp(),
      sites: context.monitor.attention(),
      showFollowUps: due.ok,
      items: feed.value.items,
      everything: feed.value.everything,
      done: context.notice.done,
      problem: context.notice.problem,
      remindTwoFactor: context.settings.remindTwoFactor,
    }
  }

  const empty = items.length === 0
</script>
<style>
  :host { display: block; }
  .hq-activity { list-style: none; margin: 0; padding: 0; }
  .hq-activity li { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.25rem 1rem; padding: 0.6rem 0; border-top: 1px solid var(--border); }
  .hq-activity li:first-child { border-top: 0; }
  .hq-activity time, .hq-scope { color: var(--muted-foreground); font-size: 0.875rem; }
  .hq-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .hq-actions form { margin: 0; }
  .hq-scope { margin: 0 0 0.5rem; }
  .hq-waiting { border-left: 0.3rem solid var(--primary); }
  .hq-waiting .hq-scope { margin: 0; }
  .hq-stages { display: grid; margin: 0 0 0.75rem; padding: 0; list-style: none; }
  .hq-stages li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.35rem 0; border-top: 1px solid var(--border); }
  .hq-stages li:first-child { border-top: 0; }
  .hq-panel > p:last-child { margin-bottom: 0; }
</style>
<hq-dashboard items={[]} everything={false} follow-ups={[]} show-follow-ups={false} stages={[]} open-count={0} projects={[]} show-projects={false} deadlines={[]} hours={null} over={[]} show-over={false} from-clients={[]} waiting={[]} calls={null} renewals={[]} sites={[]} done="" problem="" remind-two-factor={false} stats={[]} today="">
 <div class="hq-page">
  <div class="hq-head">
    <div><h1>Dashboard</h1><p>{today}</p></div>
    <div class="hq-head-actions"><a class="hq-button" href="/today">Work today’s list</a></div>
  </div>
  <div zb-if={done || problem || remindTwoFactor} class="hq-notices">
    <alert-banner zb-if={remindTwoFactor} variant="warning" heading="Turn on two-factor sign-in">You're an admin, so your password alone opens everything in HQ, including who can sign in. <a href="/settings#two-factor">Turn it on</a> in Settings. It takes a minute and an app on your phone.</alert-banner>
    <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
    <alert-banner zb-if={done} variant="success">{done}</alert-banner>
  </div>
  <div class="hq-stats">
    <zb-each items={stats} as="stat" key={stat.key}>
      <a href={stat.href}><stat-card label={stat.label} value={stat.value} period={stat.period}></stat-card></a>
    </zb-each>
  </div>
  <div class="hq-split">
  <div>
  <section class="hq-panel hq-waiting" aria-labelledby="waiting-on-you">
    <h2 id="waiting-on-you">{waiting.length === 0 ? "No client is waiting on you" : waiting.length === 1 ? "1 thing a client is waiting on" : waiting.length + " things clients are waiting on"}</h2>
    <p zb-if={waiting.length === 0} class="hq-muted">Unanswered messages, changes asked for, calls to return and invoices to send or chase show here first.</p>
    <ul zb-else class="hq-activity">
      <zb-each items={waiting} as="item" key={item.key}>
        <li><span><strong>{item.text}</strong><br><span class="hq-scope">{item.detail}</span></span> <a class="hq-button secondary small" href={item.href}>{item.action}<span class="sr-only">: {item.text}</span></a></li>
      </zb-each>
    </ul>
  </section>
  <section zb-if={sites.length > 0} class="hq-panel hq-waiting" aria-labelledby="sites-attention">
    <h2 id="sites-attention">Sites that need you</h2>
    <ul class="hq-activity">
      <zb-each items={sites} as="site" key={site.id}>
        <li><span><strong>{site.host}</strong> · {site.clientName}<br><span class="hq-scope">{site.state === 'down' ? 'Down ' + site.since + ': ' + site.lastResult : site.cert}</span></span></li>
      </zb-each>
    </ul>
    <p><a href="/sites">All sites</a></p>
  </section>
  <section zb-if={showFollowUps} class="hq-panel" aria-labelledby="follow-ups-due">
    <h2 id="follow-ups-due">Follow-ups due</h2>
    <p zb-if={followUps.length === 0} class="hq-muted">Nothing due today. Follow-ups set on an opportunity show here on their day.</p>
    <ul zb-else class="hq-activity">
      <zb-each items={followUps} as="item" key={item.id}>
        <li><span><a href="/opportunities/{item.id}">{item.title}</a> · {item.clientName}</span> <span><time datetime={item.followUpOn}>{item.followUpText}</time> <status-badge zb-if={item.overdue} variant="danger">Overdue</status-badge></span></li>
      </zb-each>
    </ul>
  </section>
  <section zb-if={showProjects} class="hq-panel" aria-labelledby="upcoming-deadlines">
    <h2 id="upcoming-deadlines">Upcoming deadlines</h2>
    <p zb-if={deadlines.length === 0} class="hq-muted">Nothing due in the next two weeks.</p>
    <ul zb-else class="hq-activity">
      <zb-each items={deadlines} as="item" key={item.key}>
        <li><span>{item.kind}: <a href={item.href}>{item.title}</a> · {item.projectName}</span> <span><time datetime={item.dueOn}>{item.dueText}</time> <status-badge zb-if={item.overdue} variant="danger">Overdue</status-badge></span></li>
      </zb-each>
    </ul>
  </section>
  <section zb-if={showOver} class="hq-panel" aria-labelledby="over-budget">
    <h2 id="over-budget">Budgets to watch</h2>
    <p zb-if={over.length === 0} class="hq-muted">None. Every active project is within its hours and its budget, and none has used three quarters of it ahead of the work.</p>
    <ul zb-else class="hq-activity">
      <zb-each items={over} as="project" key={project.id}>
        <li><span><a href="/projects/{project.id}/money">{project.name}</a> · {project.clientName}<br><span class="hq-scope">{project.warning}</span></span> <span><status-badge variant={project.level === 'over' ? 'danger' : 'neutral'}>{project.level === 'over' ? 'Over' : 'Watch'}</status-badge> {project.why}</span></li>
      </zb-each>
    </ul>
  </section>
  <section zb-if={showProjects} class="hq-panel" aria-labelledby="active-projects">
    <h2 id="active-projects">Active projects: {projects.length}</h2>
    <empty-state zb-if={projects.length === 0} heading="No active projects">A project starts when a won opportunity is turned into one.</empty-state>
    <ul zb-else class="hq-activity">
      <zb-each items={projects} as="project" key={project.id}>
        <li><span><a href="/projects/{project.id}">{project.name}</a> · {project.clientName} <status-badge variant={project.health === 'on-track' ? 'success' : project.health === 'at-risk' ? 'warning' : project.health === 'off-track' ? 'danger' : 'neutral'} dot={true}>{project.healthLabel}</status-badge></span> <span>{project.next || "No milestone set"} <status-badge zb-if={project.nextOverdue} variant="danger">Overdue</status-badge></span></li>
      </zb-each>
    </ul>
    <p><a href="/board">Open the board</a></p>
  </section>
  </div>
  <div>
  <section zb-if={calls} class="hq-panel" aria-labelledby="next-calls">
    <h2 id="next-calls">{calls.length === 0 ? "No calls booked in the next two weeks" : "Next calls"}</h2>
    <ul zb-if={calls.length > 0} class="hq-activity">
      <zb-each items={calls} as="call" key={call.id}>
        <li><span><strong><time datetime={call.whenIso}>{call.when}</time></strong><br><span class="hq-scope">{call.who}<span zb-if={call.topic}> · {call.topic}</span></span></span></li>
      </zb-each>
    </ul>
    <p><a href="/calls">All calls</a></p>
  </section>
  <section zb-if={renewals.length > 0} class="hq-panel" aria-labelledby="renewals-coming-up">
    <h2 id="renewals-coming-up">Renewals in the next 30 days</h2>
    <ul class="hq-activity">
      <zb-each items={renewals} as="one" key={one.id}>
        <li><span><strong>{one.name}</strong> · {one.kindLabel}<br><span class="hq-scope">{one.clientName}<span zb-if={one.autoRenews}> · renews by itself</span></span></span> <span><time datetime={one.renewsOn}>{one.when}</time> <status-badge zb-if={one.state === 'overdue'} variant="danger">Overdue</status-badge></span></li>
      </zb-each>
    </ul>
    <p><a href="/renewals">All renewals</a></p>
  </section>
  <section zb-if={showFollowUps} class="hq-panel" aria-labelledby="open-opportunities">
    <h2 id="open-opportunities">Open opportunities: {openCount}</h2>
    <ul class="hq-stages">
      <zb-each items={stages} as="stage" key={stage.stage}><li><span>{stage.label}</span> <strong>{stage.count}</strong></li></zb-each>
    </ul>
    <p><a href="/pipeline">See the pipeline</a></p>
  </section>
  <section zb-if={hours} class="hq-panel" aria-labelledby="hours-this-week">
    <h2 id="hours-this-week">Hours this week</h2>
    <p><strong>{hours.mine}</strong> logged by you<span zb-if={hours.showEveryone}>, {hours.everyone} by everyone</span>.</p>
    <p zb-if={hours.timer.running}>Your timer is running on <strong>{hours.timer.label}</strong>, for {hours.timer.since}.</p>
    <div class="hq-actions">
      <form zb-if={hours.timer.running} method="post" action="/timer/stop">
        <input type="hidden" name="returnTo" value="/">
        <button class="hq-button secondary" type="submit">Stop the timer</button>
      </form>
      <a href="/time">Log time</a>
    </div>
  </section>
  <section zb-if={fromClients.length > 0} class="hq-panel" aria-labelledby="from-clients">
    <h2 id="from-clients">From your clients</h2>
    <p class="hq-muted hq-small">What clients did in the portal in the last two weeks, newest first.</p>
    <ul class="hq-activity">
      <zb-each items={fromClients} as="item" key={item.id}>
        <li><a href={item.href}>{item.text}</a> <time class="hq-scope" datetime={item.whenIso}>{item.when}</time></li>
      </zb-each>
    </ul>
  </section>
  <section class="hq-panel" aria-labelledby="recent-activity">
    <h2 id="recent-activity">Recent activity</h2>
    <p class="hq-scope">{everything ? "Everything recorded in HQ, newest first." : "Changes to clients, opportunities and projects, newest first."} <a zb-if={everything} href="/activity">See the full history</a></p>
    <empty-state zb-if={empty} heading="No activity yet">Changes to clients, opportunities and projects will be listed here.</empty-state>
    <ol zb-else class="hq-activity">
      <zb-each items={items} as="item" key={item.id}>
        <li><span>{item.text}</span> <time datetime={item.whenIso}>{item.when}</time></li>
      </zb-each>
    </ol>
  </section>
  </div>
  </div>
 </div>
</hq-dashboard>
