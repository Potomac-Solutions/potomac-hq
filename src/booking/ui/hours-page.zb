<!--
  When calls can be booked: up to two stretches a weekday, the call length,
  the gap after each call, how much notice, how far ahead, days off, and
  whether clients and the public can book. For managers and admins.
-->
<script>
  'use route /calls/hours'
  import '../../shared/ui/zubra/alert-banner.zb'
  export async function load({ context }) {
    const stop = context.guard()
    if (stop) return stop
    const view = context.booking.setup()
    if (!view.ok) return context.forbidden()
    return { title: 'Hours for calls', view: view.value, lengths: [15, 20, 30, 45, 60, 90], done: context.notice.done, problem: context.notice.problem }
  }
</script>
<style>
  .hours-table { width: 100%; border-collapse: collapse; }
  .hours-table th, .hours-table td { padding: 0.45rem 0.4rem; text-align: left; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .hours-table input { width: 9.5rem; min-height: 2.5rem; padding: 0.35rem 0.5rem; font: inherit; color: var(--foreground); background: var(--background); border: 1px solid var(--input); border-radius: calc(var(--radius) - 2px); }
  .hours-pair { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; }
  .hours-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem; margin: 1rem 0; }
  .hours-check { display: flex; gap: 0.5rem; align-items: flex-start; margin: 0.5rem 0; }
  .hours-check input { width: 1.25rem; height: 1.25rem; margin-top: 0.15rem; }
  .days-off { list-style: none; margin: 0 0 1rem; padding: 0; }
  .days-off li { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; padding: 0.4rem 0; border-top: 1px solid var(--border); }
  .days-off form { margin: 0; }
  @media (max-width: 40rem) { .hours-table thead { display: none; } .hours-table tr { display: grid; } .hours-table td, .hours-table th { border: 0; padding: 0.25rem 0; } .hours-table tr { border-bottom: 1px solid var(--border); padding: 0.5rem 0; } }
</style>
<hq-booking-hours view={{ days: [], closed: [] }} lengths={[]} done="" problem="">
  <div class="hq-page">
    <h1>Hours for calls</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <p class="hq-muted">Times are in Eastern time. Calls go on {view.hostName}’s calendar: whoever saves this page. <a href="/calls">Back to Calls</a></p>
    <p class="hq-muted">{view.calendar === 'none' ? 'Open times avoid calls already booked in HQ. To avoid everything else in your Google Calendar too, see “Booked calls” in the operations guide.' : 'Open times also avoid busy times in ' + view.calendar + '.'}</p>

    <form method="post" action="/calls/hours" class="hq-panel" aria-labelledby="hours-week">
      <h2 id="hours-week">Each week</h2>
      <p class="hq-muted">Up to two stretches a day, like 09:00 to 12:00 and 13:00 to 17:00. Leave a day empty for no calls.</p>
      <table class="hours-table">
        <thead><tr><th scope="col">Day</th><th scope="col">First stretch</th><th scope="col">Second stretch</th></tr></thead>
        <tbody>
          <zb-each items={view.days} as="day" key={day.weekday}>
            <tr>
              <th scope="row">{day.name}</th>
              <td><span class="hours-pair"><input type="time" step="900" name="start-{day.weekday}-0" value={day.ranges[0].start} aria-label="{day.name}, first stretch starts"> to <input type="time" step="900" name="end-{day.weekday}-0" value={day.ranges[0].end} aria-label="{day.name}, first stretch ends"></span></td>
              <td><span class="hours-pair"><input type="time" step="900" name="start-{day.weekday}-1" value={day.ranges[1].start} aria-label="{day.name}, second stretch starts"> to <input type="time" step="900" name="end-{day.weekday}-1" value={day.ranges[1].end} aria-label="{day.name}, second stretch ends"></span></td>
            </tr>
          </zb-each>
        </tbody>
      </table>

      <div class="hours-grid">
        <div class="hq-field">
          <label for="call-minutes">Each call</label>
          <select id="call-minutes" name="call-minutes">
            <zb-each items={lengths} as="minutes" key={minutes}>
              <option value={minutes} selected={minutes === view.callMinutes}>{minutes} minutes</option>
            </zb-each>
          </select>
        </div>
        <div class="hq-field">
          <label for="gap-minutes">Free after each call, in minutes</label>
          <input id="gap-minutes" name="gap-minutes" type="number" min="0" max="60" step="5" value={view.gapMinutes} required>
        </div>
        <div class="hq-field">
          <label for="notice-hours">Notice, in hours</label>
          <input id="notice-hours" name="notice-hours" type="number" min="0" max="168" value={view.noticeHours} required>
        </div>
        <div class="hq-field">
          <label for="days-ahead">Days ahead people can book</label>
          <input id="days-ahead" name="days-ahead" type="number" min="1" max="90" value={view.daysAhead} required>
        </div>
      </div>

      <label class="hours-check"><input type="checkbox" name="portal-open" value="1" checked={view.portalOpen}> <span>Clients can book a call in the portal. Off: they ask for a call, and you answer.</span></label>
      <label class="hours-check"><input type="checkbox" name="public-open" value="1" checked={view.publicOpen}> <span>Anyone can book a call at <strong>/book</strong>, such as a prospect from the website.</span></label>
      <p><button class="hq-button" type="submit">Save</button></p>
    </form>

    <section class="hq-panel" id="days-off" aria-labelledby="hours-off">
      <h2 id="hours-off">Days off</h2>
      <ul zb-if={view.closed.length > 0} class="days-off">
        <zb-each items={view.closed} as="off" key={off.day}>
          <li>
            <span><strong>{off.label}</strong><span zb-if={off.note}> · {off.note}</span></span>
            <form method="post" action="/calls/days-off/open"><input type="hidden" name="day" value={off.day}><button class="hq-button secondary" type="submit" aria-label="Open {off.label} again">Open again</button></form>
          </li>
        </zb-each>
      </ul>
      <p zb-else class="hq-muted">None coming up.</p>
      <form method="post" action="/calls/days-off" class="hq-form-row">
        <div class="hq-field"><label for="off-day">Day</label><input id="off-day" name="day" type="date" required></div>
        <div class="hq-field"><label for="off-note">Note (optional)</label><input id="off-note" name="note" maxlength="100"></div>
        <button class="hq-button secondary" type="submit">Close this day</button>
      </form>
    </section>
  </div>
</hq-booking-hours>
