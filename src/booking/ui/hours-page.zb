<!--
  When calls can be booked: the usual week, painted on the availability
  grid; the call length, the gap after each call, how much notice, how far
  ahead, days off, and whether clients and the public can book. Specific
  weeks are painted on /calls/availability. For managers and admins.
-->
<script>
  'use route /calls/hours'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/status-badge.zb'
  import '../../shared/ui/parts/availability-grid.zb'
  export async function load({ context }) {
    const stop = context.guard()
    if (stop) return stop
    const view = context.booking.setup()
    if (!view.ok) return context.forbidden()
    const weekly = context.booking.weekly()
    const links = context.booking.calendarLinks()
    return { title: 'Hours for calls', view: view.value, weekly: weekly.ok ? weekly.value : { rows: [], columns: [] }, calendars: links.ok ? links.value : { links: [], canAdd: false }, lengths: [15, 20, 30, 45, 60, 90], done: context.notice.done, problem: context.notice.problem }
  }
</script>
<style>
  .hours-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem; margin: 1rem 0; }
  .hours-check { display: flex; gap: 0.5rem; align-items: flex-start; margin: 0.5rem 0; }
  .hours-check input { width: 1.25rem; height: 1.25rem; margin-top: 0.15rem; }
  .days-off { list-style: none; margin: 0 0 1rem; padding: 0; }
  .days-off li { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; padding: 0.4rem 0; border-top: 1px solid var(--border); }
  .days-off form { margin: 0 0 0 auto; }
  .calendar-address { flex: 1 1 18rem; }
  .calendar-address input { width: 100%; }
</style>
<hq-booking-hours view={{ days: [], closed: [] }} weekly={{ rows: [], columns: [] }} calendars={{ links: [], canAdd: false }} lengths={[]} done="" problem="">
  <div class="hq-page">
    <h1>Hours for calls</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <p class="hq-muted">Times are in Eastern time. Calls go on {view.hostName}’s calendar: whoever saves this page. <a href="/calls">Back to Calls</a></p>
    <p class="hq-muted">{view.calendar === 'none' ? 'Open times avoid calls already booked in HQ. To avoid everything else in your calendar too, link it below.' : 'Open times also avoid busy times in ' + view.calendar + '.'}</p>

    <form method="post" action="/calls/hours/week" class="hq-panel" id="usual-week" aria-labelledby="hours-week">
      <h2 id="hours-week">Your usual week</h2>
      <p class="hq-muted">Paint the half hours you’re free for calls. With a mouse, press and drag across the grid; on a phone, tap each half hour. To change one week only, like a holiday week, <a href="/calls/availability">paint that week</a>.</p>
      <availability-grid grid={weekly} caption="Your usual week: each half hour you’re free for calls"></availability-grid>
      <p><button class="hq-button" type="submit">Save my usual week</button></p>
    </form>

    <section class="hq-panel" id="calendars" aria-labelledby="hours-calendars">
      <h2 id="hours-calendars">Your calendars</h2>
      <p class="hq-muted">Link a calendar and its busy times are never offered for calls, and show on <a href="/calls/availability">this week’s grid</a>. HQ reads only when you’re busy, never what the events are. Works with Google Calendar, Outlook and Apple.</p>
      <ul zb-if={calendars.links.length > 0} class="days-off" aria-label="Linked calendars">
        <zb-each items={calendars.links} as="link" key={link.id}>
          <li>
            <span><strong>{link.label}</strong> <span class="hq-muted">{link.site}</span></span>
            <status-badge zb-if={link.problem} variant="danger">{link.problem}</status-badge>
            <status-badge zb-else variant="success">Reading</status-badge>
            <form method="post" action={`/calls/calendar-links/${link.id}/remove`}><button class="hq-button secondary small" type="submit" aria-label={`Remove calendar ${link.label}`}>Remove</button></form>
          </li>
        </zb-each>
      </ul>
      <form zb-if={calendars.canAdd} method="post" action="/calls/calendar-links" class="hq-form-row">
        <div class="hq-field">
          <label for="calendar-label">Name</label>
          <input id="calendar-label" name="label" maxlength="60" placeholder="Personal" autocomplete="off">
        </div>
        <div class="hq-field calendar-address">
          <label for="calendar-link">Private address</label>
          <input id="calendar-link" name="link" type="url" inputmode="url" autocomplete="off" placeholder="https://calendar.google.com/calendar/ical/…/basic.ics" required>
        </div>
        <button class="hq-button secondary" type="submit">Link calendar</button>
      </form>
      <p class="hq-muted hq-small">In Google Calendar: Settings → your calendar → Integrate calendar → “Secret address in iCal format”. In Outlook: Settings → Calendar → Shared calendars → Publish a calendar → ICS. The address is a secret: anyone who has it can read that calendar. HQ never shows it again.</p>
    </section>

    <form method="post" action="/calls/hours" class="hq-panel" aria-labelledby="hours-settings">
      <h2 id="hours-settings">Calls</h2>
      <div class="hours-grid">
        <div class="hq-field">
          <label for="call-minutes">Each call</label>
          <select id="call-minutes" name="call-minutes">
            <zb-each items={lengths} as="minutes" key={minutes}>
              <option value={minutes} selected={minutes === view.callMinutes}>{minutes} minutes</option>
            </zb-each>
          </select>
        </div>
        <div class="hq-field">
          <label for="gap-minutes">Free after each call, in minutes</label>
          <input id="gap-minutes" name="gap-minutes" type="number" min="0" max="60" step="5" value={view.gapMinutes} required>
        </div>
        <div class="hq-field">
          <label for="notice-hours">Notice, in hours</label>
          <input id="notice-hours" name="notice-hours" type="number" min="0" max="168" value={view.noticeHours} required>
        </div>
        <div class="hq-field">
          <label for="days-ahead">Days ahead people can book</label>
          <input id="days-ahead" name="days-ahead" type="number" min="1" max="90" value={view.daysAhead} required>
        </div>
      </div>

      <label class="hours-check"><input type="checkbox" name="portal-open" value="1" checked={view.portalOpen}> <span>Clients can book a call in the portal. Off: they ask for a call, and you answer.</span></label>
      <label class="hours-check"><input type="checkbox" name="public-open" value="1" checked={view.publicOpen}> <span>Anyone can sign up at <strong>/book</strong> and book a call, such as a prospect from the website. They confirm their email and choose a password first, and become a prospect in the CRM. Needs email set up. Once they have an account, they book in the portal like a client.</span></label>
      <p><button class="hq-button" type="submit">Save</button></p>
    </form>

    <section class="hq-panel" id="days-off" aria-labelledby="hours-off">
      <h2 id="hours-off">Days off</h2>
      <ul zb-if={view.closed.length > 0} class="days-off">
        <zb-each items={view.closed} as="off" key={off.day}>
          <li>
            <span><strong>{off.label}</strong><span zb-if={off.note}> · {off.note}</span></span>
            <form method="post" action="/calls/days-off/open"><input type="hidden" name="day" value={off.day}><button class="hq-button secondary" type="submit" aria-label="Open {off.label} again">Open again</button></form>
          </li>
        </zb-each>
      </ul>
      <p zb-else class="hq-muted">None coming up.</p>
      <form method="post" action="/calls/days-off" class="hq-form-row">
        <div class="hq-field"><label for="off-day">Day</label><input id="off-day" name="day" type="date" required></div>
        <div class="hq-field"><label for="off-note">Note (optional)</label><input id="off-note" name="note" maxlength="100"></div>
        <button class="hq-button secondary" type="submit">Close this day</button>
      </form>
    </section>
  </div>
</hq-booking-hours>
