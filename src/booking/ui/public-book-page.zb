<!--
  The booking page for anyone: often a prospect from the website. Booking
  needs a free account now, so this page shows the open times to come and
  sends people to sign up, or to sign in if they have an account. Someone
  already signed in to the portal goes straight to booking there.
-->
<script>
  'use route /book'
  import { redirect } from '@zubra/router'
  import '../../shared/ui/zubra/alert-banner.zb'
  export async function load({ context }) {
    if (context.portal.session) return redirect('/portal/book')
    return { title: 'Book a call with Potomac Solutions', open: context.portal.signUpOpen, problem: context.notice.problem }
  }
</script>
<style>
  .book-steps { margin: 0 0 1.25rem; padding-left: 1.25rem; }
  .book-steps li { margin: 0.3rem 0; }
  .book-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
</style>
<hq-public-book open={false} problem="">
  <h1>Book a call with Potomac Solutions</h1>
  <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
  <div zb-if={!open} class="hq-panel">
    <p>Booking online isn’t open right now. Call or write, below, and we’ll find a time.</p>
    <p>Already a client? <a href="/portal/sign-in">Sign in to your portal</a>.</p>
  </div>
  <div zb-else class="hq-panel">
    <p>A free call about your business and what would help. To book, make a free account: it takes a minute.</p>
    <ol class="book-steps">
      <li>Sign up with your name and email.</li>
      <li>Open the link we email you, and choose a password.</li>
      <li>Choose a time. You can move or cancel it in your portal.</li>
    </ol>
    <p class="book-actions"><a class="hq-button portal-big" href="/portal/sign-up">Sign up to book</a> <a href="/portal/sign-in">I have an account</a></p>
  </div>
</hq-public-book>
