<!--
  Saved replies (quality of life, 2026-11-25): text written once for
  messages and emails, used from "Use a saved reply" beside a message box.
  {first name}, {client}, {project} and {me} are filled in where it's used.
-->
<script>
  'use route /replies'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/empty-state.zb'
  export async function load({ context }) {
    const stop = context.guard()
    if (stop) return stop
    const replies = context.replies()
    if (!replies.can) return context.forbidden()
    return { title: 'Saved replies', items: replies.items, done: context.notice.done, problem: context.notice.problem }
  }
</script>
<style>
  .reply-body { width: 100%; min-height: 6rem; padding: 0.6rem; font: inherit; color: var(--foreground); background: var(--background); border: 1px solid var(--border); border-radius: calc(var(--radius) - 2px); }
  .reply-list { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .reply-list details summary { cursor: pointer; font-weight: 600; }
  .reply-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .reply-actions form { margin: 0; }
</style>
<hq-replies items={[]} done="" problem="">
  <div class="hq-page">
    <h1>Saved replies</h1>
    <p class="hq-muted">Write it once, use it again from <strong>Use a saved reply</strong> beside a message to a client. <code>{'{first name}'}</code>, <code>{'{client}'}</code>, <code>{'{project}'}</code> and <code>{'{me}'}</code> are filled in where it’s used.</p>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <section class="hq-panel" aria-labelledby="replies-list">
      <h2 id="replies-list">{items.length === 1 ? '1 reply' : items.length + ' replies'}</h2>
      <empty-state zb-if={items.length === 0} heading="No saved replies yet">Add the messages you send again and again: a proof is ready, a payment reminder, thanks for the call.</empty-state>
      <ul zb-else class="reply-list">
        <zb-each items={items} as="reply" key={reply.id}>
          <li>
            <details>
              <summary>{reply.title}</summary>
              <form method="post" action="/replies/{reply.id}" class="hq-form" data-spaced>
                <label for={'reply-title-' + reply.id}>Title</label>
                <input id={'reply-title-' + reply.id} name="title" value={reply.title} required maxlength="80">
                <label for={'reply-body-' + reply.id}>Reply</label>
                <textarea id={'reply-body-' + reply.id} class="reply-body" name="body" required maxlength="5000">{reply.body}</textarea>
                <div class="reply-actions"><button class="hq-button" type="submit">Save<span class="sr-only">: {reply.title}</span></button></div>
              </form>
              <form method="post" action="/replies/{reply.id}/remove" data-spaced><button class="hq-button secondary small" type="submit">Remove<span class="sr-only">: {reply.title}</span></button></form>
            </details>
          </li>
        </zb-each>
      </ul>
    </section>
    <section class="hq-panel" aria-labelledby="replies-add">
      <h2 id="replies-add">Add one</h2>
      <form method="post" action="/replies" class="hq-form">
        <label for="reply-title">Title</label>
        <input id="reply-title" name="title" required maxlength="80" placeholder="Proof ready">
        <label for="reply-body">Reply</label>
        <textarea id="reply-body" class="reply-body" name="body" required maxlength="5000" placeholder={'Hi {first name}, the proof for {project} is ready in your portal. Let me know what you think! {me}'}></textarea>
        <div><button class="hq-button" type="submit">Add</button></div>
      </form>
    </section>
  </div>
</hq-replies>
