<!--
  The portal's sign-in form. Shown at /portal/sign-in, and in place of any
  portal page when nobody is signed in.
-->
<script>
  'use route /portal/sign-in'
  import { redirect } from '@zubra/router'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/text-field.zb'
  export async function load({ context }) {
    if (context.portal.session) return redirect('/portal')
    return { title: 'Sign in', signUp: context.portal.signUpOpen, done: context.notice.done, problem: context.notice.problem }
  }
</script>
<style>
  :host { display: block; max-width: 26rem; }
</style>
<hq-portal-sign-in sign-up={false} done="" problem="">
  <div class="hq-page">
    <h1>Sign in to your client portal</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <form method="post" action="/portal/sign-in" class="hq-form hq-panel">
      <text-field label="Email" name="email" type="email" autocomplete="username" required={true}></text-field>
      <text-field label="Password" name="password" type="password" autocomplete="current-password" required={true}></text-field>
      <div><button class="hq-button portal-big" type="submit">Sign in</button></div>
    </form>
    <details class="hq-panel" open={false}>
      <summary>Forgot your password, or rather not type one?</summary>
      <form method="post" action="/portal/sign-in-link" class="hq-form" data-spaced>
        <text-field label="Your email" name="email" type="email" autocomplete="email" required={true} description="We’ll email you a link to sign in. It works once, for a week."></text-field>
        <div><button class="hq-button secondary" type="submit">Email me a link</button></div>
      </form>
    </details>
    <p zb-if={signUp}>New here? <a href="/portal/sign-up">Sign up to book a call</a>.</p>
  </div>
</hq-portal-sign-in>
