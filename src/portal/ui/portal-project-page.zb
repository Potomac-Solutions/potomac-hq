<!--
  One of a client's own projects: where it stands and its steps, what has
  been shared with them to approve, files they send in, and updates.
-->
<script>
  'use route /portal/projects/:id'
  import { notFound } from '@zubra/router'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/empty-state.zb'
  export async function load({ context, params }) {
    const stop = context.portal.guard()
    if (stop) return stop
    const view = context.portal.project(params.id)
    if (!view.ok) return notFound()
    return { title: view.value.project.name, view: view.value, done: context.notice.done, problem: context.notice.problem }
  }
  const p = view.project
</script>
<hq-portal-project view={{ project: {}, progress: {}, steps: [], deliverables: [], updates: [], files: [] }} done="" problem="">
  <div class="hq-page">
    <p class="hq-crumbs"><a href="/portal">Back to your portal</a></p>
    <h1>{p.name}</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>

    <section class="hq-panel" aria-labelledby="pp-progress">
      <h2 id="pp-progress">Where it stands</h2>
      <p><span class="hq-tag" data-tone={p.tone}>{p.standing}</span><span zb-if={view.next}> Next: {view.next}</span></p>
      <p zb-if={p.target}>Planned finish: {p.target}</p>
      <p zb-if={p.description} class="hq-prose">{p.description}</p>
      <p zb-if={view.billableHours} class="hq-muted">Billable hours so far: {view.billableHours}</p>
      <p zb-if={view.progress.total > 0} class="portal-progress" data-spaced><progress max={view.progress.total} value={view.progress.done} aria-label="Steps done"></progress> <span class="hq-muted">{view.progress.text}</span></p>
      <ol zb-if={view.steps.length > 0} class="portal-steps">
        <zb-each items={view.steps} as="step" key={step.id}>
          <li data-done={step.done ? "yes" : "no"}>
            <span class="portal-mark" aria-hidden="true">{step.done ? "✓" : ""}</span>
            <span><strong>{step.name}</strong> <span zb-if={step.yours} class="hq-tag" data-tone="warn">Yours to do</span><span class="sr-only">{step.done ? " (done)" : " (not done yet)"}</span><br><span class={step.overdue ? "portal-late" : "hq-muted"}>{step.when}</span></span>
          </li>
        </zb-each>
      </ol>
    </section>

    <section class="hq-panel" id="deliverables" aria-labelledby="pp-deliverables">
      <h2 id="pp-deliverables">For you to look at</h2>
      <empty-state zb-if={view.deliverables.length === 0} heading="Nothing yet">Designs and documents appear here when they are ready for you.</empty-state>
      <ul zb-else class="portal-cards">
        <zb-each items={view.deliverables} as="item" key={item.id}>
          <li class="portal-stack">
            <div>
              <p><strong>{item.title}</strong></p>
              <p zb-if={item.description} class="hq-muted">{item.description}</p>
              <p>{item.statusLabel}<span zb-if={item.decisionNote}>: “{item.decisionNote}”</span></p>
            </div>
            <p zb-if={item.isImage}><a href="/portal/files/{item.fileId}" aria-label="Open {item.fileName} at full size"><img class="portal-preview" src="/portal/files/{item.fileId}" alt="{item.title}" loading="lazy"></a></p>
            <p><a class="hq-button secondary portal-big" href="/portal/files/{item.fileId}">Open {item.fileName}</a></p>
            <div zb-if={item.awaiting} class="portal-decide">
              <form method="post" action="/portal/deliverables/{item.id}/decision">
                <input type="hidden" name="projectId" value={p.id}>
                <input type="hidden" name="decision" value="approved">
                <p class="hq-muted">Happy with it?</p>
                <button class="hq-button portal-big" type="submit" aria-label="Approve: {item.title}">Approve</button>
              </form>
              <form method="post" action="/portal/deliverables/{item.id}/decision" class="hq-form">
                <input type="hidden" name="projectId" value={p.id}>
                <input type="hidden" name="decision" value="changes-requested">
                <div class="hq-field">
                  <label for="changes-{item.id}">Or, what should change in {item.title}?</label>
                  <textarea id="changes-{item.id}" name="note" rows="3" required maxlength="2000"></textarea>
                </div>
                <div><button class="hq-button secondary portal-big" type="submit" aria-label="Ask for changes: {item.title}">Ask for changes</button></div>
              </form>
            </div>
          </li>
        </zb-each>
      </ul>
    </section>

    <section class="hq-panel" id="files" aria-labelledby="pp-files">
      <h2 id="pp-files">Send us a file</h2>
      <p class="hq-muted">Photos, your logo, a menu, a price list: anything the work needs from you.</p>
      <ul zb-if={view.files.length > 0} class="hq-list" data-spaced>
        <zb-each items={view.files} as="file" key={file.id}>
          <li><a href="/portal/files/{file.id}">{file.name}</a> <span class="hq-muted">{file.size} · sent by {file.who}, <time datetime={file.whenIso}>{file.when}</time></span></li>
        </zb-each>
      </ul>
      <form zb-if={p.open} method="post" action="/portal/projects/{p.id}/files" enctype="multipart/form-data" class="hq-form" data-spaced>
        <div class="hq-field">
          <label for="pp-file">Choose a file, or take a photo</label>
          <input id="pp-file" name="file" type="file" required aria-describedby="pp-file-rules">
          <p id="pp-file-rules" class="hq-muted hq-small">{view.fileRules} One at a time.</p>
        </div>
        <div><button class="hq-button portal-big" type="submit">Send file</button></div>
      </form>
      <p zb-else class="hq-muted" data-spaced>This project is finished, so files can’t be added to it.</p>
    </section>

    <section class="hq-panel" id="updates" aria-labelledby="pp-updates">
      <h2 id="pp-updates">Updates and messages</h2>
      <p zb-if={view.updates.length === 0} class="hq-muted">No updates yet.</p>
      <ol zb-else class="hq-notes">
        <zb-each items={view.updates} as="update" key={update.id}>
          <li><p class="hq-prose">{update.body}</p><p class="hq-muted hq-small">{update.fromClient ? "You: " + update.authorName : update.authorName}, <time datetime={update.whenIso}>{update.when}</time></p></li>
        </zb-each>
      </ol>
      <form method="post" action="/portal/projects/{p.id}/messages" class="hq-form" data-spaced>
        <div class="hq-field">
          <label for="pp-message">Send a message, or ask for a change</label>
          <textarea id="pp-message" name="body" rows="4" required maxlength="5000"></textarea>
        </div>
        <div><button class="hq-button portal-big" type="submit">Send message</button></div>
      </form>
    </section>
  </div>
</hq-portal-project>
