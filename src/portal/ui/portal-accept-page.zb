<!--
  Where a one-time link lands: the person chooses their password. The link is
  checked without being used, so opening the page twice does not spend it.
-->
<script>
  'use route /portal/accept'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/text-field.zb'
  export async function load({ context, url }) {
    const link = context.portal.link(url.searchParams.get('token') ?? '')
    return { title: 'Choose your password', link, next: url.searchParams.get('next') === 'book' ? 'book' : '', done: context.notice.done, problem: context.notice.problem }
  }
</script>
<style>
  :host { display: block; max-width: 26rem; }
</style>
<hq-portal-accept link={{ valid: false }} next="" done="" problem="">
  <div class="hq-page">
    <h1>{link.valid && link.invite ? "Welcome to your client portal" : "Choose a new password"}</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <alert-banner zb-if={!link.valid} variant="danger" heading="This link can’t be used">It has expired or been used already. Ask Potomac Solutions for a new one.</alert-banner>
    <form zb-else method="post" action="/portal/accept" class="hq-form hq-panel">
      <input type="hidden" name="token" value={link.token}>
      <input zb-if={next} type="hidden" name="next" value={next}>
      <p>For <strong>{link.email}</strong>.</p>
      <text-field zb-if={link.invite} label="Your name" name="name" value={link.name} autocomplete="name" required={true}></text-field>
      <text-field label="Choose a password" name="password" type="password" autocomplete="new-password" minlength={10} required={true} description="At least 10 characters."></text-field>
      <div><button class="hq-button portal-big" type="submit">Save and sign in</button></div>
    </form>
  </div>
</hq-portal-accept>
