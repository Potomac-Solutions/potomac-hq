<!--
  A client's home in the portal. First, anything they are being waited on
  for. Then their projects, the latest from Potomac, a way to write back,
  proposals, invoices with how to pay, and asking for a call.
-->
<script>
  'use route /portal'
  import '../../shared/ui/zubra/status-badge.zb'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/empty-state.zb'
  import '../../shared/ui/zubra/text-field.zb'
  export async function load({ context }) {
    const stop = context.portal.guard()
    if (stop) return stop
    const home = context.portal.home()
    const picks = context.booking.invitesForMe().map((invite) => ({ key: 'i-' + invite.id, text: 'Pick times for a call: ' + invite.title, detail: invite.length + ', ' + invite.days + (invite.answered ? '. You picked times; Potomac Solutions will confirm one.' : '. Mark every time you could do.'), href: '/portal/invites/' + invite.id, action: invite.answered ? 'Change times' : 'Pick times' }))
    const website = context.websites.mine()
    const landing = context.freePages.mine()
    const reports = context.clientReports.portalList()
    const automations = context.automations.mine()
    const review = context.showcase.mayWrite()
    const referrals = context.referralCredit.mine()
    // Changes Potomac sent back come first: the client is the one being waited on.
    const fixes = website && website.note ? [{ key: 'w-note', text: 'Your website changes need another look', detail: website.note, href: '/portal/website', action: 'Open' }] : []
    return { title: 'Your portal', rate: context.feedback.waiting(), intakeSent: context.intake.portal().sent, openAsks: context.requests.portal().items.filter((one) => one.open).length, cardPay: context.cardPay.ready(), landing, reports, automations, review, referrals, renewals: context.renewals.mine(), website, social: context.social.mine(''), view: { ...home, attention: [...fixes, ...context.social.waitingOnMe(), ...picks, ...home.attention] }, booking: context.booking.portal(), contact: context.portal.contact, emails: context.portal.notices, done: context.notice.done, problem: context.notice.problem }
  }
</script>
<style>
  .portal-rate fieldset { border: 0; padding: 0; margin: 0 0 1rem; display: grid; gap: 0.5rem; }
  .portal-rate legend { font-weight: 600; margin-bottom: 0.5rem; }
  .portal-rate-buttons { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .portal-rate-buttons .hq-button { min-width: 3rem; justify-content: center; }
</style>
<hq-portal-home view={{ attention: [], projects: [], latest: [], messageProjects: [], proposals: [], invoices: [], calls: [], payInstructions: '', paymentYears: [] }} card-pay={{ on: false, test: false, label: '' }} open-asks={0} intake-sent="" rate={[]} website={null} landing={null} reports={[]} automations={[]} review={false} referrals={null} social={null} renewals={[]} booking={{ open: false, calls: [] }} contact={{}} emails={false} done="" problem="">
  <div class="hq-page">
    <h1>{view.organizationName}</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>

    <section class="hq-panel portal-todo" aria-labelledby="portal-attention">
      <h2 id="portal-attention">{view.attention.length === 0 ? "Nothing is waiting on you" : view.attention.length === 1 ? "1 thing is waiting on you" : view.attention.length + " things are waiting on you"}</h2>
      <p zb-if={view.attention.length === 0} class="hq-muted">When Potomac Solutions needs a decision, an answer or a payment from you, it shows here first.</p>
      <ul zb-else class="portal-cards">
        <zb-each items={view.attention} as="item" key={item.key}>
          <li>
            <div><strong>{item.text}</strong><p class="hq-muted">{item.detail}</p></div>
            <a class="hq-button portal-big" href={item.href}>{item.action}<span class="sr-only">: {item.text}</span></a>
          </li>
        </zb-each>
      </ul>
    </section>

    <section class="hq-panel" aria-labelledby="portal-projects">
      <h2 id="portal-projects">Your projects</h2>
      <empty-state zb-if={view.projects.length === 0} heading="No projects yet">When work starts, you can follow it here.</empty-state>
      <ul zb-else class="portal-cards">
        <zb-each items={view.projects} as="project" key={project.id}>
          <li>
            <div>
              <p><a class="portal-title" href="/portal/projects/{project.id}">{project.name}</a> <status-badge variant={project.tone === 'warn' ? 'warning' : project.tone === 'ok' ? 'success' : 'neutral'}>{project.standing}</status-badge></p>
              <p zb-if={project.next}>Next: {project.next}</p>
              <p zb-if={project.total > 0} class="portal-progress"><progress max={project.total} value={project.done} aria-label="Steps done on {project.name}"></progress> <span class="hq-muted">{project.steps}</span></p>
            </div>
          </li>
        </zb-each>
      </ul>
    </section>

    <section zb-if={referrals && referrals.link} class="hq-panel" id="refer" aria-labelledby="portal-refer">
      <h2 id="portal-refer">Send a friend our way</h2>
      <p>Know a business that could use a hand? Share your link. When someone you send becomes a client and pays their first invoice, you get {referrals.creditEach} off your next one.</p>
      <p><strong class="hq-nowrap">{referrals.link.address}</strong></p>
      <p zb-if={referrals.availableMinor > 0}>You have <strong>{referrals.available}</strong> of credit waiting. Thank you!</p>
    </section>
    <section zb-if={review && view.projects.length > 0} class="hq-panel" id="review" aria-labelledby="portal-review">
      <h2 id="portal-review">How did we do?</h2>
      <p>A few honest words help other small businesses decide, and help us do better.</p>
      <a class="hq-button portal-big" href="/portal/review">Write a review</a>
    </section>
    <section zb-if={automations.length > 0} class="hq-panel" id="automations" aria-labelledby="portal-automations">
      <h2 id="portal-automations">Your automations</h2>
      <ul>
        <zb-each items={automations} as="one" key={one.name}><li><strong>{one.name}</strong>: {one.status}<span zb-if={one.lastRun}>, last ran {one.lastRun}</span>. <span class="hq-muted">{one.every}.</span><span zb-if={one.description}><br>{one.description}</span></li></zb-each>
      </ul>
    </section>
    <section zb-if={reports.length > 0} class="hq-panel" id="reports" aria-labelledby="portal-reports">
      <h2 id="portal-reports">Your monthly reports</h2>
      <ul>
        <zb-each items={reports.slice(0, 6)} as="report" key={report.id}><li><a href="/portal/reports/{report.id}">{report.monthText}</a></li></zb-each>
      </ul>
    </section>
    <section zb-if={landing && (landing.exists || !website)} class="hq-panel" id="landing-page" aria-labelledby="portal-landing">
      <h2 id="portal-landing">Your free landing page</h2>
      <p zb-if={landing.exists}>{landing.statusLabel}<span zb-if={landing.address}>: <a href={landing.address} rel="noopener noreferrer">{landing.address}</a></span>. {landing.used}.</p>
      <p zb-if={landing.domainText}>{landing.domainText} <a href="#renewals">What’s coming up</a></p>
      <p zb-else>A one-page website for your business, free for good.</p>
      <a class="hq-button portal-big" href="/portal/landing-page">{landing.exists ? 'Open your landing page' : 'Ask for your free page'}</a>
    </section>
    <section zb-if={website} class="hq-panel" id="website" aria-labelledby="portal-website">
      <h2 id="portal-website">Your website</h2>
      <ul class="portal-cards">
        <li>
          <div>
            <p><strong>{website.name}</strong></p>
            <p>{website.status.summary}</p>
            <p class="hq-muted">{website.state === 'submitted' ? 'Your changes are with Potomac Solutions to check.' : website.state === 'editing' ? 'You have changes you haven’t sent yet.' : website.hasGallery ? 'Change the photos, post a notice, or add a review.' : website.serviceArea ? 'Change where you go, on the map.' : 'Open it, or close it for a while.'}</p>
          </div>
          <a class="hq-button portal-big" href="/portal/website">Update your website</a>
        </li>
      </ul>
    </section>

    <section zb-if={social} class="hq-panel" id="social" aria-labelledby="portal-social">
      <h2 id="portal-social">Your social media</h2>
      <ul class="portal-cards">
        <li>
          <div>
            <p><strong>{social.summary}</strong></p>
            <p class="hq-muted">{social.waiting > 0 ? 'Posts for ' + social.monthName + ' are waiting for you to look over.' : 'See this month’s posts, and the ones already up.'}</p>
          </div>
          <a class="hq-button portal-big" href="/portal/social">See your posts</a>
        </li>
      </ul>
    </section>

    <section zb-if={view.latest.length > 0} class="hq-panel" aria-labelledby="portal-latest">
      <h2 id="portal-latest">Latest from Potomac Solutions</h2>
      <ol class="hq-notes">
        <zb-each items={view.latest} as="update" key={update.id}>
          <li><p class="hq-prose">{update.body}</p><p class="hq-muted hq-small">{update.who} on <a href="/portal/projects/{update.projectId}#updates">{update.projectName}</a>, <time datetime={update.whenIso}>{update.when}</time></p></li>
        </zb-each>
      </ol>
    </section>

    <section zb-if={rate.length > 0} class="hq-panel" id="feedback" aria-labelledby="portal-feedback">
      <h2 id="portal-feedback">Rate a finished project</h2>
      <zb-each items={rate} as="one" key={one.id}>
        <form method="post" action="/portal/projects/{one.id}/feedback" class="portal-rate">
          <fieldset>
            <legend>“{one.name}” is finished. How did it go?</legend>
            <div class="portal-rate-buttons">
              <button class="hq-button secondary" type="submit" name="score" value="1">1<span class="sr-only"> of 5, poor</span></button>
              <button class="hq-button secondary" type="submit" name="score" value="2">2<span class="sr-only"> of 5, not great</span></button>
              <button class="hq-button secondary" type="submit" name="score" value="3">3<span class="sr-only"> of 5, okay</span></button>
              <button class="hq-button secondary" type="submit" name="score" value="4">4<span class="sr-only"> of 5, good</span></button>
              <button class="hq-button secondary" type="submit" name="score" value="5">5<span class="sr-only"> of 5, great</span></button>
            </div>
            <p class="hq-small hq-muted" aria-hidden="true">1 is poor, 5 is great.</p>
            <label class="hq-small" for={'rate-note-' + one.id}>Anything to add? (optional, only we see it)</label>
            <textarea id={'rate-note-' + one.id} name="note" rows="2" maxlength="1000"></textarea>
          </fieldset>
        </form>
      </zb-each>
    </section>
    <section class="hq-panel" id="intake" aria-labelledby="portal-intake">
      <h2 id="portal-intake">About your business</h2>
      <p zb-if={intakeSent}>You told us about your business {intakeSent}. <a href="/portal/intake">See or change it</a>.</p>
      <div zb-else>
        <p>Your name, hours, colors, logo and the accounts we’ll need, in one place, so we don’t have to ask over a week of emails.</p>
        <p><a class="hq-button portal-big" href="/portal/intake">Tell us about your business</a></p>
      </div>
    </section>
    <section class="hq-panel" id="ask" aria-labelledby="portal-ask">
      <h2 id="portal-ask">Need something changed?</h2>
      <p>Ask for a change, a fix or something new, and follow it until it’s done.<span zb-if={openAsks > 0}> You have {openAsks} open.</span></p>
      <p><a class="hq-button portal-big" href="/portal/requests">Ask for something</a></p>
    </section>
    <section zb-if={view.messageProjects.length > 0} class="hq-panel" id="message" aria-labelledby="portal-message">
      <h2 id="portal-message">Send a message</h2>
      <form method="post" action="/portal/messages" class="hq-form">
        <input zb-if={view.messageProjects.length === 1} type="hidden" name="projectId" value={view.messageProjects[0].id}>
        <div zb-else class="hq-field">
          <label for="portal-message-project">Which project is it about?</label>
          <select id="portal-message-project" name="projectId">
            <zb-each items={view.messageProjects} as="project" key={project.id}><option value={project.id}>{project.name}</option></zb-each>
          </select>
        </div>
        <div class="hq-field">
          <label for="portal-message-body">A question, a change, or something we should know</label>
          <textarea id="portal-message-body" name="body" rows="4" required maxlength="5000"></textarea>
        </div>
        <div><button class="hq-button portal-big" type="submit">Send message</button></div>
      </form>
      <p class="hq-muted hq-small" data-spaced>To send photos or a document, open the project and use “Send us a file”.</p>
    </section>

    <section zb-if={view.proposals.length > 0} class="hq-panel" aria-labelledby="portal-proposals">
      <h2 id="portal-proposals">Proposals</h2>
      <ul class="portal-cards">
        <zb-each items={view.proposals} as="proposal" key={proposal.id}>
          <li><div><a class="portal-title" href="/portal/proposals/{proposal.id}">{proposal.title}</a><p class="hq-muted">{proposal.waiting ? "Waiting for your answer" : proposal.statusLabel}</p></div></li>
        </zb-each>
      </ul>
    </section>

    <section zb-if={renewals.length > 0} class="hq-panel" id="renewals" aria-labelledby="portal-renewals">
      <h2 id="portal-renewals">Coming up for renewal</h2>
      <p class="hq-muted">What your website depends on that runs out on a date, which we renew for you. We ask for payment a week before, so we know whether to renew it or let it go.</p>
      <ul class="portal-cards">
        <zb-each items={renewals} as="one" key={one.id}>
          <li>
            <div>
              <p><strong>{one.name}</strong> · {one.kindLabel}</p>
              <p>Renews <time datetime={one.renewsOn}>{one.renews}</time>. {one.price}.</p>
              <p zb-if={one.priceNote}><strong>{one.priceNote}</strong></p>
              <p class={one.state === 'late' ? '' : 'hq-muted'}>{one.say}</p>
            </div>
            <a zb-if={one.owing} class="hq-button portal-big" href="#invoices">How to pay</a>
            <div zb-if={one.canAnswer} class="hq-form-row">
              <form zb-if={one.answer !== 'renew'} method="post" action="/portal/renewals/{one.id}/answer"><input type="hidden" name="choice" value="renew"><button class={one.answer === 'lapse' ? 'hq-button portal-big' : 'hq-button secondary portal-big'} type="submit">Renew it<span class="sr-only">: {one.name}</span></button></form>
              <form zb-if={one.answer !== 'lapse'} method="post" action="/portal/renewals/{one.id}/answer"><input type="hidden" name="choice" value="lapse"><button class="hq-button secondary portal-big" type="submit">Let it lapse<span class="sr-only">: {one.name}</span></button></form>
            </div>
          </li>
        </zb-each>
      </ul>
    </section>

    <section zb-if={view.invoices.length > 0} class="hq-panel" id="invoices" aria-labelledby="portal-invoices">
      <h2 id="portal-invoices">Invoices</h2>
      <p zb-if={view.owedTotal} class="portal-owed">You owe <strong>{view.owedTotal}</strong> in all.</p>
      <p zb-else class="hq-muted">Everything is paid. Thank you.</p>
      <ul class="portal-cards">
        <zb-each items={view.invoices} as="invoice" key={invoice.id}>
          <li>
            <div>
              <p><strong>{invoice.label}</strong><span zb-if={invoice.projectName}> · {invoice.projectName}</span></p>
              <p zb-if={invoice.paid} class="hq-muted">{invoice.statusLabel}. {invoice.total}</p>
              <p zb-else>{invoice.owed} owed<span zb-if={invoice.owed !== invoice.total}> of {invoice.total}</span><span zb-if={invoice.due}>. {invoice.due}</span></p>
            </div>
            <div class="hq-form-row">
              <form zb-if={cardPay.on && !invoice.paid} method="post" action="/portal/invoices/{invoice.id}/pay"><button class="hq-button portal-big" type="submit">Pay by card<span class="sr-only">: {invoice.label}</span></button></form>
              <a zb-if={!cardPay.on && invoice.payLink} class="hq-button portal-big" href={invoice.payLink} rel="noopener noreferrer" target="_blank">Pay by card<span class="sr-only">: {invoice.label}</span></a>
              <a class="hq-button secondary portal-big" href="/portal/invoices/{invoice.id}/pdf" aria-label="Download invoice {invoice.label} as a PDF">Download</a>
            </div>
          </li>
        </zb-each>
      </ul>
      <div zb-if={view.owedTotal} class="portal-pay" data-spaced>
        <h3>How to pay</h3>
        <p zb-if={view.payInstructions} class="hq-prose">{view.payInstructions}</p>
        <div zb-else>
          <p>By check made out to <strong>Potomac Solutions</strong>, or in cash. Write the invoice number on the check.</p>
          <p zb-if={contact.address}>Mail it to: <strong>{contact.address}</strong></p>
        </div>
        <p zb-if={cardPay.on && cardPay.test} class="hq-muted hq-small">“Pay by card” is in test mode: no money moves.</p>
        <p zb-if={cardPay.on && !cardPay.test} class="hq-muted hq-small">“Pay by card” takes you to {cardPay.label}’s secure page to pay. Potomac Solutions never sees your card number.</p>
        <p zb-if={!cardPay.on} class="hq-muted hq-small">Where an invoice has “Pay by card”, that button takes you to pay it by card.</p>
      </div>
      <p zb-if={view.paymentYears.length > 0} class="hq-small" data-spaced>For your taxes or bookkeeper, what you paid us in <zb-each items={view.paymentYears} as="year" key={year}><a href="/portal/payments.csv?year={year}" download>{year}</a> </zb-each>(a spreadsheet file).</p>
    </section>

    <section class="hq-panel" id="calls" aria-labelledby="portal-calls">
      <h2 id="portal-calls">{booking.open ? 'Calls' : 'Ask for a call'}</h2>
      <ul zb-if={booking.calls.length > 0} class="portal-cards" data-gap>
        <zb-each items={booking.calls} as="call" key={call.id}>
          <li>
            <div>
              <p><strong><time datetime={call.whenIso}>{call.when}</time></strong><span zb-if={call.cancelled}>: cancelled</span></p>
              <p zb-if={call.topic}>{call.topic}</p>
              <p zb-if={call.cancelled} class="hq-muted">{call.cancelText}</p>
              <p zb-if={!call.cancelled}><a href="/portal/calls/{call.id}.ics">Add to your calendar</a><span zb-if={call.changeable}> · <a href="/portal/book?move={call.id}">Move it</a></span></p>
              <details zb-if={call.changeable}>
                <summary>Cancel this call</summary>
                <form method="post" action="/portal/calls/{call.id}/cancel" class="hq-form">
                  <text-field label="Why?" name="reason"></text-field>
                  <div><button class="hq-button secondary" type="submit">Cancel the call</button></div>
                </form>
              </details>
            </div>
          </li>
        </zb-each>
      </ul>
      <p zb-if={booking.open}><a class="hq-button portal-big" href="/portal/book">Book a call</a></p>
      <h3 zb-if={booking.open}>Or ask for a call</h3>
      <p zb-if={booking.open} class="hq-muted">If none of the times suit you, say when does, and Potomac Solutions will confirm a time.</p>
      <ul zb-if={view.calls.length > 0} class="portal-cards" data-gap>
        <zb-each items={view.calls} as="call" key={call.id}>
          <li>
            <div>
              <p>You asked for: {call.wanted}<span zb-if={call.phone}>, on {call.phone}</span></p>
              <p><strong zb-if={call.status === "confirmed"}>Confirmed for {call.confirmedFor}</strong><span zb-if={call.status === "requested"} class="hq-muted">Waiting for Potomac Solutions</span><span zb-if={call.status === "declined"}>Not possible</span><span zb-if={call.reply}>. “{call.reply}”</span></p>
            </div>
          </li>
        </zb-each>
      </ul>
      <form method="post" action="/portal/calls" class="hq-form">
        <text-field label="When is a good time to call you?" name="wanted" required={true} description="In your own words. Like: weekdays before 10, after dark, or Monday when we’re closed"></text-field>
        <text-field label="The best number to reach you" name="phone" type="tel" autocomplete="tel" description="If it’s different from the one Potomac Solutions already has"></text-field>
        <text-field label="What about?" name="note" rows={2}></text-field>
        <div><button class="hq-button portal-big" type="submit">Ask for a call</button></div>
      </form>
    </section>

    <section zb-if={emails} class="hq-panel" id="notices" aria-labelledby="portal-notices">
      <h2 id="portal-notices">Emails from this portal</h2>
      <p>{view.notices ? "You get an email when something is waiting for you here. It never includes prices or files, only that there is something to see." : "You are not emailed when something is waiting. Check back here to see what is new."}</p>
      <form method="post" action="/portal/notices">
        <input type="hidden" name="on" value={view.notices ? "0" : "1"}>
        <button class="hq-button secondary portal-big" type="submit">{view.notices ? "Stop these emails" : "Email me when something is waiting"}</button>
      </form>
    </section>

    <p zb-if={view.people} class="hq-muted hq-small portal-people">Who can sign in for {view.organizationName}: {view.people}. To add or remove someone, ask Potomac Solutions.</p>
  </div>
</hq-portal-home>
