<!--
  A proposal shared with the client: the latest version that was sent, and
  the form where they accept or decline by typing their name.
-->
<script>
  'use route /portal/proposals/:id'
  import '../../shared/ui/zubra/alert-banner.zb'
  import '../../shared/ui/zubra/text-field.zb'
  export async function load({ context, params }) {
    const stop = context.portal.guard()
    if (stop) return stop
    const view = context.portal.proposal(params.id)
    if (!view.ok) return context.portal.missing()
    return { title: view.value.document.title, view: view.value, done: context.notice.done, problem: context.notice.problem }
  }
  const doc = view.document
</script>
<style>
  .paper h2 { margin-top: 1.25rem; }
  .paper ul { margin: 0.25rem 0; padding-left: 1.25rem; }
  .paper p { margin: 0.35rem 0; }
  .paper table { font-size: 0.95rem; }
</style>
<hq-portal-proposal view={{ document: { sections: [], lines: [], summary: {} } }} done="" problem="">
  <div class="hq-page">
    <p class="hq-crumbs"><a href="/portal">Back to your portal</a></p>
    <h1>{doc.title}</h1>
    <div zb-if={done || problem} class="hq-notices">
      <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      <alert-banner zb-if={done} variant="success">{done}</alert-banner>
    </div>
    <p><strong>{view.statusLabel}</strong><span zb-if={view.answered}>. {view.answered}</span></p>

    <section class="hq-panel portal-todo" aria-labelledby="pprop-cost">
      <h2 id="pprop-cost">What it costs</h2>
      <dl class="portal-figures">
        <div><dt>Total</dt><dd>{doc.summary.price}</dd></div>
        <div zb-if={doc.summary.deposit}><dt>To start</dt><dd>{doc.summary.deposit}</dd></div>
        <div zb-if={doc.summary.deposit}><dt>Before launch</dt><dd>{doc.summary.balance}</dd></div>
      </dl>
      <p class="portal-links"><a zb-if={view.canAnswer} class="hq-button portal-big" href="#pprop-answer">Go to your answer</a> <a class="hq-button secondary portal-big" href="/portal/proposals/{doc.proposalId}/pdf">Download as a PDF</a></p>
    </section>

    <article class="hq-panel paper">
      <p class="hq-muted">From Potomac Solutions. Version {doc.number}, sent {doc.sentWhen}.</p>
      <zb-each items={doc.sections} as="section" key={section.heading}>
        <section>
          <h2>{section.heading}</h2>
          <zb-each items={section.blocks} as="block" key={block.key}>
            <ul zb-if={block.bullet}><li>{block.text}</li></ul>
            <p zb-else>{block.text}</p>
          </zb-each>
        </section>
      </zb-each>
      <h2 id="pprop-estimate">Estimate</h2>
      <table tabindex="0" class="hq-table" aria-labelledby="pprop-estimate">
        <thead><tr><th scope="col">Item</th><th scope="col" class="hq-number">Amount</th><th scope="col" class="hq-number">Rate</th><th scope="col" class="hq-number">Total</th></tr></thead>
        <tbody>
          <zb-each items={doc.lines} as="line" key={line.key}><tr><td>{line.item}</td><td class="hq-number">{line.quantityLabel}</td><td class="hq-number">{line.rate}</td><td class="hq-number">{line.total}</td></tr></zb-each>
        </tbody>
        <tfoot><tr><th scope="row">Total</th><td></td><td></td><td class="hq-number"><strong>{doc.summary.price}</strong></td></tr></tfoot>
      </table>
      <p zb-if={doc.summary.deposit}>A deposit of {doc.summary.deposit}, one third of the total, is due before work starts. The balance of {doc.summary.balance} is due before launch.</p>
    </article>

    <section zb-if={view.canAnswer} class="hq-panel" aria-labelledby="pprop-answer">
      <h2 id="pprop-answer">Your answer</h2>
      <form method="post" action="/portal/proposals/{doc.proposalId}/answer" class="hq-form">
        <fieldset class="hq-choice">
          <legend>What is your answer to version {doc.number}?</legend>
          <label class="hq-check"><input type="radio" name="decision" value="accepted" required> I accept this proposal</label>
          <label class="hq-check"><input type="radio" name="decision" value="declined" required> I decline</label>
        </fieldset>
        <text-field label="Type your full name" name="typedName" autocomplete="name" required={true} description="Typing your name here is your signature on this answer. It is recorded with today’s date and this version."></text-field>
        <div><button class="hq-button portal-big" type="submit">Send my answer</button></div>
      </form>
      <div class="portal-pay" data-spaced>
        <h3>What happens next</h3>
        <p>If you accept, Potomac Solutions sends an invoice<span zb-if={doc.summary.deposit}> for the {doc.summary.deposit} to start</span>. Work begins when it is paid, and you can follow it here.</p>
        <p>If you decline, nothing is owed. Not sure yet? Go back to your portal and send a message or ask for a call.</p>
      </div>
    </section>
  </div>
</hq-portal-proposal>
