# Copy to .env for local use. Never commit a real .env.
HQ_DATABASE_PATH=data/hq.db
# At least 32 characters. Generate one with: openssl rand -base64 32
HQ_NOTICE_SECRET=
# "true" when served over https. Leave unset locally.
HQ_SECURE=
# Trusted proxies in front: 1 on Railway, 0 locally.
HQ_PROXIES=0
# The address people use. Printed in setup and reset links.
HQ_PUBLIC_URL=http://localhost:3000
# A writable folder for compiled pages, inside the app's folder. Optional locally.
HQ_CACHE_DIR=
# Outbound email through Brevo: reset links, invites and error alerts.
# HQ_EMAIL_FROM must be a sending address verified in Brevo. Links use
# HQ_PUBLIC_URL (https).
HQ_BREVO_API_KEY=
HQ_EMAIL_FROM=
HQ_EMAIL_FROM_NAME=Potomac HQ
# Where errors are emailed, at most once in fifteen minutes for the same
# error. Needs the two settings above.
HQ_ALERT_EMAIL=
# How clients reach Potomac, shown in the client portal. Each is optional. The
# address is where a check is mailed, on one line.
HQ_CONTACT_PHONE=
HQ_CONTACT_EMAIL=
HQ_CONTACT_ADDRESS=
# "on" emails a client when something is waiting for them in the portal. The
# email says only that there is something to see. Needs Brevo set up. Potomac's
# own people are always emailed when a client acts, once Brevo is set up.
HQ_CLIENT_NOTICES=off
# The documents put into the knowledge base when HQ starts. Defaults to ./docs.
HQ_DOCS_DIR=

# Nightly backups, sealed so only the private key can open them. Make the key
# pair on your own computer with `npm run backup:keygen`. Give the server the
# PUBLIC key only. Then either a local folder (HQ_BACKUP_DIR) or an R2 bucket.
HQ_BACKUP_PUBLIC_KEY=
HQ_BACKUP_DIR=
HQ_BACKUP_R2_ACCOUNT_ID=
HQ_BACKUP_R2_BUCKET=
HQ_BACKUP_R2_ACCESS_KEY_ID=
HQ_BACKUP_R2_SECRET_ACCESS_KEY=
# A folder in the bucket, so test and production backups stay apart.
HQ_BACKUP_R2_PREFIX=
# Finance records copied to a Google Sheet each night, one way. Make a Google
# service account, share the sheet with its address as an editor, and paste
# its key file here as one line of JSON. HQ writes only tabs whose names
# start with "HQ", and never reads the sheet back.
HQ_SHEETS_SPREADSHEET_ID=
HQ_SHEETS_SERVICE_ACCOUNT=

# Client sites' content (docs/decisions/0003-site-content.md). A GitHub
# fine-grained personal access token with "Contents: read and write" on the
# client sites' repositories, and on nothing else. HQ reads each site's
# content file and photos with it, and commits what you publish. Commits are
# made as the token's owner.
HQ_GITHUB_TOKEN=

# The inquiry form at /contact. Other sites whose forms may post to it,
# comma-separated, like https://potomac.solutions. Where each inquiry is
# emailed: defaults to HQ_CONTACT_EMAIL, then HQ_ALERT_EMAIL.
HQ_FORM_ORIGINS=
HQ_INQUIRY_EMAIL=

# Booked calls avoid busy times in this Google Calendar (docs/operations.md,
# "Booked calls"). Share the calendar with the service account as "See only
# free/busy". Optional. The service account defaults to the sheet's.
HQ_GOOGLE_CALENDAR_ID=
HQ_GOOGLE_SERVICE_ACCOUNT=
PORT=3000
